# ATLAS environment variables.
# Copy this file to `.env` for local dev. On Vercel, set DATABASE_URL in the
# project's Environment Variables settings.

# Local dev: SQLite file at <project>/db/custom.db (auto-created by prisma db push)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Serverless (Vercel) deploy: ephemeral SQLite at /tmp/atlas.db (auto-seeded
# by ensureSeeded() on first /api/stats hit).
# DATABASE_URL=file:/tmp/atlas.db
