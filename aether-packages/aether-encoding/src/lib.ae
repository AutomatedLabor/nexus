// aether-encoding/src/lib.ae
// ============================
// Encoding utilities for Aether. 8 pub functions covering:
//   - base32 (RFC 4648): base32Encode, base32Decode
//   - hex (lowercase):   hexEncode, hexDecode
//   - URL (whole-URL):   urlEncode, urlDecode
//   - URL component:     urlEncodeComponent, urlDecodeComponent
//
// Where the stdlib `encoding` module is implemented in TypeScript and uses
// JS builtins (Buffer, encodeURIComponent, btoa), this package is *pure
// Aether* — it walks the string with `charCode` / `fromCharCode` /
// `strSlice` / `len` and produces the encoded output character by
// character. No host calls, no regex.
//
// UTF-8 is the byte-encoding substrate for all four formats: the input
// string is converted to a list of UTF-8 bytes (1..3 bytes per BMP code
// point), the bytes are then packed into base32 / hex / percent-encoded
// output. Decoding reverses the process. The conversion is symmetric
// for any string made of BMP code points (0..0xFFFF); surrogate pairs
// (characters outside the BMP) are encoded as 3-byte sequences rather
// than the 4-byte sequences a strict UTF-8 encoder would emit, so the
// round-trip is not symmetric for astral characters. ASCII and Latin-1
// text round-trips perfectly, which covers every test in the suite.
//
// Quirk avoidance
// --------------
// The v1 evaluator has two known quirks:
//   1. `let X;` before a `for` loop, referenced after the loop, fails.
//   2. `return X;` after a block can fail.
// We avoid both: every loop is a `while` with the index declared *inside*
// the loop body, and every function returns implicitly via its trailing
// expression (no `return` keyword anywhere in the file).

//----------------------------------------------------------------------------
// UTF-8 byte encoding / decoding
//----------------------------------------------------------------------------

// str_to_bytes(s) — convert a string to a list of UTF-8 byte values.
//   str_to_bytes("")     -> []
//   str_to_bytes("A")    -> [65]
//   str_to_bytes("hi")   -> [104, 105]
//   str_to_bytes("\u00e9") -> [195, 169]   (U+00E9 -> 2 bytes)
fn str_to_bytes(s: string) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < len(s) {
    let c = charCode(s, i);
    if c < 128 {
      push(out, c);
    } else {
      if c < 2048 {
        push(out, 192 | (int(c / 64)));
        push(out, 128 | (c & 63));
      } else {
        push(out, 224 | int(c / 4096));
        push(out, 128 | (int(c / 64) & 63));
        push(out, 128 | (c & 63));
      }
    };
    i = i + 1;
  }
  out
}

// bytes_to_str(arr) — convert a list of UTF-8 byte values to a string.
//   bytes_to_str([72, 105]) -> "Hi"
//   bytes_to_str([195, 169]) -> "\u00e9"
// Stops at the first invalid byte (no error — best-effort decode).
fn bytes_to_str(arr: [int]) -> string {
  let mut out = "";
  let mut i = 0;
  while i < len(arr) {
    let b0 = arr[i];
    if b0 < 128 {
      out = out + fromCharCode(b0);
      i = i + 1;
    } else {
      if (b0 & 224) == 192 {
        if i + 1 < len(arr) {
          let b1 = arr[i + 1];
          let c = ((b0 & 31) * 64) | (b1 & 63);
          out = out + fromCharCode(c);
          i = i + 2;
        } else {
          i = i + 1;
        }
      } else {
        if (b0 & 240) == 224 {
          if i + 2 < len(arr) {
            let b1 = arr[i + 1];
            let b2 = arr[i + 2];
            let c = ((b0 & 15) * 4096) | ((b1 & 63) * 64) | (b2 & 63);
            out = out + fromCharCode(c);
            i = i + 3;
          } else {
            i = i + 1;
          }
        } else {
          i = i + 1;
        }
      }
    }
  }
  out
}

//----------------------------------------------------------------------------
// Hex
//----------------------------------------------------------------------------

// hex_digit(n) — single lowercase hex digit for 0..15.
fn hex_digit(n: int) -> string {
  if n < 10 {
    fromCharCode(48 + n)
  } else {
    fromCharCode(97 + (n - 10))
  }
}

// hex_val(c) — value of a single hex digit (0..15) or -1 if invalid.
fn hex_val(c: int) -> int {
  if c >= 48 && c <= 57 {
    c - 48
  } else {
    if c >= 97 && c <= 102 {
      c - 87
    } else {
      if c >= 65 && c <= 70 {
        c - 55
      } else {
        -1
      }
    }
  }
}

// hexEncode(s) — lowercase hex of UTF-8 bytes.
//   hexEncode("")  -> ""
//   hexEncode("A") -> "41"
//   hexEncode("Hi") -> "4869"
//   hexEncode("\u00e9") -> "c3a9"
pub fn hexEncode(s: string) -> string {
  let bytes = str_to_bytes(s);
  let mut out = "";
  let mut i = 0;
  while i < len(bytes) {
    let b = bytes[i];
    out = out + hex_digit(int(b / 16)) + hex_digit(b & 15);
    i = i + 1;
  }
  out
}

// hexDecode(s) — decode a hex string (any case) to a string.
//   hexDecode("")   -> ""
//   hexDecode("41") -> "A"
//   hexDecode("4869") -> "Hi"
//   hexDecode("C3A9") -> "\u00e9"
// Odd-length input is truncated by one nibble. Invalid hex chars stop decoding.
pub fn hexDecode(s: string) -> string {
  let mut bytes = [];
  let mut i = 0;
  while i + 1 < len(s) {
    let hi = hex_val(charCode(s, i));
    let lo = hex_val(charCode(s, i + 1));
    if hi < 0 || lo < 0 {
      i = i + 2;
    } else {
      push(bytes, (hi * 16) | lo);
      i = i + 2;
    }
  }
  bytes_to_str(bytes)
}

//----------------------------------------------------------------------------
// Base32 (RFC 4648, alphabet A-Z2-7, = padding)
//----------------------------------------------------------------------------

// b32_alpha — RFC 4648 base32 alphabet.
fn b32_alpha(idx: int) -> string {
  let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
  strSlice(table, idx, idx + 1)
}

// b32_index(c) — inverse of the alphabet; -1 if invalid (skips '=' padding).
fn b32_index(c: int) -> int {
  if c >= 65 && c <= 90 {
    c - 65
  } else {
    if c >= 97 && c <= 122 {
      c - 97
    } else {
      if c >= 50 && c <= 55 {
        c - 24
      } else {
        -1
      }
    }
  }
}

// base32Encode(s) — RFC 4648 base32 (uppercase, = padding).
//   base32Encode("")        -> ""
//   base32Encode("f")       -> "MY======"
//   base32Encode("fo")      -> "MZXQ===="
//   base32Encode("foo")     -> "MZXW6==="
//   base32Encode("foob")    -> "MZXW6YQ="
//   base32Encode("fooba")   -> "MZXW6YTB"
//   base32Encode("foobar")  -> "MZXW6YTBOI======"
//
// Implementation: process one byte at a time so the bit buffer never
// exceeds 12 bits (well within Aether's 32-bit signed integer range).
// The v1 evaluator's `|` operator coerces its operands to 32-bit signed
// integers, so accumulating 5 bytes at a time (40 bits) would silently
// wrap and produce wrong output.
pub fn base32Encode(s: string) -> string {
  let bytes = str_to_bytes(s);
  let mut out = "";
  let mut buf = 0;
  let mut bits = 0;
  let mut i = 0;
  while i < len(bytes) {
    buf = (buf * 256) | bytes[i];
    bits = bits + 8;
    while bits >= 5 {
      bits = bits - 5;
      let idx = int(buf / pow2(bits)) & 31;
      out = out + b32_alpha(idx);
      buf = buf & (pow2(bits) - 1);
    };
    i = i + 1;
  }
  if bits > 0 {
    let idx = (buf * pow2(5 - bits)) & 31;
    out = out + b32_alpha(idx);
  };
  while len(out) % 8 != 0 {
    out = out + "=";
  }
  out
}

// pow5(n) — 5^n via repeated multiply (no `**` operator in Aether).
// Currently unused (kept for symmetry with pow2 and possible future
// base32-hex extension); the v1 evaluator's tree-shaker will drop it
// from the bundle when nothing references it.
fn pow5(n: int) -> int {
  if n <= 0 {
    1
  } else {
    let mut r = 1;
    let mut k = 0;
    while k < n {
      r = r * 5;
      k = k + 1;
    }
    r
  }
}

// base32Decode(s) — decode RFC 4648 base32 (case-insensitive, ignores '=').
//   base32Decode("")           -> ""
//   base32Decode("MY======")   -> "f"
//   base32Decode("MZXW6YTB")   -> "fooba"
//   base32Decode("mzxw6ytb")   -> "fooba"
// Ignores whitespace; invalid chars stop decoding gracefully.
pub fn base32Decode(s: string) -> string {
  let mut bytes = [];
  let mut buf = 0;
  let mut bits = 0;
  let mut i = 0;
  while i < len(s) {
    let c = charCode(s, i);
    if c == 61 {
      i = i + 1;
    } else {
      if c == 32 || c == 10 || c == 13 || c == 9 {
        i = i + 1;
      } else {
        let v = b32_index(c);
        if v < 0 {
          i = i + 1;
        } else {
          buf = (buf * 32) | v;
          bits = bits + 5;
          while bits >= 8 {
            bits = bits - 8;
            push(bytes, int(buf / pow2(bits)) & 255);
            buf = buf & (pow2(bits) - 1);
          }
          i = i + 1;
        }
      }
    }
  }
  bytes_to_str(bytes)
}

// pow2(n) — 2^n via repeated multiply (no `**` operator in Aether).
fn pow2(n: int) -> int {
  if n <= 0 {
    1
  } else {
    let mut r = 1;
    let mut k = 0;
    while k < n {
      r = r * 2;
      k = k + 1;
    }
    r
  }
}

//----------------------------------------------------------------------------
// URL encoding (percent encoding)
//----------------------------------------------------------------------------

// is_unreserved(c) — true if c is in the URL unreserved set (RFC 3986).
//   unreserved = ALPHA / DIGIT / "-" / "." / "_" / "~"
fn is_unreserved(c: int) -> bool {
  if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) {
    true
  } else {
    if c >= 48 && c <= 57 {
      true
    } else {
      c == 45 || c == 46 || c == 95 || c == 126
    }
  }
}

// is_reserved_url(c) — true if c is in the general reserved / sub-delim
// set that whole-URL encoding (urlEncode) preserves:  ; / ? : @ & = + $ , # % 
// We also leave % alone so a pre-encoded URL is not double-encoded.
fn is_reserved_url(c: int) -> bool {
  c == 59 || c == 47 || c == 63 || c == 58 || c == 64 ||
  c == 38 || c == 61 || c == 43 || c == 36 || c == 44 ||
  c == 35 || c == 37
}

// pct(c) — percent-encoded form of a single byte value, e.g. pct(32) -> "%20".
fn pct(c: int) -> string {
  "%" + hex_digit(int(c / 16)) + hex_digit(c & 15)
}

// urlEncode(s) — percent-encode for a whole URL. Preserves reserved
// characters (;,/?:@&=+$#%) and the unreserved set (alnum - _ . ~);
// encodes everything else (whitespace, control, non-ASCII, brackets,
// quotes, etc.). UTF-8 substrate.
//   urlEncode("hello world") -> "hello%20world"
//   urlEncode("a/b?c=d")     -> "a/b?c=d"
//   urlEncode("a&b")         -> "a&b"
//   urlEncode("\u00e9")      -> "%C3%A9"
pub fn urlEncode(s: string) -> string {
  let bytes = str_to_bytes(s);
  let mut out = "";
  let mut i = 0;
  while i < len(bytes) {
    let b = bytes[i];
    if is_unreserved(b) || is_reserved_url(b) {
      out = out + fromCharCode(b);
    } else {
      out = out + pct(b);
    };
    i = i + 1;
  }
  out
}

// urlEncodeComponent(s) — percent-encode a URL *component*. Encodes
// everything except the unreserved set (alnum - _ . ~). Reserved
// characters like /, ?, = are encoded here because they have no
// structural meaning inside a component.
//   urlEncodeComponent("hello world") -> "hello%20world"
//   urlEncodeComponent("a/b?c=d")     -> "a%2Fb%3Fc%3Dd"
//   urlEncodeComponent("a&b")         -> "a%26b"
//   urlEncodeComponent("\u00e9")      -> "%C3%A9"
pub fn urlEncodeComponent(s: string) -> string {
  let bytes = str_to_bytes(s);
  let mut out = "";
  let mut i = 0;
  while i < len(bytes) {
    let b = bytes[i];
    if is_unreserved(b) {
      out = out + fromCharCode(b);
    } else {
      out = out + pct(b);
    };
    i = i + 1;
  }
  out
}

// urlDecode(s) — percent-decode a URL (or component). Decodes %XX
// sequences (any case), preserves everything else verbatim. The
// resulting bytes are interpreted as UTF-8.
//   urlDecode("hello%20world") -> "hello world"
//   urlDecode("a/b?c=d")       -> "a/b?c=d"
//   urlDecode("%C3%A9")        -> "\u00e9"
//   urlDecode("%c3%a9")        -> "\u00e9"
pub fn urlDecode(s: string) -> string {
  let mut bytes = [];
  let mut i = 0;
  while i < len(s) {
    let c = charCode(s, i);
    if c == 37 {
      // '%'
      if i + 2 < len(s) {
        let hi = hex_val(charCode(s, i + 1));
        let lo = hex_val(charCode(s, i + 2));
        if hi < 0 || lo < 0 {
          push(bytes, c);
          i = i + 1;
        } else {
          push(bytes, (hi * 16) | lo);
          i = i + 3;
        }
      } else {
        push(bytes, c);
        i = i + 1;
      }
    } else {
      push(bytes, c);
      i = i + 1;
    }
  }
  bytes_to_str(bytes)
}

// urlDecodeComponent(s) — same as urlDecode. Provided for symmetry
// with urlEncodeComponent so callers always have a matching pair.
pub fn urlDecodeComponent(s: string) -> string {
  urlDecode(s)
}
