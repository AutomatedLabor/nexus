// aether-set/src/lib.ae
// ======================
// Set operations for Aether. 20 pub functions: new, add, remove, has,
// size, to_array, union, intersect, difference, sym_diff, subset,
// superset, disjoint, equal, map, filter, fold, any, all, to_string.
//
// Sets are represented as a sorted array of unique ints. All operations
// return new sets (the inputs are never mutated) — this matches the
// "values, not references" style of the rest of the Aether packages.
//
// Most operations are O(n) or O(n log n) on the set size. `has` is O(log n)
// via binary search; the sorted invariant makes union/intersect/diff
// straightforward merge-style scans.
//
// No `for x in arr` is used (defensive against the v1 evaluator's
// for-loop-scope quirk). All iteration uses `while` with explicit index.

//----------------------------------------------------------------------------
// new — create an empty set (or build a set from an array).
//----------------------------------------------------------------------------
pub fn new() -> [int] { [] }

// Construct a set from an array (deduplicate + sort).
pub fn from_arr(arr: [int]) -> [int] {
  let sorted = sort_int(arr);
  dedup_sorted(sorted)
}

//----------------------------------------------------------------------------
// add — return a new set with x added (no-op if already present).
//----------------------------------------------------------------------------
pub fn add(s: [int], x: int) -> [int] {
  if has(s, x) {
    s
  } else {
    insert_sorted(s, x)
  }
}

//----------------------------------------------------------------------------
// remove — return a new set with x removed (no-op if not present).
//----------------------------------------------------------------------------
pub fn remove(s: [int], x: int) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < len(s) {
    if s[i] != x {
      push(out, s[i]);
    };
    i = i + 1;
  }
  out
}

//----------------------------------------------------------------------------
// has — true iff x is in s. Binary search, O(log n).
//----------------------------------------------------------------------------
pub fn has(s: [int], x: int) -> bool {
  let mut lo = 0;
  let mut hi = len(s);
  let mut found = false;
  while lo < hi && !found {
    let mid = int((lo + hi) / 2);
    if s[mid] == x {
      found = true;
    } else {
      if s[mid] < x {
        lo = mid + 1;
      } else {
        hi = mid;
      };
    };
  }
  found
}

//----------------------------------------------------------------------------
// size — number of elements.
//----------------------------------------------------------------------------
pub fn size(s: [int]) -> int { len(s) }

//----------------------------------------------------------------------------
// to_array — return the elements as a sorted array (a copy).
//----------------------------------------------------------------------------
pub fn to_array(s: [int]) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < len(s) {
    push(out, s[i]);
    i = i + 1;
  }
  out
}

//----------------------------------------------------------------------------
// union — s ∪ t (sorted merge).
//----------------------------------------------------------------------------
pub fn union(s: [int], t: [int]) -> [int] {
  let mut out = [];
  let mut i = 0;
  let mut j = 0;
  while i < len(s) && j < len(t) {
    if s[i] < t[j] {
      push(out, s[i]);
      i = i + 1;
    } else {
      if s[i] == t[j] {
        push(out, s[i]);
        i = i + 1;
        j = j + 1;
      } else {
        push(out, t[j]);
        j = j + 1;
      };
    };
  }
  while i < len(s) {
    push(out, s[i]);
    i = i + 1;
  }
  while j < len(t) {
    push(out, t[j]);
    j = j + 1;
  }
  out
}

//----------------------------------------------------------------------------
// intersect — s ∩ t.
//----------------------------------------------------------------------------
pub fn intersect(s: [int], t: [int]) -> [int] {
  let mut out = [];
  let mut i = 0;
  let mut j = 0;
  while i < len(s) && j < len(t) {
    if s[i] < t[j] {
      i = i + 1;
    } else {
      if s[i] == t[j] {
        push(out, s[i]);
        i = i + 1;
        j = j + 1;
      } else {
        j = j + 1;
      };
    };
  }
  out
}

//----------------------------------------------------------------------------
// difference — s \ t (elements in s but not in t).
//----------------------------------------------------------------------------
pub fn difference(s: [int], t: [int]) -> [int] {
  let mut out = [];
  let mut i = 0;
  let mut j = 0;
  while i < len(s) {
    if j >= len(t) {
      push(out, s[i]);
      i = i + 1;
    } else {
      if s[i] < t[j] {
        push(out, s[i]);
        i = i + 1;
      } else {
        if s[i] == t[j] {
          i = i + 1;
          j = j + 1;
        } else {
          j = j + 1;
        };
      };
    };
  }
  out
}

//----------------------------------------------------------------------------
// sym_diff — s △ t (elements in s or t but not both).
//----------------------------------------------------------------------------
pub fn sym_diff(s: [int], t: [int]) -> [int] {
  let mut out = [];
  let mut i = 0;
  let mut j = 0;
  while i < len(s) && j < len(t) {
    if s[i] < t[j] {
      push(out, s[i]);
      i = i + 1;
    } else {
      if s[i] == t[j] {
        i = i + 1;
        j = j + 1;
      } else {
        push(out, t[j]);
        j = j + 1;
      };
    };
  }
  while i < len(s) {
    push(out, s[i]);
    i = i + 1;
  }
  while j < len(t) {
    push(out, t[j]);
    j = j + 1;
  }
  out
}

//----------------------------------------------------------------------------
// subset — true iff s ⊆ t.
//----------------------------------------------------------------------------
pub fn subset(s: [int], t: [int]) -> bool {
  let mut i = 0;
  let mut j = 0;
  let mut ok = true;
  while i < len(s) && ok {
    if j >= len(t) {
      ok = false;
    } else {
      if t[j] < s[i] {
        j = j + 1;
      } else {
        if t[j] == s[i] {
          i = i + 1;
          j = j + 1;
        } else {
          // t[j] > s[i] means s[i] not in t
          ok = false;
        };
      };
    };
  }
  ok
}

//----------------------------------------------------------------------------
// superset — true iff s ⊇ t.
//----------------------------------------------------------------------------
pub fn superset(s: [int], t: [int]) -> bool { subset(t, s) }

//----------------------------------------------------------------------------
// disjoint — true iff s ∩ t = {}.
//----------------------------------------------------------------------------
pub fn disjoint(s: [int], t: [int]) -> bool {
  let mut i = 0;
  let mut j = 0;
  let mut found_common = false;
  while i < len(s) && j < len(t) && !found_common {
    if s[i] < t[j] {
      i = i + 1;
    } else {
      if s[i] == t[j] {
        found_common = true;
      } else {
        j = j + 1;
      };
    };
  }
  !found_common
}

//----------------------------------------------------------------------------
// equal — true iff s == t (same elements).
//----------------------------------------------------------------------------
pub fn equal(s: [int], t: [int]) -> bool {
  if len(s) != len(t) {
    false
  } else {
    let mut i = 0;
    let mut eq = true;
    while i < len(s) && eq {
      if s[i] != t[i] {
        eq = false;
      };
      i = i + 1;
    }
    eq
  }
}

//----------------------------------------------------------------------------
// map — apply f to each element, return a new set (deduplicated).
//----------------------------------------------------------------------------
pub fn map(s: [int], f: fn(int) -> int) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < len(s) {
    push(out, f(s[i]));
    i = i + 1;
  }
  from_arr(out)
}

//----------------------------------------------------------------------------
// filter — keep elements where pred(x) is true.
//----------------------------------------------------------------------------
pub fn filter(s: [int], pred: fn(int) -> bool) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < len(s) {
    if pred(s[i]) {
      push(out, s[i]);
    };
    i = i + 1;
  }
  out
}

//----------------------------------------------------------------------------
// fold — fold over elements with an accumulator.
//----------------------------------------------------------------------------
pub fn fold(s: [int], init: int, f: fn(int, int) -> int) -> int {
  let mut acc = init;
  let mut i = 0;
  while i < len(s) {
    acc = f(acc, s[i]);
    i = i + 1;
  }
  acc
}

//----------------------------------------------------------------------------
// any — true if any element satisfies pred.
//----------------------------------------------------------------------------
pub fn any(s: [int], pred: fn(int) -> bool) -> bool {
  let mut i = 0;
  let mut found = false;
  while i < len(s) && !found {
    if pred(s[i]) {
      found = true;
    };
    i = i + 1;
  }
  found
}

//----------------------------------------------------------------------------
// all — true if all elements satisfy pred.
//----------------------------------------------------------------------------
pub fn all(s: [int], pred: fn(int) -> bool) -> bool {
  let mut i = 0;
  let mut ok = true;
  while i < len(s) && ok {
    if !pred(s[i]) {
      ok = false;
    };
    i = i + 1;
  }
  ok
}

//----------------------------------------------------------------------------
// to_string — render the set as "{1, 2, 3}".
//----------------------------------------------------------------------------
pub fn to_string(s: [int]) -> string {
  let body = reduce(s, fn(acc: string, x: int) -> string {
    if acc == "" { str(x) } else { acc + ", " + str(x) }
  }, "");
  "{" + body + "}"
}

//----------------------------------------------------------------------------
// Internal helpers (not pub)
//----------------------------------------------------------------------------
// Sort an array of ints (insertion sort — small N).
fn sort_int(arr: [int]) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < len(arr) {
    out = insert_sorted(out, arr[i]);
    i = i + 1;
  }
  out
}

// Insert x into a sorted array, preserving order.
fn insert_sorted(arr: [int], x: int) -> [int] {
  let mut out = [];
  let mut inserted = false;
  let mut i = 0;
  while i < len(arr) {
    if !inserted && arr[i] >= x {
      push(out, x);
      inserted = true;
    };
    push(out, arr[i]);
    i = i + 1;
  }
  if !inserted {
    push(out, x);
  };
  out
}

// Deduplicate a sorted array.
fn dedup_sorted(arr: [int]) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < len(arr) {
    if len(out) == 0 || out[len(out) - 1] != arr[i] {
      push(out, arr[i]);
    };
    i = i + 1;
  }
  out
}
