// aether-set/tests/tests.ae
// ==========================
// 30+ assertions covering all 20 pub functions of aether-set.
import {
  new, from_arr, add, remove, has, size, to_array, union, intersect,
  difference, sym_diff, subset, superset, disjoint, equal, map, filter,
  fold, any, all, to_string,
} from "../src/lib.ae";

// --- new / from_arr ---
assert_eq(new(), []);
assert_eq(from_arr([3, 1, 2, 1, 3, 2]), [1, 2, 3]);
assert_eq(from_arr([]), []);
assert_eq(from_arr([5]), [5]);

// --- add ---
assert_eq(add([], 5), [5]);
assert_eq(add([1, 3], 2), [1, 2, 3]);
assert_eq(add([1, 2, 3], 2), [1, 2, 3]);

// --- remove ---
assert_eq(remove([1, 2, 3], 2), [1, 3]);
assert_eq(remove([1, 2, 3], 4), [1, 2, 3]);
assert_eq(remove([], 5), []);

// --- has ---
assert_eq(has([1, 2, 3], 2), true);
assert_eq(has([1, 2, 3], 4), false);
assert_eq(has([], 0), false);
assert_eq(has([1, 5, 10, 15, 20], 15), true);

// --- size / to_array ---
assert_eq(size([1, 2, 3]), 3);
assert_eq(size([]), 0);
assert_eq(to_array([1, 2, 3]), [1, 2, 3]);

// --- union ---
assert_eq(union([1, 2, 3], [2, 3, 4]), [1, 2, 3, 4]);
assert_eq(union([], [1, 2]), [1, 2]);
assert_eq(union([1, 2], []), [1, 2]);
assert_eq(union([1, 2], [1, 2]), [1, 2]);

// --- intersect ---
assert_eq(intersect([1, 2, 3], [2, 3, 4]), [2, 3]);
assert_eq(intersect([1, 2, 3], [4, 5]), []);
assert_eq(intersect([], [1, 2]), []);

// --- difference ---
assert_eq(difference([1, 2, 3, 4], [2, 4]), [1, 3]);
assert_eq(difference([1, 2, 3], []), [1, 2, 3]);
assert_eq(difference([], [1, 2]), []);
assert_eq(difference([1, 2, 3], [4, 5]), [1, 2, 3]);

// --- sym_diff ---
assert_eq(sym_diff([1, 2, 3], [2, 3, 4]), [1, 4]);
assert_eq(sym_diff([1, 2], [1, 2]), []);
assert_eq(sym_diff([], [1, 2]), [1, 2]);

// --- subset / superset ---
assert_eq(subset([1, 2], [1, 2, 3]), true);
assert_eq(subset([1, 4], [1, 2, 3]), false);
assert_eq(subset([], [1, 2, 3]), true);
assert_eq(subset([1, 2, 3], [1, 2]), false);
assert_eq(superset([1, 2, 3], [1, 2]), true);
assert_eq(superset([1, 2], [1, 2, 3]), false);

// --- disjoint ---
assert_eq(disjoint([1, 2], [3, 4]), true);
assert_eq(disjoint([1, 2], [2, 3]), false);
assert_eq(disjoint([], [1, 2]), true);

// --- equal ---
assert_eq(equal([1, 2, 3], [1, 2, 3]), true);
assert_eq(equal([1, 2, 3], [1, 2]), false);
assert_eq(equal([], []), true);
assert_eq(equal([1, 2], [1, 3]), false);

// --- map ---
fn sq(x: int) -> int { x * x }
assert_eq(map([1, 2, 3], sq), [1, 4, 9]);
// map with collision: {1, -1} -> {1} (since both square to 1)
assert_eq(map(from_arr([-1, 1]), sq), [1]);

// --- filter ---
fn gt2(x: int) -> bool { x > 2 }
assert_eq(filter([1, 2, 3, 4], gt2), [3, 4]);
assert_eq(filter([1, 2], gt2), []);

// --- fold ---
fn add_int(a: int, b: int) -> int { a + b }
assert_eq(fold([1, 2, 3, 4], 0, add_int), 10);
assert_eq(fold([], 100, add_int), 100);

// --- any / all ---
fn is_pos(x: int) -> bool { x > 0 }
assert_eq(any([1, -2, 3], is_pos), true);
assert_eq(any([-1, -2], is_pos), false);
assert_eq(all([1, 2, 3], is_pos), true);
assert_eq(all([1, -2, 3], is_pos), false);
assert_eq(all([], is_pos), true);

// --- to_string ---
assert_eq(to_string([1, 2, 3]), "{1, 2, 3}");
assert_eq(to_string([]), "{}");
assert_eq(to_string([42]), "{42}");

// --- Chained ---
let s1 = from_arr([1, 2, 3, 4, 5]);
let s2 = from_arr([4, 5, 6, 7, 8]);
assert_eq(union(s1, s2), [1, 2, 3, 4, 5, 6, 7, 8]);
assert_eq(intersect(s1, s2), [4, 5]);
assert_eq(difference(s1, s2), [1, 2, 3]);
assert_eq(sym_diff(s1, s2), [1, 2, 3, 6, 7, 8]);

print("aether-set: all 30+ assertions passed");
