// aether-heap-extra/tests/tests.ae
// ================================
// 25+ assertions covering every pub function in aether-heap-extra.
import {
  pqNew, pqPush, pqPop, pqPeek, pqSize, pqMerge, pqUpdateKey, pqDelete,
} from "../src/lib.ae";

// --- pqNew / pqPush / pqSize / pqPeek ---
let pq = pqNew();
assert_eq(pqSize(pq), 0);
pqPush(pq, 5, 50);
pqPush(pq, 1, 10);
pqPush(pq, 3, 30);
pqPush(pq, 2, 20);
pqPush(pq, 4, 40);
assert_eq(pqSize(pq), 5);
let top = pqPeek(pq);
assert_eq(top[0], 1);  // min priority
assert_eq(top[1], 10);
// peek doesn't remove
assert_eq(pqSize(pq), 5);

// --- pqPop (returns in priority order) ---
assert_eq(pqPop(pq), [1, 10]);
assert_eq(pqPop(pq), [2, 20]);
assert_eq(pqPop(pq), [3, 30]);
assert_eq(pqPop(pq), [4, 40]);
assert_eq(pqPop(pq), [5, 50]);
assert_eq(pqPop(pq), [-1, -1]);  // empty
assert_eq(pqSize(pq), 0);

// --- pqUpdateKey ---
let pq2 = pqNew();
pqPush(pq2, 10, 100);
pqPush(pq2, 20, 200);
pqPush(pq2, 30, 300);
// Update value 200 from priority 20 to priority 5 (now min).
let updated = pqUpdateKey(pq2, 200, 5);
assert_eq(updated, true);
let top2 = pqPeek(pq2);
assert_eq(top2[0], 5);
assert_eq(top2[1], 200);
// Update non-existent value returns false.
let not_updated = pqUpdateKey(pq2, 999, 1);
assert_eq(not_updated, false);

// --- pqDelete ---
let pq3 = pqNew();
pqPush(pq3, 10, 100);
pqPush(pq3, 20, 200);
pqPush(pq3, 30, 300);
let deleted = pqDelete(pq3, 200);
assert_eq(deleted, true);
assert_eq(pqSize(pq3), 2);
// The remaining values are 100 and 300.
let p1 = pqPop(pq3);
let p2 = pqPop(pq3);
let v1 = p1[1];
let v2 = p2[1];
// Sort to verify both values are present.
let sorted = [v1, v2];
let _min_v = min(v1, v2);
let _max_v = max(v1, v2);
assert_eq(_min_v, 100);
assert_eq(_max_v, 300);
// Delete non-existent returns false.
let not_deleted = pqDelete(pq3, 999);
assert_eq(not_deleted, false);

// --- pqMerge ---
let pqA = pqNew();
pqPush(pqA, 3, 30);
pqPush(pqA, 1, 10);
let pqB = pqNew();
pqPush(pqB, 4, 40);
pqPush(pqB, 2, 20);
let merged = pqMerge(pqA, pqB);
assert_eq(pqSize(merged), 4);
// Pops should be in priority order: 1, 2, 3, 4.
assert_eq(pqPop(merged), [1, 10]);
assert_eq(pqPop(merged), [2, 20]);
assert_eq(pqPop(merged), [3, 30]);
assert_eq(pqPop(merged), [4, 40]);

// --- empty pqMerge ---
let m_empty = pqMerge(pqNew(), pqNew());
assert_eq(pqSize(m_empty), 0);

// --- large pq (stress) ---
let big = pqNew();
let mut k = 0;
while k < 100 {
  pqPush(big, k, k * 10);
  k = k + 1;
}
assert_eq(pqSize(big), 100);
let first = pqPop(big);
assert_eq(first, [0, 0]);
// Update some priorities
pqUpdateKey(big, 500, -1);  // value 500 (priority 50) -> priority -1
let new_top = pqPeek(big);
assert_eq(new_top, [-1, 500]);

print("aether-heap-extra: all 25+ assertions passed");
