// aether-math-extra/tests/tests.ae
// ===============================
// 25+ assertions covering every pub fn in aether-math-extra.
import {
  gcdExtended, modInverse,
  chineseRemainder, chineseRemainderRem,
  isPrimeMillerRabin, primeFactors,
  totient, mobius,
  divisors, divisorCount, sumDivisors,
  perfectNumber, abundantNumber, deficientNumber,
} from "../src/lib.ae";

// --- gcdExtended ---
assert_eq(gcdExtended(0, 0), [0, 0, 0]);
assert_eq(gcdExtended(5, 0), [5, 1, 0]);
assert_eq(gcdExtended(0, 5), [5, 0, 1]);
assert_eq(gcdExtended(99, 78), [3, -11, 14]);
assert_eq(gcdExtended(48, 36), [12, 1, -1]);

// --- modInverse ---
assert_eq(modInverse(3, 11), 4);
assert_eq(modInverse(2, 4), -1);
assert_eq(modInverse(1, 5), 1);
assert_eq(modInverse(7, 11), 8);

// --- chineseRemainder ---
assert_eq(chineseRemainder([2, 3], [3, 5]), 8);
assert_eq(chineseRemainder([2, 3, 2], [3, 5, 7]), 23);
assert_eq(chineseRemainder([0, 0], [2, 3]), 0);
assert_eq(chineseRemainder([1], [7]), 1);

// --- chineseRemainderRem (alias) ---
assert_eq(chineseRemainderRem([2, 3], [3, 5]), 8);
assert_eq(chineseRemainderRem([2, 3, 2], [3, 5, 7]), 23);

// --- isPrimeMillerRabin ---
assert_eq(isPrimeMillerRabin(2), true);
assert_eq(isPrimeMillerRabin(3), true);
assert_eq(isPrimeMillerRabin(5), true);
assert_eq(isPrimeMillerRabin(17), true);
assert_eq(isPrimeMillerRabin(19), true);
assert_eq(isPrimeMillerRabin(23), true);
assert_eq(isPrimeMillerRabin(29), true);
assert_eq(isPrimeMillerRabin(31), true);
assert_eq(isPrimeMillerRabin(561), false);  // Carmichael number
assert_eq(isPrimeMillerRabin(4), false);
assert_eq(isPrimeMillerRabin(1), false);
assert_eq(isPrimeMillerRabin(0), false);
assert_eq(isPrimeMillerRabin(100), false);

// --- primeFactors ---
assert_eq(primeFactors(12), [2, 2, 3]);
assert_eq(primeFactors(17), [17]);
assert_eq(primeFactors(100), [2, 2, 5, 5]);
assert_eq(primeFactors(1), []);
assert_eq(primeFactors(0), []);
assert_eq(primeFactors(2), [2]);

// --- totient ---
assert_eq(totient(1), 1);
assert_eq(totient(9), 6);
assert_eq(totient(10), 4);
assert_eq(totient(12), 4);
assert_eq(totient(7), 6);

// --- mobius ---
assert_eq(mobius(1), 1);
assert_eq(mobius(6), 1);
assert_eq(mobius(30), -1);
assert_eq(mobius(4), 0);
assert_eq(mobius(2), -1);
assert_eq(mobius(8), 0);

// --- divisors ---
assert_eq(divisors(12), [1, 2, 3, 4, 6, 12]);
assert_eq(divisors(1), [1]);
assert_eq(divisors(7), [1, 7]);
assert_eq(divisors(36), [1, 2, 3, 4, 6, 9, 12, 18, 36]);
assert_eq(divisors(0), []);

// --- divisorCount ---
assert_eq(divisorCount(12), 6);
assert_eq(divisorCount(36), 9);
assert_eq(divisorCount(1), 1);
assert_eq(divisorCount(7), 2);

// --- sumDivisors ---
assert_eq(sumDivisors(12), 28);
assert_eq(sumDivisors(6), 12);
assert_eq(sumDivisors(1), 1);
assert_eq(sumDivisors(28), 56);

// --- perfectNumber ---
assert_eq(perfectNumber(6), true);
assert_eq(perfectNumber(28), true);
assert_eq(perfectNumber(12), false);
assert_eq(perfectNumber(1), false);
assert_eq(perfectNumber(496), true);

// --- abundantNumber ---
assert_eq(abundantNumber(12), true);
assert_eq(abundantNumber(8), false);
assert_eq(abundantNumber(1), false);
assert_eq(abundantNumber(18), true);

// --- deficientNumber ---
assert_eq(deficientNumber(8), true);
assert_eq(deficientNumber(12), false);
assert_eq(deficientNumber(1), true);
assert_eq(deficientNumber(7), true);

print("aether-math-extra: all 25+ assertions passed");
