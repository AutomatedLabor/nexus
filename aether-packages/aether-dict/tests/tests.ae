// aether-dict/tests/tests.ae
// =========================
// 20+ assertions covering every pub function in aether-dict.
import {
  new, fromPairs, set, get, getOr, has, delete,
  keys, values, entries, toPairs, size, isEmpty,
  mapValues, mapKeys, filter, merge, invert, groupBy,
} from "../src/lib.ae";

// --- Constructors + basic operations ---
let d = new();
assert_eq(isEmpty(d), true);
assert_eq(size(d), 0);
let d1 = set(d, 1, 100);
let d2 = set(d1, 2, 200);
let d3 = set(d2, 3, 300);
assert_eq(size(d3), 3);
assert_eq(isEmpty(d3), false);
assert_eq(get(d3, 1), 100);
assert_eq(get(d3, 2), 200);
assert_eq(get(d3, 3), 300);
assert_eq(get(d3, 99), 0);  // not found returns 0
assert_eq(getOr(d3, 99, -1), -1);  // getOr returns default

// --- Overwriting ---
let d4 = set(d3, 1, 999);  // overwrite key 1
assert_eq(get(d4, 1), 999);
assert_eq(size(d4), 3);  // size unchanged

// --- has ---
assert_eq(has(d3, 1), true);
assert_eq(has(d3, 99), false);

// --- delete ---
let d5 = delete(d3, 2);
assert_eq(size(d5), 2);
assert_eq(has(d5, 2), false);
assert_eq(get(d5, 2), 0);
assert_eq(get(d5, 1), 100);  // other keys intact

// --- keys / values / entries ---
assert_eq(keys(d3), [1, 2, 3]);
assert_eq(values(d3), [100, 200, 300]);
assert_eq(entries(d3), [[1, 100], [2, 200], [3, 300]]);
assert_eq(toPairs(d3), [[1, 100], [2, 200], [3, 300]]);

// --- fromPairs ---
let fp = fromPairs([[10, "a"], [20, "b"], [10, "z"]]);  // 10 overridden
assert_eq(get(fp, 10), "z");  // later wins (overrides earlier)
assert_eq(get(fp, 20), "b");
assert_eq(size(fp), 2);

// --- mapValues ---
let mv = mapValues(d3, fn(v: int) -> int { v * 2 });
assert_eq(get(mv, 1), 200);
assert_eq(get(mv, 2), 400);
assert_eq(get(mv, 3), 600);
// original unchanged
assert_eq(get(d3, 1), 100);

// --- mapKeys ---
let mk = mapKeys(d3, fn(k: int) -> int { k + 10 });
assert_eq(get(mk, 11), 100);
assert_eq(get(mk, 12), 200);
assert_eq(get(mk, 13), 300);
assert_eq(size(mk), 3);

// --- filter ---
let ft = filter(d3, fn(k: int, v: int) -> bool { v > 150 });
assert_eq(size(ft), 1);
assert_eq(get(ft, 3), 300);

// --- merge ---
let a = fromPairs([[1, 10], [2, 20]]);
let b = fromPairs([[2, 200], [3, 300]]);
let m = merge(a, b);
assert_eq(get(m, 1), 10);   // from a
assert_eq(get(m, 2), 200);  // from b (overrides a)
assert_eq(get(m, 3), 300);  // from b
assert_eq(size(m), 3);

// --- invert ---
let inv = invert(d3);
assert_eq(get(inv, 100), 1);
assert_eq(get(inv, 200), 2);
assert_eq(get(inv, 300), 3);
assert_eq(size(inv), 3);

// --- groupBy ---
let grp = groupBy([1, 2, 3, 4, 5, 6], fn(x: int) -> int { x % 2 });
assert_eq(size(grp), 2);
assert_eq(get(grp, 1), [1, 3, 5]);
assert_eq(get(grp, 0), [2, 4, 6]);

let grp_mod3 = groupBy([1, 2, 3, 4, 5, 6, 7], fn(x: int) -> int { x % 3 });
assert_eq(size(grp_mod3), 3);
assert_eq(get(grp_mod3, 0), [3, 6]);
assert_eq(get(grp_mod3, 1), [1, 4, 7]);
assert_eq(get(grp_mod3, 2), [2, 5]);

print("aether-dict: all 20+ assertions passed");
