// aether-functional/src/lib.ae
// =============================
// Functional combinators for Aether. 18 pub functions covering the
// lodash/underscore-style higher-order API: compose, pipe, curry,
// partial, flip, memoize, once, debounce, throttle, after, before,
// wrap, tap, identity, constant, try_, when, unless, cond.
//
// All functions are pure: they return new closures and never mutate
// their inputs. Built on top of Aether's `while`, `map`, `filter`,
// `reduce`, and recursion — no `for in` loops (defensive against the
// v1 evaluator's for-loop-scope quirk).
//
// Type conventions:
//   - Polymorphic element types are `int` here (the type system is
//     mostly erased at runtime, so the same code works for strings/
//     bools/arrays too, but we annotate `int` to keep the type checker
//     happy and to document the test-suite element type).
//   - Higher-order functions take `fn(int) -> int` (or similar) closures.
//
// State: some functions (memoize, once, debounce, throttle, after,
// before) hold internal mutable state — a `Map` or a counter. Aether
// `Map`s are JS `Map`s under the hood, so they're mutable; we use
// them as the closure-captured state. The returned closure is a
// pure wrapper around that state.

//----------------------------------------------------------------------------
// identity / constant — the simplest combinators
//----------------------------------------------------------------------------

// identity(x) — returns x. Useful as a default for higher-order fns.
pub fn identity(x: int) -> int { x }

// constant(x) — returns a closure that always returns x.
pub fn constant(x: int) -> fn() -> int {
  fn() -> int { x }
}

//----------------------------------------------------------------------------
// compose / pipe — function composition
//----------------------------------------------------------------------------

// compose(f, g) — returns h where h(x) = f(g(x)). Reads right-to-left.
pub fn compose(f: fn(int) -> int, g: fn(int) -> int) -> fn(int) -> int {
  fn(x: int) -> int { f(g(x)) }
}

// pipe(f, g) — returns h where h(x) = g(f(x)). Reads left-to-right.
pub fn pipe(f: fn(int) -> int, g: fn(int) -> int) -> fn(int) -> int {
  fn(x: int) -> int { g(f(x)) }
}

//----------------------------------------------------------------------------
// curry / partial / flip — partial application
//----------------------------------------------------------------------------

// curry(f) — converts a 2-arg fn into a curried form. Calling with one
// arg returns a closure expecting the other.
pub fn curry(f: fn(int, int) -> int) -> fn(int) -> fn(int) -> int {
  fn(a: int) -> fn(int) -> int {
    fn(b: int) -> int { f(a, b) }
  }
}

// partial(f, a) — fixes the first arg of a 2-arg fn.
pub fn partial(f: fn(int, int) -> int, a: int) -> fn(int) -> int {
  fn(b: int) -> int { f(a, b) }
}

// flip(f) — swaps the two args of a 2-arg fn.
pub fn flip(f: fn(int, int) -> int) -> fn(int, int) -> int {
  fn(a: int, b: int) -> int { f(b, a) }
}

//----------------------------------------------------------------------------
// memoize / once — caching
//----------------------------------------------------------------------------

// memoize(f) — returns a closure that caches f's results by arg.
// Aether's `Map` is mutable; we use it as the cache.
pub fn memoize(f: fn(int) -> int) -> fn(int) -> int {
  let cache = map_new();
  fn(x: int) -> int {
    if map_has(cache, x) {
      map_get(cache, x)
    } else {
      let v = f(x);
      map_set(cache, x, v);
      v
    }
  }
}

// once(f) — returns a closure that runs f the first time and returns
// the cached result thereafter.
pub fn once(f: fn() -> int) -> fn() -> int {
  let state = [false, 0];  // [called, value]
  fn() -> int {
    if state[0] {
      state[1]
    } else {
      let v = f();
      state[0] = true;
      state[1] = v;
      v
    }
  }
}

//----------------------------------------------------------------------------
// debounce / throttle — rate limiting (state-based; Aether closures
// cannot directly observe wall time, so these are simplified to "skip
// if called within N invocations" — the v3.1 plan is real timer-based
// debounce/throttle via the coroutine scheduler's `timeout(ms)`).
//----------------------------------------------------------------------------

// debounce(f, n) — returns a closure that invokes f only after n
// consecutive calls without an "intermediate" trigger. The state
// is `[count, last_result]`; the first call returns last_result (0).
pub fn debounce(f: fn(int) -> int, n: int) -> fn(int) -> int {
  let state = [0, 0];  // [count_since_last_fire, last_result]
  fn(x: int) -> int {
    state[0] = state[0] + 1;
    if state[0] >= n {
      let v = f(x);
      state[1] = v;
      state[0] = 0;
      v
    } else {
      state[1]
    }
  }
}

// throttle(f, n) — returns a closure that invokes f at most once every
// n calls. The state is `[count_since_last_fire, last_result]`. The
// count is incremented before the check so the first call fires and
// every nth call after that fires.
pub fn throttle(f: fn(int) -> int, n: int) -> fn(int) -> int {
  let state = [n, 0];  // start at n so first call (after increment) fires
  fn(x: int) -> int {
    state[0] = state[0] + 1;
    if state[0] >= n {
      let v = f(x);
      state[1] = v;
      state[0] = 0;
      v
    } else {
      state[1]
    }
  }
}

//----------------------------------------------------------------------------
// after / before — gating
//----------------------------------------------------------------------------

// after(n, f) — returns a closure that's a no-op (returns 0) for the
// first n-1 calls; from call n onward, runs f and returns its result.
pub fn after(n: int, f: fn(int) -> int) -> fn(int) -> int {
  let state = [0];  // [count]
  fn(x: int) -> int {
    state[0] = state[0] + 1;
    if state[0] >= n {
      f(x)
    } else {
      0
    }
  }
}

// before(n, f) — returns a closure that runs f for the first n calls,
// then no-ops (returns 0) thereafter.
pub fn before(n: int, f: fn(int) -> int) -> fn(int) -> int {
  let state = [0];  // [count]
  fn(x: int) -> int {
    if state[0] < n {
      state[0] = state[0] + 1;
      f(x)
    } else {
      0
    }
  }
}

//----------------------------------------------------------------------------
// wrap / tap — side-effect injection
//----------------------------------------------------------------------------

// wrap(f, wrapper) — returns a closure that calls wrapper(f, x). The
// wrapper can call f(x) at its discretion. Useful for adding pre/post
// hooks without modifying f.
pub fn wrap(f: fn(int) -> int, wrapper: fn(fn(int) -> int, int) -> int) -> fn(int) -> int {
  fn(x: int) -> int { wrapper(f, x) }
}

// tap(f) — returns a closure that calls f(x) (for side effects), then
// returns x. Useful for inserting debug prints into a pipe chain.
pub fn tap(f: fn(int) -> ()) -> fn(int) -> int {
  fn(x: int) -> int {
    f(x);
    x
  }
}

//----------------------------------------------------------------------------
// try_ / when / unless / cond — control-flow combinators
//----------------------------------------------------------------------------

// try_(f, fallback) — calls f(x); if f throws (panics), returns
// fallback(x). Aether's evaluator doesn't catch panics in closures
// without a try/catch in JS, so this is a best-effort wrapper.
pub fn try_(f: fn(int) -> int, fallback: fn(int) -> int) -> fn(int) -> int {
  fn(x: int) -> int {
    // Aether doesn't have a try/catch expression; we approximate by
    // calling f directly. If f panics, the panic propagates. For
    // true error handling, use Result (aether-result package).
    // Here we just always call f and return its value.
    f(x)
  }
}

// when(pred, f) — returns a closure that calls f(x) iff pred(x); else
// returns x unchanged.
pub fn when(pred: fn(int) -> bool, f: fn(int) -> int) -> fn(int) -> int {
  fn(x: int) -> int {
    if pred(x) {
      f(x)
    } else {
      x
    }
  }
}

// unless(pred, f) — the complement of `when`. Calls f(x) iff !pred(x).
pub fn unless(pred: fn(int) -> bool, f: fn(int) -> int) -> fn(int) -> int {
  fn(x: int) -> int {
    if pred(x) {
      x
    } else {
      f(x)
    }
  }
}

// cond(cases, default_) — a chain of (pred, fn) pairs. Returns a
// closure that finds the first matching pred and calls its fn.
// `cases` is a flat array [pred1, fn1, pred2, fn2, ...]. `default_`
// is the value if no pred matches.
pub fn cond(cases: [fn(int) -> bool], default_: int) -> fn(int) -> int {
  // `cases` interleaves preds and fns. Pairs are at indices [0,1],
  // [2,3], ...
  fn(x: int) -> int {
    cond_loop(cases, 0, x, default_)
  }
}

fn cond_loop(cases: [fn(int) -> bool], i: int, x: int, default_: int) -> int {
  if i + 1 >= len(cases) {
    default_
  } else {
    let pred = cases[i];
    let fn_ = cases[i + 1];
    if pred(x) {
      fn_(x)
    } else {
      cond_loop(cases, i + 2, x, default_)
    }
  }
}

//----------------------------------------------------------------------------
// Map helpers — minimal mutable map for memoize (Aether's Map builtin
// is the JS Map; these wrap it for clarity).
//----------------------------------------------------------------------------

fn map_new() -> Map<int, int> {
  let m: Map<int, int> = map_keys();
  m
}

// Aether's map literal isn't well-supported; use `map_keys()` hack:
// actually, the simplest is to construct an empty map via the JS Map
// builtin. Aether doesn't have a direct Map literal; the working
// pattern is to use the JS Map constructor via a host builtin, but
// since we don't have that, we use an array of pairs and a helper.
//
// Replace with a real Map when the eval supports Map literals.
fn map_keys() -> Map<int, int> {
  // Aether has no native empty Map literal. We exploit that Map's
  // constructor accepts pairs; an empty array means an empty Map.
  // The evaluator has a `Map` JS global accessible via the host
  // builtins mechanism, but for portability we use this hack.
  let m: Map<int, int> = new_map();
  m
}

// Construct an empty Map. Aether's `Map` is the JS Map; we use the
// `map_keys` builtin isn't available — but the evaluator exposes a
// Map constructor via JS. Since this is library code, we use a
// side-channel: the `range` builtin returns a range, but we need a
// Map. The cleanest portable approach: use an array of [k, v] pairs
// as the cache and look it up linearly.
fn new_map() -> Map<int, int> {
  // The evaluator's `Map` is JS's Map. Aether doesn't expose a way
  // to construct one from a literal; but `let m: Map<int,int> = ...`
  // expects a JS Map. We construct via the JS Map constructor by
  // using a host builtin — but for portability we just use a list
  // of pairs (a poor man's Map).
  // For memoize, the cache is opaque to the caller, so the choice
  // of representation doesn't matter — as long as map_has/map_get/
  // map_set are consistent.
  // We use a list of pairs: [[k, v], [k, v], ...].
  // The actual Map type is declared as Map<int,int> for type-check
  // purposes; at runtime, we use a list-of-pairs.
  // (See note below — this is the pragmatic compromise.)
  empty_list_map()
}

// Empty list-of-pairs (used as the cache).
fn empty_list_map() -> Map<int, int> {
  // Aether has a Map type that maps to JS Map. To construct an empty
  // one without a literal, we cast an empty array — this is a hack
  // that works at runtime because the evaluator doesn't enforce the
  // type.
  // The cleanest workaround: define a helper that returns a new Map
  // via the JS Map constructor. Aether doesn't have a `Map` builtin,
  // so we use a literal `[[k, v]]` -> Map via a constructor function.
  // For now, we'll use a list-of-pairs internally and re-export the
  // type as Map<int, int> (which is a lie the type-check tolerates).
  []  // empty array; treated as a list-of-pairs
}

fn map_has(m: Map<int, int>, k: int) -> bool {
  let pairs = m;
  let mut i = 0;
  let mut found = false;
  while i < len(pairs) {
    let pair = pairs[i];
    if pair[0] == k {
      found = true;
    };
    i = i + 1;
  }
  found
}

fn map_get(m: Map<int, int>, k: int) -> int {
  let pairs = m;
  let mut i = 0;
  let mut v = 0;
  while i < len(pairs) {
    let pair = pairs[i];
    if pair[0] == k {
      v = pair[1];
    };
    i = i + 1;
  }
  v
}

fn map_set(m: Map<int, int>, k: int, v: int) -> () {
  let pairs = m;
  // If k exists, update in place.
  let mut i = 0;
  let mut updated = false;
  while i < len(pairs) {
    let pair = pairs[i];
    if pair[0] == k {
      pair[1] = v;
      updated = true;
    };
    i = i + 1;
  }
  if !updated {
    push(pairs, [k, v]);
  };
}
