// aether-string/src/lib.ae
// =========================
// Extended string operations for Aether. 30 pub functions covering
// splitting/joining, trimming, case conversion, alignment, reversal,
// edit distances, and word/line splitting.
//
// Built on top of `charCode`, `fromCharCode`, `strSlice`, and `len` —
// no host primitives. All functions are pure: they return new strings
// and never mutate their inputs. Iteration uses `while` with explicit
// indices to avoid the v1 evaluator's for-loop-scope quirk.
//
// Type conventions:
//   - Strings are Aether `string` (UTF-16 internally via JS).
//   - charCode values are `int` (the JS `charCodeAt` result, 0..65535).
//   - Char-by-char operations work on ASCII range only (the case
//     conversions are ASCII-only, matching Python's `str.upper()` for
//     non-ASCII code points being preserved).
//   - "Array of strings" is written as `[string]`.

//----------------------------------------------------------------------------
// Splitting / joining
//----------------------------------------------------------------------------

// split(s, sep) — split s on every non-overlapping occurrence of sep.
//   split("a,b,c", ",") -> ["a", "b", "c"]
//   split("abc", "") -> ["a", "b", "c"] (if sep is empty, char-by-char)
//   split("hello", "xyz") -> ["hello"] (no match -> single element)
pub fn split(s: string, sep: string) -> [string] {
  if len(s) == 0 {
    [""]
  } else {
    if len(sep) == 0 {
      // char-by-char split
      let mut out = [];
      let mut i = 0;
      while i < len(s) {
        push(out, strSlice(s, i, i + 1));
        i = i + 1;
      }
      out
    } else {
      let mut out = [];
      let mut i = 0;
      let mut start = 0;
      while i + len(sep) <= len(s) {
        if slice_eq_at(s, i, sep) {
          push(out, strSlice(s, start, i));
          i = i + len(sep);
          start = i;
        } else {
          i = i + 1;
        };
      }
      push(out, strSlice(s, start, len(s)));
      out
    }
  }
}

// Helper: returns true if the substring of s starting at index `pos`
// equals `sub`.
fn slice_eq_at(s: string, pos: int, sub: string) -> bool {
  if pos + len(sub) > len(s) {
    false
  } else {
    let mut ok = true;
    let mut k = 0;
    while k < len(sub) && ok {
      if charCode(s, pos + k) != charCode(sub, k) {
        ok = false;
      };
      k = k + 1;
    }
    ok
  }
}

// join(arr, sep) — join array of strings with sep.
//   join(["a","b","c"], ",") -> "a,b,c"
//   join([], ",") -> ""
pub fn join(arr: [string], sep: string) -> string {
  if len(arr) == 0 {
    ""
  } else {
    let mut out = arr[0];
    let mut i = 1;
    while i < len(arr) {
      out = out + sep + arr[i];
      i = i + 1;
    }
    out
  }
}

//----------------------------------------------------------------------------
// Trimming
//----------------------------------------------------------------------------

// is_whitespace(c) — true if c is space, tab, newline, or carriage return.
fn is_whitespace(c: int) -> bool {
  c == 32 || c == 9 || c == 10 || c == 13
}

// trim(s) — strip leading and trailing whitespace.
pub fn trim(s: string) -> string {
  let mut start = 0;
  let mut end = len(s);
  while start < end && is_whitespace(charCode(s, start)) {
    start = start + 1;
  }
  while end > start && is_whitespace(charCode(s, end - 1)) {
    end = end - 1;
  }
  strSlice(s, start, end)
}

//----------------------------------------------------------------------------
// Searching / replacing
//----------------------------------------------------------------------------

// replace(s, from, to) — replace the FIRST occurrence of `from` with `to`.
//   replace("a-b-c", "-", "_") -> "a_b-c"
pub fn replace(s: string, from: string, to: string) -> string {
  if len(from) == 0 {
    s
  } else {
    let mut i = 0;
    let mut found = -1;
    while i + len(from) <= len(s) && found < 0 {
      if slice_eq_at(s, i, from) {
        found = i;
      } else {
        i = i + 1;
      };
    }
    if found < 0 {
      s
    } else {
      strSlice(s, 0, found) + to + strSlice(s, found + len(from), len(s))
    }
  }
}

// replaceAll(s, from, to) — replace every occurrence of `from` with `to`.
//   replaceAll("a-b-c", "-", "_") -> "a_b_c"
pub fn replaceAll(s: string, from: string, to: string) -> string {
  if len(from) == 0 {
    s
  } else {
    let mut out = "";
    let mut i = 0;
    let mut last = 0;
    while i + len(from) <= len(s) {
      if slice_eq_at(s, i, from) {
        out = out + strSlice(s, last, i) + to;
        i = i + len(from);
        last = i;
      } else {
        i = i + 1;
      };
    }
    out + strSlice(s, last, len(s))
  }
}

// startsWith(s, p) — true if s starts with prefix p.
pub fn startsWith(s: string, p: string) -> bool {
  if len(p) > len(s) {
    false
  } else {
    slice_eq_at(s, 0, p)
  }
}

// endsWith(s, p) — true if s ends with suffix p.
pub fn endsWith(s: string, p: string) -> bool {
  if len(p) > len(s) {
    false
  } else {
    slice_eq_at(s, len(s) - len(p), p)
  }
}

// contains(s, sub) — true if s contains sub.
pub fn contains(s: string, sub: string) -> bool {
  if len(sub) == 0 {
    true
  } else {
    let mut i = 0;
    let mut found = false;
    while i + len(sub) <= len(s) && !found {
      if slice_eq_at(s, i, sub) {
        found = true;
      } else {
        i = i + 1;
      };
    }
    found
  }
}

// indexOf(s, sub) — first index of sub in s, or -1.
pub fn indexOf(s: string, sub: string) -> int {
  if len(sub) == 0 {
    0
  } else {
    let mut i = 0;
    let mut found = -1;
    while i + len(sub) <= len(s) && found < 0 {
      if slice_eq_at(s, i, sub) {
        found = i;
      } else {
        i = i + 1;
      };
    }
    found
  }
}

// slice(s, start, end) — substring [start, end). Negative indices clamp to 0.
pub fn slice(s: string, start: int, end: int) -> string {
  strSlice(s, start, end)
}

//----------------------------------------------------------------------------
// Padding / centering / repeat
//----------------------------------------------------------------------------

// padLeft(s, n, ch) — left-pad s with single-char `ch` to width n.
//   padLeft("42", 5, "0") -> "00042"
pub fn padLeft(s: string, n: int, ch: string) -> string {
  let c = if len(ch) > 0 { strSlice(ch, 0, 1) } else { " " };
  let mut pad = "";
  let mut i = 0;
  while i < n - len(s) {
    pad = pad + c;
    i = i + 1;
  }
  pad + s
}

// padRight(s, n, ch) — right-pad.
pub fn padRight(s: string, n: int, ch: string) -> string {
  let c = if len(ch) > 0 { strSlice(ch, 0, 1) } else { " " };
  let mut out = s;
  let mut i = 0;
  while i < n - len(s) {
    out = out + c;
    i = i + 1;
  }
  out
}

// center(s, n, ch) — center s in a string of width n, padded with ch on both sides.
//   center("hi", 6, "_") -> "__hi__"
pub fn center(s: string, n: int, ch: string) -> string {
  let c = if len(ch) > 0 { strSlice(ch, 0, 1) } else { " " };
  if len(s) >= n {
    s
  } else {
    let total = n - len(s);
    let left = int(total / 2);
    let right = total - left;
    let mut l = "";
    let mut i = 0;
    while i < left {
      l = l + c;
      i = i + 1;
    }
    let mut r = "";
    let mut j = 0;
    while j < right {
      r = r + c;
      j = j + 1;
    }
    l + s + r
  }
}

// repeat(s, n) — concatenate s with itself n times.
//   repeat("ab", 3) -> "ababab"
pub fn repeat(s: string, n: int) -> string {
  let mut out = "";
  let mut i = 0;
  while i < n {
    out = out + s;
    i = i + 1;
  }
  out
}

//----------------------------------------------------------------------------
// Reversal / case conversion
//----------------------------------------------------------------------------

// reverse(s) — reverse the string character by character.
pub fn reverse(s: string) -> string {
  let mut out = "";
  let mut i = len(s) - 1;
  while i >= 0 {
    out = out + fromCharCode(charCode(s, i));
    i = i - 1;
  }
  out
}

// toUpper(s) — ASCII uppercase. Non-letters pass through unchanged.
pub fn toUpper(s: string) -> string {
  let mut out = "";
  let mut i = 0;
  while i < len(s) {
    let c = charCode(s, i);
    if c >= 97 && c <= 122 {
      out = out + fromCharCode(c - 32);
    } else {
      out = out + fromCharCode(c);
    };
    i = i + 1;
  }
  out
}

// toLower(s) — ASCII lowercase.
pub fn toLower(s: string) -> string {
  let mut out = "";
  let mut i = 0;
  while i < len(s) {
    let c = charCode(s, i);
    if c >= 65 && c <= 90 {
      out = out + fromCharCode(c + 32);
    } else {
      out = out + fromCharCode(c);
    };
    i = i + 1;
  }
  out
}

// capitalize(s) — uppercase the first char, lowercase the rest.
pub fn capitalize(s: string) -> string {
  if len(s) == 0 {
    ""
  } else {
    toUpper(strSlice(s, 0, 1)) + toLower(strSlice(s, 1, len(s)))
  }
}

// Helper: is_alpha(c) — true if c is an ASCII letter.
fn is_alpha(c: int) -> bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

// Helper: is_digit(c) — true if c is an ASCII digit.
fn is_digit(c: int) -> bool {
  c >= 48 && c <= 57
}

// Helper: is_alnum(c) — letter or digit.
fn is_alnum(c: int) -> bool {
  is_alpha(c) || is_digit(c)
}

// camelCase(s) — convert from snake/kebab/space to camelCase.
//   camelCase("hello world") -> "helloWorld"
//   camelCase("foo_bar_baz")  -> "fooBarBaz"
//   camelCase("foo-bar")      -> "fooBar"
pub fn camelCase(s: string) -> string {
  let mut out = "";
  let mut i = 0;
  let mut cap_next = false;
  while i < len(s) {
    let c = charCode(s, i);
    if is_alnum(c) {
      if cap_next {
        out = out + toUpper(fromCharCode(c));
        cap_next = false;
      } else {
        out = out + toLower(fromCharCode(c));
      };
    } else {
      cap_next = true;
    };
    i = i + 1;
  }
  out
}

// snake_case(s) — convert from camelCase / kebab / space to snake_case.
pub fn snake_case(s: string) -> string {
  let mut out = "";
  let mut i = 0;
  while i < len(s) {
    let c = charCode(s, i);
    if c >= 65 && c <= 90 {
      // uppercase letter -> insert _ + lower
      if len(out) > 0 {
        out = out + "_";
      };
      out = out + fromCharCode(c + 32);
    } else {
      if is_alnum(c) {
        out = out + fromCharCode(c);
      } else {
        // whitespace / dash / underscore -> _
        if len(out) > 0 {
          out = out + "_";
        };
      };
    };
    i = i + 1;
  }
  // Collapse double-underscores.
  replaceAll(out, "__", "_")
}

// kebabCase(s) — convert from camel / snake / space to kebab-case.
pub fn kebabCase(s: string) -> string {
  let mut out = "";
  let mut i = 0;
  while i < len(s) {
    let c = charCode(s, i);
    if c >= 65 && c <= 90 {
      if len(out) > 0 {
        out = out + "-";
      };
      out = out + fromCharCode(c + 32);
    } else {
      if is_alnum(c) {
        out = out + fromCharCode(c);
      } else {
        if len(out) > 0 {
          out = out + "-";
        };
      };
    };
    i = i + 1;
  }
  replaceAll(out, "--", "-")
}

// titleCase(s) — capitalize the first letter of each word.
//   titleCase("hello world") -> "Hello World"
pub fn titleCase(s: string) -> string {
  let mut out = "";
  let mut i = 0;
  let mut cap_next = true;
  while i < len(s) {
    let c = charCode(s, i);
    if is_alpha(c) {
      if cap_next {
        out = out + toUpper(fromCharCode(c));
        cap_next = false;
      } else {
        out = out + toLower(fromCharCode(c));
      };
    } else {
      out = out + fromCharCode(c);
      if is_whitespace(c) {
        cap_next = true;
      } else {
        cap_next = false;
      };
    };
    i = i + 1;
  }
  out
}

//----------------------------------------------------------------------------
// Word / line splitting
//----------------------------------------------------------------------------

// words(s) — split on whitespace, dropping empty tokens.
//   words("hello   world") -> ["hello", "world"]
pub fn words(s: string) -> [string] {
  let mut out = [];
  let mut i = 0;
  let mut start = -1;
  while i < len(s) {
    let c = charCode(s, i);
    if is_whitespace(c) {
      if start >= 0 {
        push(out, strSlice(s, start, i));
        start = -1;
      };
    } else {
      if start < 0 {
        start = i;
      };
    };
    i = i + 1;
  }
  if start >= 0 {
    push(out, strSlice(s, start, len(s)));
  };
  out
}

// lines(s) — split on newlines, dropping the trailing empty if s ends with \n.
//   lines("a\nb\nc") -> ["a", "b", "c"]
//   lines("a\nb\n")  -> ["a", "b"]
pub fn lines(s: string) -> [string] {
  let mut out = [];
  let mut start = 0;
  let mut i = 0;
  while i < len(s) {
    if charCode(s, i) == 10 {
      push(out, strSlice(s, start, i));
      start = i + 1;
    };
    i = i + 1;
  }
  if start < len(s) {
    push(out, strSlice(s, start, len(s)));
  };
  out
}

// unlines(arr) — join with "\n". Inverse of lines.
pub fn unlines(arr: [string]) -> string {
  join(arr, "\n")
}

// unwords(arr) — join with " ". Inverse of words.
pub fn unwords(arr: [string]) -> string {
  join(arr, " ")
}

//----------------------------------------------------------------------------
// Edit distances
//----------------------------------------------------------------------------

// levenshtein(a, b) — Levenshtein edit distance (insert/delete/substitute).
//   levenshtein("kitten", "sitting") -> 3
// Uses the classic O(m*n) dynamic-programming algorithm with two rolling rows.
pub fn levenshtein(a: string, b: string) -> int {
  let m = len(a);
  let n = len(b);
  if m == 0 {
    n
  } else {
    if n == 0 {
      m
    } else {
      // prev = row i-1, curr = row i
      let mut prev = [];
      let mut j = 0;
      while j <= n {
        push(prev, j);
        j = j + 1;
      }
      let mut i = 1;
      while i <= m {
        let mut curr = [i];
        let mut k = 1;
        while k <= n {
          let cost = if charCode(a, i - 1) == charCode(b, k - 1) { 0 } else { 1 };
          let del = prev[k] + 1;
          let ins = curr[k - 1] + 1;
          let sub = prev[k - 1] + cost;
          push(curr, min3(del, ins, sub));
          k = k + 1;
        }
        prev = curr;
        i = i + 1;
      }
      prev[n]
    }
  }
}

// Helper: min of three.
fn min3(a: int, b: int, c: int) -> int {
  if a < b {
    if a < c { a } else { c }
  } else {
    if b < c { b } else { c }
  }
}

// hamming(a, b) — Hamming distance. Requires equal length; panics otherwise.
//   hamming("karolin", "kathrin") -> 3
pub fn hamming(a: string, b: string) -> int {
  if len(a) != len(b) {
    panic("hamming: strings must be equal length")
  } else {
    let mut d = 0;
    let mut i = 0;
    while i < len(a) {
      if charCode(a, i) != charCode(b, i) {
        d = d + 1;
      };
      i = i + 1;
    }
    d
  }
}
