// aether-datetime/tests/tests.ae
// ================================
// 30+ assertions covering every pub function in aether-datetime.
import {
  now, today, year, month, day, hour, minute, second, dayOfWeek,
  addDays, addHours, addMinutes, diffSeconds, diffDays,
  isLeapYear, daysInMonth, toISO, fromISO,
} from "../src/lib.ae";

// --- isLeapYear ---
assert_eq(isLeapYear(2000), true);
assert_eq(isLeapYear(1996), true);
assert_eq(isLeapYear(2024), true);
assert_eq(isLeapYear(1900), false);
assert_eq(isLeapYear(2100), false);
assert_eq(isLeapYear(2023), false);
assert_eq(isLeapYear(2025), false);

// --- daysInMonth ---
assert_eq(daysInMonth(2024, 1), 31);
assert_eq(daysInMonth(2024, 2), 29);  // leap year
assert_eq(daysInMonth(2023, 2), 28);  // non-leap
assert_eq(daysInMonth(2024, 4), 30);
assert_eq(daysInMonth(2024, 12), 31);
assert_eq(daysInMonth(2000, 2), 29);  // divisible by 400
assert_eq(daysInMonth(1900, 2), 28);  // divisible by 100 not 400

// --- toISO / fromISO round-trip ---
assert_eq(toISO(0), "1970-01-01T00:00:00.000Z");
assert_eq(fromISO("1970-01-01T00:00:00.000Z"), 0);
assert_eq(toISO(90000000), "1970-01-02T01:00:00.000Z");  // 25h
assert_eq(fromISO("1970-01-02T01:00:00.000Z"), 90000000);
assert_eq(toISO(1715219016789), "2024-05-09T01:43:36.789Z");
assert_eq(fromISO("2024-05-09T01:43:36.789Z"), 1715219016789);

// --- year/month/day/hour/minute/second from a known timestamp ---
// 2024-02-29T12:34:56.789Z (a leap day in a leap year)
let ts1 = fromISO("2024-02-29T12:34:56.789Z");
assert_eq(year(ts1), 2024);
assert_eq(month(ts1), 2);
assert_eq(day(ts1), 29);
assert_eq(hour(ts1), 12);
assert_eq(minute(ts1), 34);
assert_eq(second(ts1), 56);

// 1999-12-31T23:59:59.999Z (last millisecond of 1999)
let ts2 = fromISO("1999-12-31T23:59:59.999Z");
assert_eq(year(ts2), 1999);
assert_eq(month(ts2), 12);
assert_eq(day(ts2), 31);
assert_eq(hour(ts2), 23);
assert_eq(minute(ts2), 59);
assert_eq(second(ts2), 59);

// --- dayOfWeek ---
// 1970-01-01 was a Thursday (4).
assert_eq(dayOfWeek(0), 4);
// 2024-01-01 was a Monday (1).
let ts3 = fromISO("2024-01-01T00:00:00.000Z");
assert_eq(dayOfWeek(ts3), 1);
// 2000-01-01 was a Saturday (6).
let ts4 = fromISO("2000-01-01T00:00:00.000Z");
assert_eq(dayOfWeek(ts4), 6);

// --- addDays / addHours / addMinutes ---
assert_eq(addDays(0, 1), 86400000);
assert_eq(addDays(0, -1), -86400000);
assert_eq(addDays(0, 365), 31536000000);
assert_eq(addHours(0, 1), 3600000);
assert_eq(addHours(0, -1), -3600000);
assert_eq(addMinutes(0, 1), 60000);
assert_eq(addMinutes(0, -1), -60000);

// --- diffSeconds / diffDays ---
assert_eq(diffSeconds(0, 1000), 1);
assert_eq(diffSeconds(1000, 0), -1);
assert_eq(diffSeconds(0, 60000), 60);
assert_eq(diffDays(0, 86400000), 1);
assert_eq(diffDays(86400000, 0), -1);
assert_eq(diffDays(0, 31536000000), 365);  // 2024 is a leap year; days_in_year=366, but 365*MS=31536000000

// --- now / today ---
let t = now();
assert_eq(t > 1700000000000, true);  // > 2023-11
let td = today();
assert_eq(td > 1700000000000, true);
assert_eq(floor_mod_now(td), 0);  // midnight UTC, divisible by MS_PER_DAY

print("aether-datetime: all 30+ assertions passed");

// Helper test: confirm that today() is midnight UTC (timestamp divisible by MS_PER_DAY).
fn floor_mod_now(t: int) -> int {
  let q = floor_div_test(t, 86400000);
  t - q * 86400000
}
fn floor_div_test(a: int, b: int) -> int {
  let q = int(a / b);
  let r = a - q * b;
  if r != 0 && ((r < 0) != (b < 0)) { q - 1 } else { q }
}
