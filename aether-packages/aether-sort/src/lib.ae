// aether-sort/src/lib.ae
// =======================
// Sorting algorithms for Aether. 14 pub functions: bubble, insertion,
// selection, merge, quick, heap, counting, shell, cocktail, comb, gnome,
// stable, isSorted, sortBy.
//
// All sort functions take a [int] and return a NEW sorted array (the input
// is never mutated — every function copies first). The default order is
// ascending. Use `sortBy` to sort by a key function.
//
// Most algorithms are O(n^2) or O(n log n) on the input size; `counting`
// is O(n + k) where k is the value range.
//
// No `for x in arr` is used (defensive against the v1 evaluator's
// for-loop-scope quirk). All iteration uses `while` with explicit index.

//----------------------------------------------------------------------------
// bubble — O(n^2). Adjacent-swap pass until no swaps.
//----------------------------------------------------------------------------
pub fn bubble(arr: [int]) -> [int] {
  let mut a = copy(arr);
  let n = len(a);
  let mut swapped = true;
  while swapped {
    swapped = false;
    let mut i = 0;
    while i < n - 1 {
      if a[i] > a[i + 1] {
        let tmp = a[i];
        a[i] = a[i + 1];
        a[i + 1] = tmp;
        swapped = true;
      };
      i = i + 1;
    }
  }
  a
}

//----------------------------------------------------------------------------
// insertion — O(n^2). Each element inserted into the sorted prefix.
//----------------------------------------------------------------------------
pub fn insertion(arr: [int]) -> [int] {
  let mut a = copy(arr);
  let n = len(a);
  let mut i = 1;
  while i < n {
    let key = a[i];
    let mut j = i - 1;
    while j >= 0 && a[j] > key {
      a[j + 1] = a[j];
      j = j - 1;
    }
    a[j + 1] = key;
    i = i + 1;
  }
  a
}

//----------------------------------------------------------------------------
// selection — O(n^2). Each pass selects the min of the unsorted suffix.
//----------------------------------------------------------------------------
pub fn selection(arr: [int]) -> [int] {
  let mut a = copy(arr);
  let n = len(a);
  let mut i = 0;
  while i < n - 1 {
    let mut min_idx = i;
    let mut j = i + 1;
    while j < n {
      if a[j] < a[min_idx] {
        min_idx = j;
      };
      j = j + 1;
    }
    if min_idx != i {
      let tmp = a[i];
      a[i] = a[min_idx];
      a[min_idx] = tmp;
    };
    i = i + 1;
  }
  a
}

//----------------------------------------------------------------------------
// merge — O(n log n) merge sort (recursive).
//----------------------------------------------------------------------------
pub fn merge_sort(arr: [int]) -> [int] {
  let n = len(arr);
  if n <= 1 {
    copy(arr)
  } else {
    let mid = int(n / 2);
    let left = slice_arr(arr, 0, mid);
    let right = slice_arr(arr, mid, n);
    let sorted_left = merge_sort(left);
    let sorted_right = merge_sort(right);
    merge_two(sorted_left, sorted_right)
  }
}

fn merge_two(a: [int], b: [int]) -> [int] {
  let mut out = [];
  let mut i = 0;
  let mut j = 0;
  while i < len(a) && j < len(b) {
    if a[i] <= b[j] {
      push(out, a[i]);
      i = i + 1;
    } else {
      push(out, b[j]);
      j = j + 1;
    };
  }
  while i < len(a) {
    push(out, a[i]);
    i = i + 1;
  }
  while j < len(b) {
    push(out, b[j]);
    j = j + 1;
  }
  out
}

//----------------------------------------------------------------------------
// quick — O(n log n) avg, O(n^2) worst. Lomuto partition.
//----------------------------------------------------------------------------
pub fn quick(arr: [int]) -> [int] {
  let n = len(arr);
  if n <= 1 {
    copy(arr)
  } else {
    let pivot = arr[0];
    let mut lt = [];
    let mut eq = [];
    let mut gt = [];
    let mut i = 0;
    while i < n {
      if arr[i] < pivot {
        push(lt, arr[i]);
      } else {
        if arr[i] == pivot {
          push(eq, arr[i]);
        } else {
          push(gt, arr[i]);
        };
      };
      i = i + 1;
    }
    append_arr(append_arr(quick(lt), eq), quick(gt))
  }
}

//----------------------------------------------------------------------------
// heap — O(n log n) heap sort (iterative sift-down).
//----------------------------------------------------------------------------
pub fn heap(arr: [int]) -> [int] {
  let mut a = copy(arr);
  let n = len(a);
  // Build max-heap
  let mut i = int(n / 2) - 1;
  while i >= 0 {
    sift_down(a, n, i);
    i = i - 1;
  }
  // Extract
  let mut end = n - 1;
  while end > 0 {
    let tmp = a[0];
    a[0] = a[end];
    a[end] = tmp;
    sift_down(a, end, 0);
    end = end - 1;
  }
  a
}

fn sift_down(a: [int], n: int, i: int) -> unit {
  let mut parent = i;
  let mut keep_going = true;
  while keep_going {
    let left = 2 * parent + 1;
    let right = 2 * parent + 2;
    let mut largest = parent;
    if left < n && a[left] > a[largest] {
      largest = left;
    };
    if right < n && a[right] > a[largest] {
      largest = right;
    };
    if largest != parent {
      let tmp = a[parent];
      a[parent] = a[largest];
      a[largest] = tmp;
      parent = largest;
    } else {
      keep_going = false;
    };
  };
  ()
}

//----------------------------------------------------------------------------
// counting — O(n + k). Assumes values in [0, maxVal].
//----------------------------------------------------------------------------
pub fn counting(arr: [int]) -> [int] {
  if len(arr) == 0 {
    []
  } else {
    let mut max_val = arr[0];
    let mut min_val = arr[0];
    let mut i = 1;
    while i < len(arr) {
      if arr[i] > max_val {
        max_val = arr[i];
      };
      if arr[i] < min_val {
        min_val = arr[i];
      };
      i = i + 1;
    }
    if min_val < 0 {
      // negative values not supported — fall back to insertion
      insertion(arr)
    } else {
      let mut counts = [];
      let mut k = 0;
      while k <= max_val {
        push(counts, 0);
        k = k + 1;
      }
      let mut j = 0;
      while j < len(arr) {
        counts[arr[j]] = counts[arr[j]] + 1;
        j = j + 1;
      }
      let mut out = [];
      let mut v = 0;
      while v < len(counts) {
        let c = counts[v];
        let mut m = 0;
        while m < c {
          push(out, v);
          m = m + 1;
        }
        v = v + 1;
      }
      out
    }
  }
}

//----------------------------------------------------------------------------
// shell — O(n^1.3) Shell sort with halving gap.
//----------------------------------------------------------------------------
pub fn shell(arr: [int]) -> [int] {
  let mut a = copy(arr);
  let n = len(a);
  let mut gap = int(n / 2);
  while gap > 0 {
    let mut i = gap;
    while i < n {
      let temp = a[i];
      let mut j = i;
      while j >= gap && a[j - gap] > temp {
        a[j] = a[j - gap];
        j = j - gap;
      }
      a[j] = temp;
      i = i + 1;
    }
    gap = int(gap / 2);
  }
  a
}

//----------------------------------------------------------------------------
// cocktail — O(n^2) bidirectional bubble sort.
//----------------------------------------------------------------------------
pub fn cocktail(arr: [int]) -> [int] {
  let mut a = copy(arr);
  let n = len(a);
  let mut swapped = true;
  let mut start = 0;
  let mut end = n - 1;
  while swapped {
    swapped = false;
    let mut i = start;
    while i < end {
      if a[i] > a[i + 1] {
        let tmp = a[i];
        a[i] = a[i + 1];
        a[i + 1] = tmp;
        swapped = true;
      };
      i = i + 1;
    }
    if !swapped {
      // done
    } else {
      swapped = false;
      end = end - 1;
      let mut j = end - 1;
      while j >= start {
        if a[j] > a[j + 1] {
          let tmp = a[j];
          a[j] = a[j + 1];
          a[j + 1] = tmp;
          swapped = true;
        };
        j = j - 1;
      }
      start = start + 1;
    };
  }
  a
}

//----------------------------------------------------------------------------
// comb — O(n^2) worst, O(n log n) avg. Shrinking-gap bubble.
//----------------------------------------------------------------------------
pub fn comb(arr: [int]) -> [int] {
  let mut a = copy(arr);
  let n = len(a);
  let mut gap = n;
  let mut swapped = true;
  while gap > 1 || swapped {
    if gap > 1 {
      gap = int(gap * 10 / 13);
      if gap < 1 {
        gap = 1;
      };
    };
    swapped = false;
    let mut i = 0;
    while i + gap < n {
      if a[i] > a[i + gap] {
        let tmp = a[i];
        a[i] = a[i + gap];
        a[i + gap] = tmp;
        swapped = true;
      };
      i = i + 1;
    }
  }
  a
}

//----------------------------------------------------------------------------
// gnome — O(n^2). Walk forward; on inversion, walk back swapping.
//----------------------------------------------------------------------------
pub fn gnome(arr: [int]) -> [int] {
  let mut a = copy(arr);
  let n = len(a);
  let mut i = 1;
  while i < n {
    if i == 0 || a[i - 1] <= a[i] {
      i = i + 1;
    } else {
      let tmp = a[i];
      a[i] = a[i - 1];
      a[i - 1] = tmp;
      i = i - 1;
    };
  }
  a
}

//----------------------------------------------------------------------------
// stable — merge sort (stable). Wraps merge_sort.
//----------------------------------------------------------------------------
pub fn stable(arr: [int]) -> [int] { merge_sort(arr) }

//----------------------------------------------------------------------------
// isSorted — true iff arr is non-decreasing.
//----------------------------------------------------------------------------
pub fn isSorted(arr: [int]) -> bool {
  let mut i = 0;
  let mut ok = true;
  while i + 1 < len(arr) && ok {
    if arr[i] > arr[i + 1] {
      ok = false;
    };
    i = i + 1;
  }
  ok
}

//----------------------------------------------------------------------------
// sortBy — sort by key function (ascending). Stable: equal-key elements
// preserve their original relative order. Implemented as a bubble sort on
// the key array, with the source array sorted in parallel.
//----------------------------------------------------------------------------
pub fn sortBy(arr: [int], key: fn(int) -> int) -> [int] {
  let mut a = copy(arr);
  let n = len(a);
  if n <= 1 {
    a
  } else {
    let mut keys = [];
    let mut p = 0;
    while p < n {
      push(keys, key(a[p]));
      p = p + 1;
    }
    let mut s = true;
    while s {
      s = false;
      let mut q = 0;
      while q < n - 1 {
        if keys[q] > keys[q + 1] {
          let tk = keys[q];
          keys[q] = keys[q + 1];
          keys[q + 1] = tk;
          let tv = a[q];
          a[q] = a[q + 1];
          a[q + 1] = tv;
          s = true;
        };
        q = q + 1;
      }
    }
    a
  }
}

//----------------------------------------------------------------------------
// Internal helpers
//----------------------------------------------------------------------------
fn copy(arr: [int]) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < len(arr) {
    push(out, arr[i]);
    i = i + 1;
  }
  out
}

fn slice_arr(arr: [int], from: int, to: int) -> [int] {
  let mut out = [];
  let mut i = from;
  while i < to {
    push(out, arr[i]);
    i = i + 1;
  }
  out
}

fn append_arr(a: [int], b: [int]) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < len(a) {
    push(out, a[i]);
    i = i + 1;
  }
  let mut j = 0;
  while j < len(b) {
    push(out, b[j]);
    j = j + 1;
  }
  out
}
