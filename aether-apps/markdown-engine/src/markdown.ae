// aether-apps/markdown-engine/src/markdown.ae
// ============================================
// A real markdown -> HTML renderer. Public surface:
//
//   - new() -> MdState    — create a fresh engine state (currently
//                            a placeholder struct for future options).
//   - render(state, md: string) -> string
//                          — render a markdown document to an HTML
//                            string. Supports the constructs listed
//                            below.
//
// Supported markdown constructs:
//
//   # h1, ## h2, ### h3, #### h4, ##### h5, ###### h6
//   * or - unordered list (one item per line)
//   1. ordered list (any digit prefix, single digit only in this v1)
//   **bold** inline
//   *italic* inline (also ** for bold; ambiguity resolved by greedily
//                    matching ** first)
//   `code` inline
//   [link](url) inline
//   > blockquote (one line; multi-line blockquotes are concatenated)
//   ```lang\n...\n``` fenced code block (lang optional)
//   --- horizontal rule (3+ dashes on a line by itself)
//   paragraph (any other text)
//
// HTML output:
//   - Block-level: <h1>...<h6>, <ul>/<li>, <ol>/<li>, <blockquote>,
//     <pre><code>, <hr/>, <p>.
//   - Inline: <strong>, <em>, <code>, <a href="...">.
//   - HTML-escapes &, <, > in normal text and code blocks.
//
// Limitations of this v1:
//   - No nested lists (no indented sub-items).
//   - No reference-style links ([text][1] / [1]: url).
//   - No images (![alt](url)).
//   - No tables.
//   - No multi-line blockquote (each > line is its own <blockquote>).
//   - No setext-style headings (=== or --- under a paragraph).
//   - Inline parsing is non-nesting (you can't put **bold** inside
//     `code` inside [...](...)).
//
// All iteration uses `while` (no for-loops, defensive against the
// v1 evaluator's for-loop-scope quirk). Every `if ... { ... }`
// block used as a statement is followed by `;`.

//----------------------------------------------------------------------------
// Types
//----------------------------------------------------------------------------

struct MdState {
  // Placeholder for future options (escape, base_url, etc.).
  dummy: int,
}

//----------------------------------------------------------------------------
// Public API
//----------------------------------------------------------------------------

// Create a fresh engine state.
pub fn new() -> MdState {
  MdState { dummy: 0 }
}

// Render a markdown document to an HTML string.
pub fn render(_state: MdState, md: string) -> string {
  let lines = split_lines(md);
  let mut html = "";
  let mut i = 0;
  let mut in_paragraph = 0;
  let mut in_ul = 0;
  let mut in_ol = 0;
  let mut in_code = 0;
  while i < len(lines) {
    let line = lines[i];
    if in_code == 1 {
      if starts_with(line, "```") {
        html = html + "</code></pre>\n";
        in_code = 0;
      } else {
        html = html + escape_html(line) + "\n";
      };
    } else {
      if starts_with(line, "```") {
        // Close any open paragraph / list.
        if in_paragraph == 1 { html = html + "</p>\n"; in_paragraph = 0; };
        if in_ul == 1 { html = html + "</ul>\n"; in_ul = 0; };
        if in_ol == 1 { html = html + "</ol>\n"; in_ol = 0; };
        html = html + "<pre><code>";
        in_code = 1;
      } else {
        let heading_level = heading_at(line);
        if heading_level > 0 {
          if in_paragraph == 1 { html = html + "</p>\n"; in_paragraph = 0; };
          if in_ul == 1 { html = html + "</ul>\n"; in_ul = 0; };
          if in_ol == 1 { html = html + "</ol>\n"; in_ol = 0; };
          let body = drop_prefix(line, heading_level + 1);
          html = html + "<h" + str(heading_level) + ">" + inline(body) + "</h" + str(heading_level) + ">\n";
        } else {
          if line == "---" {
            if in_paragraph == 1 { html = html + "</p>\n"; in_paragraph = 0; };
            if in_ul == 1 { html = html + "</ul>\n"; in_ul = 0; };
            if in_ol == 1 { html = html + "</ol>\n"; in_ol = 0; };
            html = html + "<hr/>\n";
          } else {
            if line == "" {
              if in_paragraph == 1 { html = html + "</p>\n"; in_paragraph = 0; };
              if in_ul == 1 { html = html + "</ul>\n"; in_ul = 0; };
              if in_ol == 1 { html = html + "</ol>\n"; in_ol = 0; };
            } else {
              if starts_with(line, "> ") {
                if in_paragraph == 1 { html = html + "</p>\n"; in_paragraph = 0; };
                if in_ul == 1 { html = html + "</ul>\n"; in_ul = 0; };
                if in_ol == 1 { html = html + "</ol>\n"; in_ol = 0; };
                let body = drop_prefix(line, 2);
                html = html + "<blockquote>" + inline(body) + "</blockquote>\n";
              } else {
                if starts_with(line, "* ") || starts_with(line, "- ") {
                  if in_paragraph == 1 { html = html + "</p>\n"; in_paragraph = 0; };
                  if in_ol == 1 { html = html + "</ol>\n"; in_ol = 0; };
                  if in_ul == 0 { html = html + "<ul>\n"; in_ul = 1; };
                  let body = drop_prefix(line, 2);
                  html = html + "<li>" + inline(body) + "</li>\n";
                } else {
                  let ord = ordered_list_prefix(line);
                  if ord >= 1 {
                    if in_paragraph == 1 { html = html + "</p>\n"; in_paragraph = 0; };
                    if in_ul == 1 { html = html + "</ul>\n"; in_ul = 0; };
                    if in_ol == 0 { html = html + "<ol>\n"; in_ol = 1; };
                    let dot = find_dot_after_digit(line);
                    // Skip the dot AND the space that follows it.
                    let body = drop_prefix(line, dot + 2);
                    html = html + "<li>" + inline(body) + "</li>\n";
                  } else {
                    // Paragraph.
                    if in_ul == 1 { html = html + "</ul>\n"; in_ul = 0; };
                    if in_ol == 1 { html = html + "</ol>\n"; in_ol = 0; };
                    if in_paragraph == 0 {
                      html = html + "<p>";
                      in_paragraph = 1;
                    } else {
                      html = html + " ";
                    };
                    html = html + inline(line);
                  };
                };
              };
            };
          };
        };
      };
    };
    i = i + 1;
  }
  // Close any open structures.
  if in_paragraph == 1 { html = html + "</p>\n"; in_paragraph = 0; };
  if in_ul == 1 { html = html + "</ul>\n"; in_ul = 0; };
  if in_ol == 1 { html = html + "</ol>\n"; in_ol = 0; };
  if in_code == 1 { html = html + "</code></pre>\n"; in_code = 0; };
  html
}

//----------------------------------------------------------------------------
// Block-level helpers
//----------------------------------------------------------------------------

// Split a string into lines on '\n'. Trailing empty line is preserved
// (so a final '\n' produces a trailing "" entry).
fn split_lines(s: string) -> [string] {
  let mut out = [];
  let mut cur = "";
  let mut i = 0;
  while i < len(s) {
    let c = charCode(s, i);
    if c == 10 {
      push(out, cur);
      cur = "";
    } else {
      cur = cur + str(s[i]);
    };
    i = i + 1;
  }
  if cur != "" {
    push(out, cur);
  };
  out
}

// Does `s` start with `prefix`?
fn starts_with(s: string, prefix: string) -> bool {
  if len(prefix) > len(s) {
    0 == 1
  } else {
    let mut i = 0;
    let mut ok = 1;
    while i < len(prefix) {
      if s[i] != prefix[i] {
        ok = 0;
      };
      i = i + 1;
    }
    ok == 1
  }
}

// Drop the first `n` characters from `s`. Returns the suffix.
fn drop_prefix(s: string, n: int) -> string {
  let mut out = "";
  let mut i = n;
  while i < len(s) {
    out = out + str(s[i]);
    i = i + 1;
  }
  out
}

// If `line` starts with 1..6 '#' followed by a space, return the
// heading level (1..6). Otherwise return 0.
fn heading_at(line: string) -> int {
  let mut level = 0;
  let mut i = 0;
  while i < len(line) && line[i] == '#' && level < 6 {
    level = level + 1;
    i = i + 1;
  }
  if level >= 1 && i < len(line) && line[i] == ' ' {
    level
  } else {
    0
  }
}

// If `line` starts with a digit followed by '.' and ' ', return the
// digit (1..9). Otherwise return -1.
fn ordered_list_prefix(line: string) -> int {
  if len(line) < 3 {
    -1
  } else {
    let c0 = charCode(line, 0);
    let c1 = line[1];
    let c2 = line[2];
    if c0 >= charCode("0", 0) && c0 <= charCode("9", 0) && c1 == '.' && c2 == ' ' {
      c0 - charCode("0", 0)
    } else {
      -1
    }
  }
}

// Find the index of the '.' after the leading digit(s) in an
// ordered-list line. Returns -1 if not found.
fn find_dot_after_digit(line: string) -> int {
  let mut i = 0;
  let mut found = -1;
  while i < len(line) {
    let c = line[i];
    if c == '.' {
      found = i;
      i = len(line);
    } else {
      i = i + 1;
    }
  }
  found
}

//----------------------------------------------------------------------------
// Inline rendering
//----------------------------------------------------------------------------

// Render inline markup: **bold**, *italic*, `code`, [link](url), and
// escape <, >, &. Single left-to-right scan; no nesting.
fn inline(s: string) -> string {
  let mut out = "";
  let mut i = 0;
  while i < len(s) {
    let c = str(s[i]);
    if c == "`" {
      let close = find_char(s, '`', i + 1);
      if close > i {
        let body = substring(s, i + 1, close);
        out = out + "<code>" + escape_html(body) + "</code>";
        i = close + 1;
      } else {
        out = out + escape_char(c);
        i = i + 1;
      };
    } else {
      if c == "*" && i + 1 < len(s) && s[i + 1] == '*' {
        let close = find_substring(s, "**", i + 2);
        if close > i {
          let body = substring(s, i + 2, close);
          out = out + "<strong>" + inline(body) + "</strong>";
          i = close + 2;
        } else {
          out = out + "*";
          i = i + 1;
        };
      } else {
        if c == "*" {
          let close = find_char(s, '*', i + 1);
          if close > i {
            let body = substring(s, i + 1, close);
            out = out + "<em>" + inline(body) + "</em>";
            i = close + 1;
          } else {
            out = out + "*";
            i = i + 1;
          };
        } else {
          if c == "[" {
            let close = find_char(s, ']', i + 1);
            if close > i && close + 1 < len(s) && s[close + 1] == '(' {
              let url_end = find_char(s, ')', close + 2);
              if url_end > close {
                let text = substring(s, i + 1, close);
                let url = substring(s, close + 2, url_end);
                out = out + "<a href=\"" + escape_attr(url) + "\">" + inline(text) + "</a>";
                i = url_end + 1;
              } else {
                out = out + escape_char(c);
                i = i + 1;
              };
            } else {
              out = out + escape_char(c);
              i = i + 1;
            };
          } else {
            out = out + escape_char(c);
            i = i + 1;
          };
        };
      };
    };
  }
  out
}

// Find the first occurrence of `c` in `s` at or after `from`.
// Returns -1 if not found.
fn find_char(s: string, c: any, from: int) -> int {
  let needle = if typeof_eq(c, "string") { c } else { str(c) };
  let mut i = from;
  let mut found = -1;
  while i < len(s) {
    if str(s[i]) == needle {
      found = i;
      i = len(s);
    } else {
      i = i + 1;
    }
  }
  found
}

// Find the first occurrence of `sub` in `s` at or after `from`.
// Returns -1 if not found.
fn find_substring(s: string, sub: string, from: int) -> int {
  let mut i = from;
  let mut found = -1;
  while i + len(sub) <= len(s) {
    let mut matched = 1;
    let mut j = 0;
    while j < len(sub) {
      if s[i + j] != sub[j] {
        matched = 0;
      };
      j = j + 1;
    }
    if matched == 1 {
      found = i;
      i = len(s) + 1;
    } else {
      i = i + 1;
    }
  }
  found
}

// Return the substring [start, end) of `s`.
fn substring(s: string, start: int, end: int) -> string {
  let mut out = "";
  let mut i = start;
  while i < end && i < len(s) {
    out = out + str(s[i]);
    i = i + 1;
  }
  out
}

// Is `c` of `value`'s type? Returns true if both are the same type.
fn typeof_eq(c: any, t: string) -> bool {
  type_of(c) == t
}

//----------------------------------------------------------------------------
// HTML escaping
//----------------------------------------------------------------------------

// Escape a single character for HTML (returns the char, or an entity
// for <, >, &).
fn escape_char(c: string) -> string {
  if c == "<" {
    "&lt;"
  } else {
    if c == ">" {
      "&gt;"
    } else {
      if c == "&" {
        "&amp;"
      } else {
        c
      }
    }
  }
}

// Escape a full string for HTML. Replaces <, >, & with entities.
fn escape_html(s: string) -> string {
  let mut out = "";
  let mut i = 0;
  while i < len(s) {
    out = out + escape_char(str(s[i]));
    i = i + 1;
  }
  out
}

// Escape a URL for use as an HTML attribute value. Escapes " as &quot;
// in addition to the standard <, >, & escapes.
fn escape_attr(s: string) -> string {
  let mut out = "";
  let mut i = 0;
  while i < len(s) {
    let c = str(s[i]);
    if c == "\"" {
      out = out + "&quot;";
    } else {
      out = out + escape_char(c);
    };
    i = i + 1;
  }
  out
}
