// pascals_triangle.ae
// =====================
// Build the first N rows of Pascal's triangle. Each row is an int
// array; the triangle is an array of rows.
//
//   row 0:        [1]
//   row 1:       [1, 1]
//   row 2:      [1, 2, 1]
//   row 3:     [1, 3, 3, 1]
//   row 4:    [1, 4, 6, 4, 1]
//   row 5:   [1, 5, 10, 10, 5, 1]
//   row 6:  [1, 6, 15, 20, 15, 6, 1]
//
// Recurrence:
//   row[k][0]      = 1
//   row[k][k]      = 1
//   row[k][j]      = row[k-1][j-1] + row[k-1][j]   for 0 < j < k
//
// We build the triangle iteratively: start with row 0 = [1], then
// for each subsequent row, compute element j as the sum of the two
// parents in the previous row (with sentinel 0s on either end).
//
// We use a `while` loop (not `for`) to drive the outer loop, because
// referencing a pre-loop `let` after a `for` loop hits a known
// scoping quirk in the v1 evaluator. The inner element-by-element
// build also uses `while` for the same reason.

// Build the next row given the previous row. The next row has one
// more element; each interior element is the sum of two adjacent
// elements of the previous row, with implicit zeros on the ends.
fn next_row(prev: [int]) -> [int] {
  let mut out = [];
  let n = len(prev);
  let mut i = 0;
  while i <= n {
    let left = if i == 0 { 0 } else { prev[i - 1] };
    let right = if i == n { 0 } else { prev[i] };
    push(out, left + right);
    i = i + 1;
  }
  out
}

// Build the first `n` rows of Pascal's triangle, starting from row 0.
fn pascals(n: int) -> [[int]] {
  let mut triangle = [];
  if n <= 0 {
    return triangle;
  };
  push(triangle, [1]);
  let mut i = 1;
  while i < n {
    let prev = triangle[i - 1];
    push(triangle, next_row(prev));
    i = i + 1;
  }
  triangle
}

// Render a row as space-separated values, indented so the triangle
// looks triangular in the output. We build the row string via
// `reduce` and pad with leading spaces.
fn show_row(row: [int], indent: int) -> string {
  let body = reduce(row, fn(acc: string, x: int) -> string {
    if acc == "" { str(x) } else { acc + "  " + str(x) }
  }, "");
  let mut pad = "";
  let mut k = 0;
  while k < indent {
    pad = pad + " ";
    k = k + 1;
  }
  pad + body
}

print("== Pascal's triangle (first 7 rows) ==");
print("");
let n = 7;
let triangle = pascals(n);
let mut i = 0;
while i < n {
  let row = triangle[i];
  // Indent decreases with row number so the triangle is centered.
  let indent = (n - 1 - i) * 2;
  print(show_row(row, indent));
  i = i + 1;
}
print("");

// Print the rows as arrays too, for clarity.
print("As arrays:");
let mut k = 0;
while k < n {
  let row = triangle[k];
  let body = reduce(row, fn(acc: string, x: int) -> string {
    if acc == "" { str(x) } else { acc + ", " + str(x) }
  }, "");
  print(f"  row {k}: [{body}]");
  k = k + 1;
}
print("");

// A few binomial-coefficient spot checks: row k, column j is C(k, j).
//   C(4, 2) = 6
//   C(5, 3) = 10
//   C(6, 3) = 20
print("Binomial coefficient spot checks (row[k][j] == C(k, j)):");
print(f"  C(4, 2) = row 4 [2] = {triangle[4][2]}  (expect 6)");
print(f"  C(5, 3) = row 5 [3] = {triangle[5][3]}  (expect 10)");
print(f"  C(6, 3) = row 6 [3] = {triangle[6][3]}  (expect 20)");
print("");

// Sanity assertions.
assert_eq(triangle[0], [1]);
assert_eq(triangle[1], [1, 1]);
assert_eq(triangle[2], [1, 2, 1]);
assert_eq(triangle[3], [1, 3, 3, 1]);
assert_eq(triangle[4], [1, 4, 6, 4, 1]);
assert_eq(triangle[5], [1, 5, 10, 10, 5, 1]);
assert_eq(triangle[6], [1, 6, 15, 20, 15, 6, 1]);
print("All assertions passed.");
