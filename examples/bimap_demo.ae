// bimap_demo.ae
// =============
// A bidirectional map (bimap): 5 (left_key, right_key) pairs, with
// O(1)-ish lookups in both directions. We use two parallel arrays
// (left_keys, right_keys) for the binding table, plus two extra
// arrays (left_to_right_index, right_to_left_index) for index lookups
// by either side.  For 5 pairs we use linear search — production
// bimaps would use hash tables.

// Create an empty bimap.
fn bimap_new() -> ([int], [int]) {
  ([], [])
}

// Add a (l, r) binding.  If l or r already exists, it's overwritten
// (the old binding is dropped).  Returns the new bimap tuple.
fn bimap_put(bm: ([int], [int]), l: int, r: int) -> ([int], [int]) {
  let ls = bm.0;
  let rs = bm.1;
  let mut i = 0;
  let mut found = -1;
  while i < len(ls) {
    if ls[i] == l { found = i };
    i = i + 1;
  }
  if found != -1 {
    // Update existing binding (overwrite r).
    rs[found] = r;
    (ls, rs)
  } else {
    // Check if r is already bound to some other l.
    let mut j = 0;
    let mut r_owner = -1;
    while j < len(rs) {
      if rs[j] == r { r_owner = j };
      j = j + 1;
    }
    if r_owner != -1 {
      // r is bound to l' = ls[r_owner]; drop that binding.
      let mut new_ls = [];
      let mut new_rs = [];
      let mut k = 0;
      while k < len(ls) {
        if k != r_owner {
          push(new_ls, ls[k]);
          push(new_rs, rs[k]);
        };
        k = k + 1;
      }
      push(new_ls, l);
      push(new_rs, r);
      (new_ls, new_rs)
    } else {
      push(ls, l);
      push(rs, r);
      (ls, rs)
    }
  }
}

// Look up the right value bound to `l`, or -1 if not bound.
fn bimap_get_right(bm: ([int], [int]), l: int) -> int {
  let ls = bm.0;
  let rs = bm.1;
  let mut i = 0;
  let mut found = -1;
  while i < len(ls) {
    if ls[i] == l { found = rs[i] };
    i = i + 1;
  }
  found
}

// Look up the left value bound to `r`, or -1 if not bound.
fn bimap_get_left(bm: ([int], [int]), r: int) -> int {
  let ls = bm.0;
  let rs = bm.1;
  let mut i = 0;
  let mut found = -1;
  while i < len(rs) {
    if rs[i] == r { found = ls[i] };
    i = i + 1;
  }
  found
}

// Render the bimap as "{ l <-> r, ... }".
fn show_bimap(bm: ([int], [int])) -> string {
  let ls = bm.0;
  let rs = bm.1;
  let mut out = "{";
  let mut i = 0;
  while i < len(ls) {
    if i > 0 { out = out + ", " };
    out = out + " " + str(ls[i]) + " <-> " + str(rs[i]);
    i = i + 1;
  }
  out + " }"
}

print("== Bimap demo (5 pairs, lookups both ways) ==");
print("");

let mut bm = bimap_new();
let pairs = [(1, 100), (2, 200), (3, 300), (4, 400), (5, 500)];

print("inserting 5 (l, r) pairs:");
let mut i = 0;
while i < len(pairs) {
  let p = pairs[i];
  let l = p.0;
  let r = p.1;
  bm = bimap_put(bm, l, r);
  print(f"  put({l}, {r})");
  i = i + 1;
}
print("");

print(f"bimap: {show_bimap(bm)}");
print("");

print("rightward lookups (l -> r):");
let ls_to_probe = [1, 3, 5];
let mut j = 0;
while j < len(ls_to_probe) {
  let l = ls_to_probe[j];
  let r = bimap_get_right(bm, l);
  print(f"  get_right({l}) = {r}");
  j = j + 1;
}
print("");

print("leftward lookups (r -> l):");
let rs_to_probe = [200, 400, 999];   // 999 = miss
let mut k = 0;
while k < len(rs_to_probe) {
  let r = rs_to_probe[k];
  let l = bimap_get_left(bm, r);
  print(f"  get_left({r}) = {l}");
  k = k + 1;
}
print("");

// Sanity assertions.
assert_eq(bimap_get_right(bm, 1), 100);
assert_eq(bimap_get_right(bm, 2), 200);
assert_eq(bimap_get_right(bm, 3), 300);
assert_eq(bimap_get_right(bm, 4), 400);
assert_eq(bimap_get_right(bm, 5), 500);
assert_eq(bimap_get_left(bm, 100), 1);
assert_eq(bimap_get_left(bm, 200), 2);
assert_eq(bimap_get_left(bm, 300), 3);
assert_eq(bimap_get_left(bm, 400), 4);
assert_eq(bimap_get_left(bm, 500), 5);
assert_eq(bimap_get_left(bm, 999), -1);  // miss
print("All assertions passed.");
