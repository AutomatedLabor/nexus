// dijkstra.ae
// ===========
// Dijkstra's shortest-path algorithm on a tiny 4-node weighted
// directed graph. Uses a simple O(V^2) priority queue (scan the
// `dist` array for the unvisited node with minimum tentative
// distance) — no heap, which keeps the code short and dependency-
// free.
//
// Graph (nodes: A=0, B=1, C=2, D=3):
//   A --4--> B          A --1--> C
//   C --2--> B          C --5--> D
//   B --1--> D
//
// Shortest A -> D: A -> C -> B -> D = 1 + 2 + 1 = 4
//   (vs A -> C -> D = 6, A -> B -> D = 5, A -> D direct = no edge)
//
// We track a `prev` array during relaxation so the shortest path
// can be reconstructed by walking back from the destination.

// Build a fresh array of `n` copies of `v`.
fn repeat(n: int, v: int) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < n {
    push(out, v);
    i = i + 1;
  }
  out
}

// Node label helper for printing: 0 -> "A", 1 -> "B", ...
fn node_name(i: int) -> string {
  if i == 0 { "A" } else {
  if i == 1 { "B" } else {
  if i == 2 { "C" } else {
  if i == 3 { "D" } else { "?" } } } }
}

// Render an int array of node indices as "A -> B -> C".
fn show_path(arr: [int]) -> string {
  reduce(arr, fn(acc: string, x: int) -> string {
    if acc == "" { node_name(x) } else { acc + " -> " + node_name(x) }
  }, "")
}

// Run Dijkstra on the graph (an array of [from, to, weight] triples)
// with `n` nodes, returning the dist array AND filling prev. We
// return both as a [dist, prev] pair (two arrays). Aether v1 doesn't
// have multi-return, so we use the array-of-arrays pattern.
fn dijkstra(graph: [[int]], n: int, src: int) -> [[int]] {
  let INF = 1000000;
  let mut dist = repeat(n, INF);
  let mut prev = repeat(n, -1);
  let mut visited = repeat(n, 0);  // 0 = false, 1 = true
  dist[src] = 0;
  let mut iter = 0;
  while iter < n {
    // Pick unvisited u with min dist[u].
    let mut u = -1;
    let mut best = INF;
    let mut j = 0;
    while j < n {
      if (visited[j] == 0) && (dist[j] < best) {
        best = dist[j];
        u = j;
      };
      j = j + 1;
    }
    if u == -1 {
      // No reachable unvisited node remains; stop early.
      // We use a sentinel to break out of the outer loop.
      visited[u + 1] = visited[u + 1];  // no-op to satisfy mut checker
      iter = n + 1;  // bail
    } else {
      visited[u] = 1;
      // Relax edges leaving u.
      let mut e = 0;
      while e < len(graph) {
        let edge = graph[e];
        let from = edge[0];
        let to = edge[1];
        let w = edge[2];
        if (from == u) && (visited[to] == 0) {
          let nd = dist[u] + w;
          if nd < dist[to] {
            dist[to] = nd;
            prev[to] = u;
          };
        };
        e = e + 1;
      }
      iter = iter + 1;
    }
  }
  [dist, prev]
}

// Reconstruct the path from src to dst by walking back through
// prev. We build the array in reverse then reverse it.
fn build_path(prev: [int], src: int, dst: int) -> [int] {
  if prev[dst] == -1 && src != dst {
    return [];
  };
  let mut rev = [];
  let mut cur = dst;
  let mut safety = 0;
  while (cur != -1) && (safety < 1000) {
    push(rev, cur);
    if cur == src {
      cur = -1;
    } else {
      cur = prev[cur];
    };
    safety = safety + 1;
  }
  // Reverse.
  let mut out = [];
  let mut i = len(rev) - 1;
  while i >= 0 {
    push(out, rev[i]);
    i = i - 1;
  }
  out
}

print("== Dijkstra shortest path ==");
print("");

// Adjacency list as [from, to, weight] triples.
let graph = [
  [0, 1, 4],
  [0, 2, 1],
  [2, 1, 2],
  [2, 3, 5],
  [1, 3, 1]
];
let n = 4;
let src = 0;  // A
let dst = 3;  // D

print("edges:");
let mut k = 0;
while k < len(graph) {
  let e = graph[k];
  print(f"  {node_name(e[0])} --{e[2]}--> {node_name(e[1])}");
  k = k + 1;
}
print("");

let result = dijkstra(graph, n, src);
let dist = result[0];
let prev = result[1];
print(f"dist from A: A={dist[0]}, B={dist[1]}, C={dist[2]}, D={dist[3]}");

let path = build_path(prev, src, dst);
print(f"shortest path A -> D: {show_path(path)}");
print(f"total distance: {dist[dst]}");
print("");

// Sanity assertions.
assert_eq(dist[0], 0);
assert_eq(dist[1], 3);   // A->C->B = 1+2
assert_eq(dist[2], 1);   // A->C
assert_eq(dist[3], 4);   // A->C->B->D = 1+2+1
assert_eq(path, [0, 2, 1, 3]);
print("All assertions passed.");
