// graph_dijkstra_demo.ae
// ========================
// Dijkstra's shortest-path algorithm on a 5-node weighted directed
// graph. Uses a simple O(V^2) priority queue (scan the dist array for
// the unvisited node with minimum tentative distance) — no heap,
// which keeps the code short and dependency-free.
//
// Graph (5 nodes: A=0, B=1, C=2, D=3, E=4):
//   A --2--> B          A --5--> C
//   B --1--> C          B --2--> D
//   C --3--> D          C --1--> E
//   D --4--> E          E --2--> A   (back edge, makes a cycle)
//
// Shortest A -> E:  A -> B -> C -> E = 2 + 1 + 1 = 4
//   (vs A -> B -> D -> E = 2 + 2 + 4 = 8,
//        A -> C -> E       = 5 + 1 = 6)
//
// We track a `prev` array during relaxation so the shortest path
// can be reconstructed by walking back from the destination.

// Build a fresh array of `n` copies of `v`.
fn repeat(n: int, v: int) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < n {
    push(out, v);
    i = i + 1;
  }
  out
}

// Node label helper for printing: 0 -> "A", 1 -> "B", ..., 4 -> "E".
fn node_name(i: int) -> string {
  if i == 0 { "A" } else {
  if i == 1 { "B" } else {
  if i == 2 { "C" } else {
  if i == 3 { "D" } else {
  if i == 4 { "E" } else { "?" } } } } }
}

// Render an int array of node indices as "A -> B -> C".
fn show_path(arr: [int]) -> string {
  reduce(arr, fn(acc: string, x: int) -> string {
    if acc == "" { node_name(x) } else { acc + " -> " + node_name(x) }
  }, "")
}

// Run Dijkstra on the graph (array of [from, to, weight] triples)
// with `n` nodes, returning [dist, prev] (two arrays).
fn dijkstra(graph: [[int]], n: int, src: int) -> [[int]] {
  let INF = 1000000;
  let mut dist = repeat(n, INF);
  let mut prev = repeat(n, -1);
  let mut visited = repeat(n, 0);  // 0 = false, 1 = true
  dist[src] = 0;
  let mut iter = 0;
  while iter < n {
    // Pick unvisited u with min dist[u].
    let mut u = -1;
    let mut best = INF;
    let mut j = 0;
    while j < n {
      if (visited[j] == 0) && (dist[j] < best) {
        best = dist[j];
        u = j;
      };
      j = j + 1;
    }
    if u == -1 {
      // No reachable unvisited node remains; bail.
      iter = n + 1;
    } else {
      visited[u] = 1;
      // Relax edges leaving u.
      let mut e = 0;
      while e < len(graph) {
        let edge = graph[e];
        let from = edge[0];
        let to = edge[1];
        let w = edge[2];
        if (from == u) && (visited[to] == 0) {
          let nd = dist[u] + w;
          if nd < dist[to] {
            dist[to] = nd;
            prev[to] = u;
          };
        };
        e = e + 1;
      }
      iter = iter + 1;
    }
  }
  [dist, prev]
}

// Reconstruct the path from src to dst by walking back through prev.
fn build_path(prev: [int], src: int, dst: int) -> [int] {
  if prev[dst] == -1 && src != dst {
    []
  } else {
    let mut rev = [];
    let mut cur = dst;
    let mut safety = 0;
    while (cur != -1) && (safety < 1000) {
      push(rev, cur);
      if cur == src {
        cur = -1;
      } else {
        cur = prev[cur];
      };
      safety = safety + 1;
    }
    // Reverse.
    let mut out = [];
    let mut i = len(rev) - 1;
    while i >= 0 {
      push(out, rev[i]);
      i = i - 1;
    }
    out
  }
}

print("== Dijkstra shortest path (5-node graph) ==");
print("");

// Adjacency list as [from, to, weight] triples.
let graph = [
  [0, 1, 2],
  [0, 2, 5],
  [1, 2, 1],
  [1, 3, 2],
  [2, 3, 3],
  [2, 4, 1],
  [3, 4, 4],
  [4, 0, 2]
];
let n = 5;
let src = 0;  // A
let dst = 4;  // E

print("edges:");
let mut k = 0;
while k < len(graph) {
  let e = graph[k];
  print(f"  {node_name(e[0])} --{e[2]}--> {node_name(e[1])}");
  k = k + 1;
}
print("");

let result = dijkstra(graph, n, src);
let dist = result[0];
let prev = result[1];

print(f"dist from A: A={dist[0]}, B={dist[1]}, C={dist[2]}, D={dist[3]}, E={dist[4]}");
print("");

// Print the shortest path from A to every other node.
print("shortest paths from A:");
let mut t = 0;
while t < n {
  let path = build_path(prev, src, t);
  if len(path) == 0 {
    print(f"  A -> {node_name(t)}: unreachable");
  } else {
    print(f"  A -> {node_name(t)}: {show_path(path)}  (total {dist[t]})");
  };
  t = t + 1;
}
print("");

// Sanity assertions.
assert_eq(dist[0], 0);   // A -> A
assert_eq(dist[1], 2);   // A -> B = 2
assert_eq(dist[2], 3);   // A -> B -> C = 2 + 1
assert_eq(dist[3], 4);   // A -> B -> D = 2 + 2
assert_eq(dist[4], 4);   // A -> B -> C -> E = 2 + 1 + 1
assert_eq(build_path(prev, src, dst), [0, 1, 2, 4]);  // A -> B -> C -> E
print("All assertions passed.");
