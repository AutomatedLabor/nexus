// sudoku_validator.ae
// ===================
// Validate a 9×9 Sudoku grid: check that each row, each column, and
// each of the nine 3×3 boxes contains the digits 1-9 exactly once.
// (We don't solve — we only validate a proposed solution.)
//
// The grid is a flat array of 81 ints (row-major). A 0 means "empty"
// (and we count it as invalid — a valid solution has no empties).
//
// We use three helper predicates:
//   - all_present(group)  — true if a 9-element group has all of 1..9
//   - row_ok(grid, r)     — row r contains 1..9
//   - col_ok(grid, c)     — column c contains 1..9
//   - box_ok(grid, b)     — 3x3 box b (b = 0..8, left-to-right, top-to-bottom)
//
// The grid is valid iff all rows, columns, and boxes pass.

// True when `group` (a 9-element int array) contains exactly the digits 1-9.
fn all_present(group: [int]) -> bool {
  let mut i = 1;
  let mut all = true;
  while i <= 9 && all {
    let mut j = 0;
    let mut found = false;
    while j < 9 && !found {
      if group[j] == i { found = true; };
      j = j + 1;
    }
    if !found { all = false; };
    i = i + 1;
  }
  all
}

// Extract row r (0..8) as a 9-element array.
fn get_row(grid: [int], r: int) -> [int] {
  let mut out = [];
  let mut c = 0;
  while c < 9 {
    push(out, grid[r * 9 + c]);
    c = c + 1;
  }
  out
}

// Extract column c (0..8) as a 9-element array.
fn get_col(grid: [int], c: int) -> [int] {
  let mut out = [];
  let mut r = 0;
  while r < 9 {
    push(out, grid[r * 9 + c]);
    r = r + 1;
  }
  out
}

// Extract box b (0..8) as a 9-element array. Boxes are numbered:
//   0 1 2
//   3 4 5
//   6 7 8
// Box b's top-left cell is at (row = (b / 3) * 3, col = (b % 3) * 3).
fn get_box(grid: [int], b: int) -> [int] {
  let mut out = [];
  let base_row = int(b / 3) * 3;
  let base_col = (b - int(b / 3) * 3) * 3;
  let mut i = 0;
  while i < 3 {
    let mut j = 0;
    while j < 3 {
      push(out, grid[(base_row + i) * 9 + (base_col + j)]);
      j = j + 1;
    }
    i = i + 1;
  }
  out
}

// Validate the full grid: every row, column, and box has 1..9 exactly once.
fn is_valid(grid: [int]) -> bool {
  let mut i = 0;
  let mut valid = true;
  while i < 9 && valid {
    if !all_present(get_row(grid, i)) { valid = false; };
    if !all_present(get_col(grid, i)) { valid = false; };
    if !all_present(get_box(grid, i)) { valid = false; };
    i = i + 1;
  }
  valid
}

// Render the grid as a 9×9 ASCII display with box separators.
fn show_grid(grid: [int]) -> string {
  let mut out = "";
  let mut r = 0;
  while r < 9 {
    if r > 0 && r % 3 == 0 {
      out = out + "------+-------+------\n";
    };
    let mut c = 0;
    let mut row_str = "";
    while c < 9 {
      if c > 0 && c % 3 == 0 { row_str = row_str + "| "; };
      row_str = row_str + str(grid[r * 9 + c]) + " ";
      c = c + 1;
    }
    out = out + row_str + "\n";
    r = r + 1;
  }
  out
}

print("== Sudoku validator ==");
print("");

// A complete, valid Sudoku solution.
let valid_grid = [
  5, 3, 4, 6, 7, 8, 9, 1, 2,
  6, 7, 2, 1, 9, 5, 3, 4, 8,
  1, 9, 8, 3, 4, 2, 5, 6, 7,
  8, 5, 9, 7, 6, 1, 4, 2, 3,
  4, 2, 6, 8, 5, 3, 7, 9, 1,
  7, 1, 3, 9, 2, 4, 8, 5, 6,
  9, 6, 1, 5, 3, 7, 2, 8, 4,
  2, 8, 7, 4, 1, 9, 6, 3, 5,
  3, 4, 5, 2, 8, 6, 1, 7, 9,
];

print("Sample 1 (complete valid solution):");
print(show_grid(valid_grid));
print(f"Valid? {is_valid(valid_grid)}");
print("");

// A grid with a row violation (row 0 has two 5s and a missing 6).
let row_bad = valid_grid + [];
row_bad[3] = 5;   // replace 6 with 5 → row 0 has two 5s, missing 6
print("Sample 2 (row 0 has duplicate 5):");
print(show_grid(row_bad));
print(f"Valid? {is_valid(row_bad)}");
print("");

// A grid with a column violation.
let col_bad = valid_grid + [];
col_bad[0] = 6;   // grid[0] = 5 -> 6 (column 0 now has two 6s, missing 5)
print("Sample 3 (column 0 has duplicate 6):");
print(show_grid(col_bad));
print(f"Valid? {is_valid(col_bad)}");
print("");

// A grid with a 3x3 box violation.
let box_bad = valid_grid + [];
box_bad[0] = 6;   // grid[0] = 5 -> 6 (top-left box now has two 6s, missing 5)
print("Sample 4 (top-left box has duplicate 6):");
print(show_grid(box_bad));
print(f"Valid? {is_valid(box_bad)}");
print("");

// A partial grid (with 0s) — should be invalid (we count 0 as wrong).
let partial = valid_grid + [];
partial[0] = 0;
print("Sample 5 (partial grid with a 0 — invalid):");
print(show_grid(partial));
print(f"Valid? {is_valid(partial)}");
print("");

// Sanity assertions.
assert_eq(is_valid(valid_grid), true);
assert_eq(is_valid(row_bad), false);
assert_eq(is_valid(col_bad), false);
assert_eq(is_valid(box_bad), false);
assert_eq(is_valid(partial), false);
print("All assertions passed.");
