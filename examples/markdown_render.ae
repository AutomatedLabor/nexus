// markdown_render.ae
// ==================
// A tiny Markdown-to-HTML renderer. We support a small subset:
//   # Heading 1     -> <h1>...</h1>
//   ## Heading 2    -> <h2>...</h2>
//   ### Heading 3   -> <h3>...</h3>
//   * item          -> <ul><li>item</li>...</ul>  (consecutive *)
//   **bold**       -> <strong>bold</strong>
//   plain paragraph -> <p>...</p>
//
// Inline formatting (`**bold**`) is applied within paragraphs and
// list items; headings are rendered plain (no inline formatting).

// Find the index of substring `sub` in `s`, starting at `from`.
// Returns -1 if not found.
fn index_of(s: string, sub: string, from: int) -> int {
  let n = len(s);
  let m = len(sub);
  let mut i = from;
  let mut found = -1;
  while (i + m <= n) && (found == -1) {
    let mut j = 0;
    let mut ok = true;
    while (j < m) && ok {
      if str(s[i + j]) == str(sub[j]) { } else { ok = false };
      j = j + 1;
    }
    if ok { found = i };
    i = i + 1;
  }
  found
}

// Render inline `**bold**` as <strong>bold</strong> within `text`.
fn render_inline(text: string) -> string {
  let mut out = "";
  let mut i = 0;
  let n = len(text);
  while i < n {
    let c = str(text[i]);
    // Look for `**`
    if (c == "*") && (i + 1 < n) && (str(text[i + 1]) == "*") {
      // find closing **
      let close = index_of(text, "**", i + 2);
      if close != -1 {
        let inner = slice_str(text, i + 2, close);
        out = out + "<strong>" + render_inline(inner) + "</strong>";
        i = close + 2;
      } else {
        out = out + c;
        i = i + 1;
      };
    } else {
      out = out + c;
      i = i + 1;
    };
  }
  out
}

// Slice `s` from `lo` (inclusive) to `hi` (exclusive).
fn slice_str(s: string, lo: int, hi: int) -> string {
  let mut out = "";
  let mut i = lo;
  while i < hi {
    out = out + str(s[i]);
    i = i + 1;
  }
  out
}

// Count leading `#` characters (1..3) and return the heading level.
fn heading_level(line: string) -> int {
  let mut lvl = 0;
  let mut i = 0;
  while (i < len(line)) && (str(line[i]) == "#") && (lvl < 6) {
    lvl = lvl + 1;
    i = i + 1;
  }
  if (lvl > 0) && (i < len(line)) && (str(line[i]) == " ") {
    lvl
  } else {
    0
  }
}

// Trim leading and trailing whitespace from a string.
fn trim(s: string) -> string {
  let mut lo = 0;
  let mut hi = len(s);
  while (lo < hi) && is_ws(str(s[lo])) { lo = lo + 1; }
  while (hi > lo) && is_ws(str(s[hi - 1])) { hi = hi - 1; }
  slice_str(s, lo, hi)
}

fn is_ws(c: string) -> bool {
  (c == " ") || (c == "\t") || (c == "\n") || (c == "\r")
}

// Render a Markdown source string as HTML.
fn render(md: string) -> string {
  let mut html = "";
  let mut lines = split_lines(md);
  let mut i = 0;
  let mut in_list = false;
  while i < len(lines) {
    let line = lines[i];
    let lvl = heading_level(line);
    if lvl > 0 {
      if in_list { html = html + "</ul>\n"; in_list = false };
      let body = trim(slice_str(line, lvl + 1, len(line)));
      html = html + "<h" + str(lvl) + ">" + body + "</h" + str(lvl) + ">\n";
    } else {
      if (len(line) >= 2) && (str(line[0]) == "*") && (str(line[1]) == " ") {
        if !in_list { html = html + "<ul>\n"; in_list = true };
        let body = trim(slice_str(line, 2, len(line)));
        html = html + "  <li>" + render_inline(body) + "</li>\n";
      } else {
        if trim(line) == "" {
          if in_list { html = html + "</ul>\n"; in_list = false };
        } else {
          if in_list { html = html + "</ul>\n"; in_list = false };
          html = html + "<p>" + render_inline(trim(line)) + "</p>\n";
        }
      }
    };
    i = i + 1;
  }
  if in_list { html = html + "</ul>\n" };
  html
}

// Split a string on `\n` into a list of lines (without the `\n`).
fn split_lines(s: string) -> [string] {
  let mut out = [];
  let mut cur = "";
  let mut i = 0;
  while i < len(s) {
    let c = str(s[i]);
    if c == "\n" {
      push(out, cur);
      cur = "";
    } else {
      if c != "\r" { cur = cur + c }
    };
    i = i + 1;
  }
  if cur != "" { push(out, cur) };
  out
}

print("== Markdown renderer ==");
print("");

let md = "# Hello, Aether!\n\nThis is a **bold** paragraph.\n\n## Section 2\n\n* one\n* two\n* three with **bold** text\n\n### Subsection\n\nFinal paragraph.\n";
print("input markdown:");
print(md);
print("");

let html = render(md);
print("rendered HTML:");
print(html);

// Sanity assertions.
assert_eq(heading_level("# Hello"), 1);
assert_eq(heading_level("## Two"), 2);
assert_eq(heading_level("plain"), 0);
assert_eq(render_inline("**hi**"), "<strong>hi</strong>");
assert_eq(render_inline("a**b**c"), "a<strong>b</strong>c");
let html2 = render("# T\np\n");
assert_eq(html2, "<h1>T</h1>\n<p>p</p>\n");
print("All assertions passed.");
