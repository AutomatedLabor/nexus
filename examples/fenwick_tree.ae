// fenwick_tree.ae
// ================
// A Fenwick tree (Binary Indexed Tree, BIT) for prefix-sum queries.
// Given an array of N integers, we support:
//   - update(i, delta): add `delta` to position `i` (0-indexed).
//   - prefix(i):        return sum of data[0..=i].
// Both operations are O(log N). Internally the BIT is stored in a
// 1-indexed array `bit[1..N]` where bit[k] holds the sum of
// indices (k - lowbit(k), k]. We convert 0-based indices to 1-based
// on the way in.

// Build a fresh array of `n` copies of `v`.
fn repeat(n: int, v: int) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < n { push(out, v); i = i + 1; }
  out
}

// Lowest set bit of x (x & -x). Returns 0 for x <= 0.
fn lowbit(x: int) -> int { x & (-x) }

// Build a BIT of size `n` from an initial data array. We use the
// O(N log N) construction: insert each element one at a time.
fn build_bit(data: [int], n: int) -> [int] {
  let bit = repeat(n + 2, 0);
  let mut i = 0;
  while i < n {
    bit_update(bit, n, i, data[i]);
    i = i + 1;
  }
  bit
}

// Add `delta` to position i (0-indexed).
fn bit_update(bit: [int], n: int, i: int, delta: int) -> int {
  let mut k = i + 1;
  while k <= n {
    bit[k] = bit[k] + delta;
    k = k + lowbit(k);
  }
  delta
}

// Prefix sum of data[0..=i] (0-indexed). Returns 0 for i < 0.
fn bit_prefix(bit: [int], i: int) -> int {
  let mut s = 0;
  let mut k = i + 1;
  while k > 0 {
    s = s + bit[k];
    k = k - lowbit(k);
  }
  s
}

// Range sum data[l..=r] = prefix(r) - prefix(l-1).
fn bit_range(bit: [int], l: int, r: int) -> int {
  if l == 0 {
    bit_prefix(bit, r)
  } else {
    bit_prefix(bit, r) - bit_prefix(bit, l - 1)
  }
}

print("== Fenwick tree (BIT) ==");
print("");

let data = [3, 1, 4, 1, 5, 9, 2, 6];
let n = len(data);
let bit = build_bit(data, n);
print(f"data: {show(data)}");
print("");

// Prefix queries.
print("prefix sums:");
print(f"  prefix(0) = {bit_prefix(bit, 0)}   (expected 3)");
print(f"  prefix(2) = {bit_prefix(bit, 2)}   (expected 3+1+4 = 8)");
print(f"  prefix(3) = {bit_prefix(bit, 3)}   (expected 3+1+4+1 = 9)");
print(f"  prefix(7) = {bit_prefix(bit, 7)}   (expected total = 31)");
print("");

// Range queries.
print("range sums:");
print(f"  sum[2..4] = {bit_range(bit, 2, 4)}   (expected 4+1+5 = 10)");
print(f"  sum[0..7] = {bit_range(bit, 0, 7)}   (expected 31)");
print(f"  sum[3..6] = {bit_range(bit, 3, 6)}   (expected 1+5+9+2 = 17)");
print("");

// Updates.
print("update: data[3] += 99  (1 -> 100)");
let _ = bit_update(bit, n, 3, 99);
print(f"  prefix(7) = {bit_prefix(bit, 7)}   (expected 31 + 99 = 130)");
print(f"  sum[2..4] = {bit_range(bit, 2, 4)}   (expected 4 + 100 + 5 = 109)");
print("");

// Sanity assertions.
assert_eq(bit_prefix(bit, 7), 130);
assert_eq(bit_range(bit, 2, 4), 109);
assert_eq(bit_range(bit, 0, 0), 3);
assert_eq(bit_range(bit, 7, 7), 6);
print("All assertions passed.");

// Render an int array as a comma-separated "[a, b, c]" string.
fn show(arr: [int]) -> string {
  let mut out = "[";
  let mut i = 0;
  while i < len(arr) {
    if i > 0 { out = out + ", " };
    out = out + str(arr[i]);
    i = i + 1;
  }
  out + "]"
}
