// factorial_digit_sum.ae
// ======================
// Compute factorial(10) = 3628800, then sum its digits:
//   3 + 6 + 2 + 8 + 8 + 0 + 0 = 27
//
// The factorial is computed iteratively with a while loop (we keep
// it small because the naive recursive form would explode for
// large n, and n=10 is plenty to demonstrate the digit-sum trick).
// The digit sum is computed by converting the integer to a string
// and folding each character back to its integer value with
// `reduce` — the canonical pattern for avoiding the for-loop-scope
// quirk when iterating over an array with side effects.

// Iterative factorial. n! = 1 * 2 * ... * n, with 0! = 1 by convention.
fn factorial(n: int) -> int {
  let mut result = 1;
  let mut i = 2;
  while i <= n {
    result = result * i;
    i = i + 1;
  }
  result
}

// Convert a single digit character to its integer value. Used when
// walking the string representation of a number. We chain if/else
// since Aether v1 doesn't have a `switch`/`case` statement.
fn digit_value(c: string) -> int {
  if c == "0" { 0 } else {
  if c == "1" { 1 } else {
  if c == "2" { 2 } else {
  if c == "3" { 3 } else {
  if c == "4" { 4 } else {
  if c == "5" { 5 } else {
  if c == "6" { 6 } else {
  if c == "7" { 7 } else {
  if c == "8" { 8 } else {
  9 } } } } } } } } }
}

// Sum the digits of an integer via reduce. We:
//   1. str(n)        → its decimal representation
//   2. build a [string] of single chars via a while loop
//   3. reduce over that array, converting each char to its int value
//      and adding to the accumulator.
// We need the intermediate char array because `reduce` only folds
// over arrays, and we don't have a builtin to walk a string char by
// char.
fn char_array(s: string) -> [string] {
  let mut out = [];
  let mut i = 0;
  while i < len(s) {
    push(out, str(s[i]));
    i = i + 1;
  }
  out
}

fn digit_sum(n: int) -> int {
  let chars = char_array(str(n));
  reduce(chars, fn(acc: int, c: string) -> int {
    acc + digit_value(c)
  }, 0)
}

print("== Factorial digit sum ==");
print("");
let n = 10;
let f = factorial(n);
let s = digit_sum(f);
print(f"factorial({n}) = {f}");
print(f"sum of digits of {f} = {s}");
print("");

// A few more cases.
let cases = [0, 1, 5, 7, 10];
let mut k = 0;
while k < len(cases) {
  let c = cases[k];
  let fc = factorial(c);
  let sc = digit_sum(fc);
  print(f"  {c}! = {fc}, digit sum = {sc}");
  k = k + 1;
}
print("");

// Sanity assertions.
assert_eq(factorial(0), 1);
assert_eq(factorial(1), 1);
assert_eq(factorial(5), 120);
assert_eq(factorial(10), 3628800);
assert_eq(digit_sum(3628800), 27);
assert_eq(digit_sum(120), 3);
assert_eq(digit_sum(0), 0);
print("All assertions passed.");
