// prim_mst.ae
// ===========
// Prim's Minimum Spanning Tree. We start from node 0 and grow the
// tree by repeatedly adding the lowest-weight edge that crosses the
// cut (one endpoint in the tree, the other not).
//
// Uses an O(V^2) scan of an edge list to find the cheapest cut
// edge at each step — no heap.
//
// Graph (5 nodes A..E as 0..4), 7 undirected edges:
//   A-B 2, A-C 3, B-C 1, B-D 4, C-D 5, C-E 6, D-E 7
// MST weight: 2 + 1 + 4 + 6 = 13

fn repeat(n: int, v: int) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < n { push(out, v); i = i + 1; }
  out
}

fn name_of(i: int) -> string {
  if i == 0 { "A" } else {
  if i == 1 { "B" } else {
  if i == 2 { "C" } else {
  if i == 3 { "D" } else {
  if i == 4 { "E" } else { "?" } } } } }
}

// We store each undirected edge as both directions in the list.
// Edges as [from, to, weight].
fn prim(edges: [[int]], n: int) -> [[int]] {
  let mut in_tree = repeat(n, 0);
  let mut mst = [];
  in_tree[0] = 1;
  let mut count = 1;
  while count < n {
    let mut best_w = 1000000;
    let mut best_u = -1;
    let mut best_v = -1;
    let mut i = 0;
    while i < len(edges) {
      let e = edges[i];
      let u = e[0];
      let v = e[1];
      let w = e[2];
      // one side in tree, the other not
      if (in_tree[u] == 1) && (in_tree[v] == 0) && (w < best_w) {
        best_w = w;
        best_u = u;
        best_v = v;
      };
      i = i + 1;
    }
    if best_v == -1 { return mst; };  // disconnected
    in_tree[best_v] = 1;
    push(mst, [best_u, best_v, best_w]);
    count = count + 1;
  }
  mst
}

fn total_weight(mst: [[int]]) -> int {
  let mut s = 0;
  let mut i = 0;
  while i < len(mst) { s = s + mst[i][2]; i = i + 1; }
  s
}

print("== Prim's MST ==");
print("");

let edges = [
  [0, 1, 2],
  [1, 0, 2],
  [0, 2, 3],
  [2, 0, 3],
  [1, 2, 1],
  [2, 1, 1],
  [1, 3, 4],
  [3, 1, 4],
  [2, 3, 5],
  [3, 2, 5],
  [2, 4, 6],
  [4, 2, 6],
  [3, 4, 7],
  [4, 3, 7]
];
let n = 5;

print("edges:");
let mut i = 0;
while i < len(edges) {
  let e = edges[i];
  if e[0] < e[1] {  // print each undirected edge once
    print(f"  {name_of(e[0])} -- {name_of(e[1])}  w = {e[2]}");
  };
  i = i + 1;
}
print("");

let mst = prim(edges, n);
print(f"MST ({len(mst)} edges):");
let mut j = 0;
while j < len(mst) {
  let e = mst[j];
  print(f"  {name_of(e[0])} -- {name_of(e[1])}  w = {e[2]}");
  j = j + 1;
}
print(f"total weight: {total_weight(mst)}");
print("");

// Sanity assertions.
assert_eq(len(mst), 4);
assert_eq(total_weight(mst), 13);
print("All assertions passed.");
