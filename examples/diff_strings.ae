// diff_strings.ae
// ===============
// A simple line-oriented diff utility based on the longest common
// subsequence (LCS) of the two input strings' lines.
//
// Given two strings, we split each into lines, compute the LCS of
// the line sequences, and emit a diff:
//   "  xxx" — common line (unchanged)
//   "- xxx" — line only in A (removed)
//   "+ xxx" — line only in B (added)
//
// The LCS is computed with classical dynamic programming:
//   dp[i][j] = length of LCS of A[0..i) and B[0..j)
//   dp[i][j] = dp[i-1][j-1] + 1               if A[i-1] == B[j-1]
//            = max(dp[i-1][j], dp[i][j-1])    otherwise
//
// We then walk the DP table from the bottom-right back to the top-left
// to reconstruct the diff. Output is a list of (kind, line) tuples
// where kind is " ", "-", or "+".
//
// We use parallel-array tables for `dp` (a flat row-major int array)
// to avoid recursion and to keep the algorithm iterative.

// Split a string into lines by '\n'. Trailing newline does not
// produce an empty last line.
fn split_lines(s: string) -> [string] {
  let mut out = [];
  let mut cur = "";
  let mut i = 0;
  let n = len(s);
  while i < n {
    let c = str(s[i]);
    if c == "\n" {
      push(out, cur);
      cur = "";
    } else {
      cur = cur + c;
    };
    i = i + 1;
  }
  // Last line: emit only if non-empty OR if the input ended with a
  // newline AND we want to preserve that (we don't here).
  if len(cur) > 0 {
    push(out, cur);
  };
  out
}

// Get the dp value at (i, j) from a flat row-major table with `cols+1`
// columns.
fn dp_get(table: [int], i: int, j: int, cols: int) -> int {
  table[i * (cols + 1) + j]
}

// Set the dp value at (i, j) in a flat row-major table.
fn dp_set(table: [int], i: int, j: int, cols: int, v: int) {
  table[i * (cols + 1) + j] = v
}

// Compute the LCS-length DP table for lines a and b.
//   result[i * (cols+1) + j] = LCS(a[0..i), b[0..j))
fn lcs_table(a: [string], b: [string]) -> [int] {
  let rows = len(a);
  let cols = len(b);
  let mut table = [];
  // Initialize a (rows+1) x (cols+1) table to 0.
  let mut i = 0;
  while i < (rows + 1) * (cols + 1) {
    push(table, 0);
    i = i + 1;
  }
  // Fill the table.
  let mut ii = 1;
  while ii <= rows {
    let mut jj = 1;
    while jj <= cols {
      if a[ii - 1] == b[jj - 1] {
        let v = dp_get(table, ii - 1, jj - 1, cols) + 1;
        dp_set(table, ii, jj, cols, v);
      } else {
        let up = dp_get(table, ii - 1, jj, cols);
        let left = dp_get(table, ii, jj - 1, cols);
        let v = if up > left { up } else { left };
        dp_set(table, ii, jj, cols, v);
      };
      jj = jj + 1;
    }
    ii = ii + 1;
  }
  table
}

// Build a diff of two strings. Returns a list of (kind, line) tuples
// where kind is " " (common), "-" (only in A), or "+" (only in B).
fn diff_strings(a: string, b: string) -> [(string, string)] {
  let la = split_lines(a);
  let lb = split_lines(b);
  let table = lcs_table(la, lb);
  let rows = len(la);
  let cols = len(lb);
  // Backtrack from (rows, cols) to (0, 0).
  let mut i = rows;
  let mut j = cols;
  let mut reversed = [];
  let mut safety = 0;
  while (i > 0 || j > 0) && safety < rows + cols + 10 {
    safety = safety + 1;
    if i > 0 && j > 0 && la[i - 1] == lb[j - 1] {
      push(reversed, (" ", la[i - 1]));
      i = i - 1;
      j = j - 1;
    } else {
      if j > 0 && (i == 0 || dp_get(table, i, j - 1, cols) >= dp_get(table, i - 1, j, cols)) {
        push(reversed, ("+", lb[j - 1]));
        j = j - 1;
      } else {
        push(reversed, ("-", la[i - 1]));
        i = i - 1;
      };
    };
  }
  // Reverse the result.
  let mut out = [];
  let mut k = len(reversed) - 1;
  while k >= 0 {
    push(out, reversed[k]);
    k = k - 1;
  }
  out
}

// Render a diff as a printable string with the kind prefixes.
fn show_diff(diff: [(string, string)]) -> string {
  let mut out = "";
  let mut i = 0;
  while i < len(diff) {
    let pair = diff[i];
    let kind = pair.0;
    let line = pair.1;
    out = out + kind + " " + line + "\n";
    i = i + 1;
  }
  out
}

print("== String diff (LCS-based) ==");
print("");
print("Computes a line-oriented diff between two strings using");
print("the longest common subsequence (LCS) of the lines.");
print("");

// Test 1: simple addition.
let a1 = "alpha\nbeta\ngamma";
let b1 = "alpha\nbeta\ndelta\ngamma";
print("Test 1: insert a line in the middle");
print("--- A ---");
print(a1);
print("--- B ---");
print(b1);
print("--- diff ---");
print(show_diff(diff_strings(a1, b1)));
print("");

// Test 2: removal.
let a2 = "alpha\nbeta\ngamma\ndelta";
let b2 = "alpha\ngamma\ndelta";
print("Test 2: delete a line");
print("--- A ---");
print(a2);
print("--- B ---");
print(b2);
print("--- diff ---");
print(show_diff(diff_strings(a2, b2)));
print("");

// Test 3: complete rewrite (no common lines).
let a3 = "one\ntwo";
let b3 = "three\nfour";
print("Test 3: no common lines");
print("--- A ---");
print(a3);
print("--- B ---");
print(b3);
print("--- diff ---");
print(show_diff(diff_strings(a3, b3)));
print("");

// Test 4: identical strings.
let a4 = "same\nlines\nhere";
let b4 = "same\nlines\nhere";
print("Test 4: identical");
print("--- A ---");
print(a4);
print("--- B ---");
print(b4);
print("--- diff ---");
print(show_diff(diff_strings(a4, b4)));
print("");

// Test 5: poem-style edit.
let a5 = "roses are red\nviolets are blue\nsugar is sweet";
let b5 = "roses are red\nviolets are green\nsugar is sweet\nand so are you";
print("Test 5: a small poem edit");
print("--- A ---");
print(a5);
print("--- B ---");
print(b5);
print("--- diff ---");
print(show_diff(diff_strings(a5, b5)));
print("");

// Sanity assertions.
let d1 = diff_strings(a1, b1);
// Expected diff: "  alpha" / "  beta" / "+ delta" / "  gamma"
assert_eq(len(d1), 4);
assert_eq(d1[0].0, " ");
assert_eq(d1[1].0, " ");
assert_eq(d1[2].0, "+");
assert_eq(d1[2].1, "delta");
assert_eq(d1[3].0, " ");

let d2 = diff_strings(a2, b2);
// Expected diff: "  alpha" / "- beta" / "  gamma" / "  delta"
assert_eq(len(d2), 4);
assert_eq(d2[0].0, " ");
assert_eq(d2[1].0, "-");
assert_eq(d2[1].1, "beta");
assert_eq(d2[2].0, " ");
assert_eq(d2[3].0, " ");

let d3 = diff_strings(a3, b3);
// Expected diff: "- one" / "- two" / "+ three" / "+ four"
assert_eq(len(d3), 4);
assert_eq(d3[0].0, "-");
assert_eq(d3[0].1, "one");
assert_eq(d3[1].0, "-");
assert_eq(d3[1].1, "two");
assert_eq(d3[2].0, "+");
assert_eq(d3[2].1, "three");
assert_eq(d3[3].0, "+");
assert_eq(d3[3].1, "four");

let d4 = diff_strings(a4, b4);
// All common.
assert_eq(len(d4), 3);
assert_eq(d4[0].0, " ");
assert_eq(d4[1].0, " ");
assert_eq(d4[2].0, " ");

print("All assertions passed.");
