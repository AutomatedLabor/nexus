// armstrong.ae
// =============
// An Armstrong number (also called a narcissistic number) is a
// number that equals the sum of its own digits each raised to the
// power of the number of digits.
//
//   153      (3 digits): 1^3 + 5^3 + 3^3 = 1 + 125 + 27 = 153   ✓
//   370      (3 digits): 3^3 + 7^3 + 0^3 = 27 + 343 + 0 = 370   ✓
//   371      (3 digits): 3^3 + 7^3 + 1^3 = 27 + 343 + 1 = 371   ✓
//   9474     (4 digits): 9^4 + 4^4 + 7^4 + 4^4
//                      = 6561 + 256 + 2401 + 256 = 9474         ✓
//
// Strategy: convert the number to a string, build a [string] of
// single chars via a while loop, then `reduce` over that array
// accumulating `acc + pow(digit, num_digits)`. We implement `pow`
// iteratively with a small while loop (avoids any recursion-depth
// concerns and keeps the type checker happy).
//
// Aether's `/` is float division, so we use `int(...)` to truncate
// any division that needs to land in integer land — though for this
// program we only ever use `% 10` (integer modulo) and `pow`, so
// no division is needed.

// Convert a single digit char to its int value.
fn digit_value(c: string) -> int {
  if c == "0" { 0 } else {
  if c == "1" { 1 } else {
  if c == "2" { 2 } else {
  if c == "3" { 3 } else {
  if c == "4" { 4 } else {
  if c == "5" { 5 } else {
  if c == "6" { 6 } else {
  if c == "7" { 7 } else {
  if c == "8" { 8 } else {
  9 } } } } } } } } }
}

// Build a [string] of single chars from s.
fn char_array(s: string) -> [string] {
  let mut out = [];
  let mut i = 0;
  while i < len(s) {
    push(out, str(s[i]));
    i = i + 1;
  }
  out
}

// Integer power: b^e, computed iteratively. e is a non-negative int.
fn int_pow(b: int, e: int) -> int {
  let mut out = 1;
  let mut i = 0;
  while i < e {
    out = out * b;
    i = i + 1;
  }
  out
}

// Test whether n is an Armstrong number. We:
//   1. str(n)               -> decimal representation
//   2. char_array(s)        -> [string] of single chars
//   3. reduce over chars, summing pow(digit, num_digits)
//   4. compare sum == n
fn is_armstrong(n: int) -> bool {
  let s = str(n);
  let num_digits = len(s);
  let chars = char_array(s);
  let sum = reduce(chars, fn(acc: int, c: string) -> int {
    acc + int_pow(digit_value(c), num_digits)
  }, 0);
  sum == n
}

print("== Armstrong numbers ==");
print("");
print("Single-number checks:");
let cases = [153, 370, 371, 9474, 407, 1634, 8208, 9475, 100, 123, 5];
let mut k = 0;
while k < len(cases) {
  let n = cases[k];
  let v = is_armstrong(n);
  let tag = if v { "Armstrong" } else { "not Armstrong" };
  print(f"  {n}: {tag}");
  k = k + 1;
}
print("");

// Show the decomposition for the textbook examples.
print("Decompositions:");
let examples = [153, 370, 371, 9474, 407];
let mut j = 0;
while j < len(examples) {
  let n = examples[j];
  let s = str(n);
  let nd = len(s);
  let chars = char_array(s);
  let expr = reduce(chars, fn(acc: string, c: string) -> string {
    let term = c + "^" + str(nd);
    if acc == "" { term } else { acc + " + " + term }
  }, "");
  let sum = reduce(chars, fn(acc: int, c: string) -> int {
    acc + int_pow(digit_value(c), nd)
  }, 0);
  let verdict = if sum == n { "EQUAL" } else { "NOT EQUAL" };
  print(f"  {n}: {expr} = {sum}  [{verdict}]");
  j = j + 1;
}
print("");

// Sanity assertions.
assert_eq(is_armstrong(153), true);
assert_eq(is_armstrong(370), true);
assert_eq(is_armstrong(371), true);
assert_eq(is_armstrong(9474), true);
assert_eq(is_armstrong(407), true);
assert_eq(is_armstrong(1634), true);
assert_eq(is_armstrong(8208), true);
assert_eq(is_armstrong(9475), false);
assert_eq(is_armstrong(100), false);
assert_eq(is_armstrong(123), false);
assert_eq(is_armstrong(5), true);
print("All assertions passed.");
