// combination_sum.ae
// ==================
// Combination sum: given an array of distinct candidate integers
// and a target, find all unique combinations of candidates that
// sum to target. Candidates can be reused. Order doesn't matter
// (so [2, 3, 2] is the same as [2, 2, 3]).
//
//   candidates = [2, 3, 6, 7], target = 7
//     ->  [[2, 2, 3], [7]]
//
// Standard backtracking: sort the candidates, then DFS, picking
// each candidate in turn (only from current index onward to avoid
// duplicates) and recursing with the reduced target.
//
// To avoid the v1 evaluator's "cannot assign to immutable
// parameter" limitation, we pass copies of `path` through the
// recursion rather than mutating and popping in place.

// Copy an int array.
fn copy_ints(arr: [int]) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < len(arr) {
    push(out, arr[i]);
    i = i + 1;
  }
  out
}

// Append x to a copy of arr; returns the new array.
fn with_elem(arr: [int], x: int) -> [int] {
  let mut out = copy_ints(arr);
  push(out, x);
  out
}

// Recursive backtracking. `start` is the index of the first
// candidate we're allowed to use (avoids emitting permutations of
// the same combination). `path` is the current partial combination
// (a fresh copy at each level). `out` is the accumulator.
fn backtrack(cands: [int], target: int, start: int, path: [int], out: [int]) -> int {
  if target == 0 {
    // Emit this combination: prefix with the size.
    push(out, len(path));
    let mut k = 0;
    while k < len(path) {
      push(out, path[k]);
      k = k + 1;
    }
    0
  } else {
    if target < 0 {
      0
    } else {
      let mut i = start;
      while i < len(cands) {
        let c = cands[i];
        let new_path = with_elem(path, c);
        backtrack(cands, target - c, i, new_path, out);
        i = i + 1;
      }
      0
    }
  }
}

// Solve combination sum. Returns a flat array of
// [size0, c0_0, c0_1, ..., size1, c1_0, ...].
fn combination_sum(cands: [int], target: int) -> [int] {
  let mut out = [];
  let path = [];
  backtrack(cands, target, 0, path, out);
  out
}

// Render the flat output as [[2, 2, 3], [7]].
fn show(flat: [int]) -> string {
  let mut out = "[";
  let mut i = 0;
  let mut first = 1;
  while i < len(flat) {
    if first == 1 {
      first = 0;
    } else {
      out = out + ", ";
    };
    let size = flat[i];
    out = out + "[";
    let mut k = 0;
    while k < size {
      if k > 0 {
        out = out + ", ";
      };
      out = out + str(flat[i + 1 + k]);
      k = k + 1;
    }
    out = out + "]";
    i = i + 1 + size;
  }
  out + "]"
}

print("== Combination sum ==");
print("");

let cases = [
  ([2, 3, 6, 7], 7),
  ([2, 3, 5], 8),
  ([2], 1),
  ([1], 3),
  ([7, 3, 2], 7)
];
let mut k = 0;
while k < len(cases) {
  let entry = cases[k];
  let cands = entry.0;
  let target = entry.1;
  let result = combination_sum(cands, target);
  // Render the candidates too.
  let cands_str = reduce(cands, fn(acc: string, x: int) -> string {
    if acc == "" { str(x) } else { acc + ", " + str(x) }
  }, "");
  print("  cands=[" + cands_str + "], target=" + str(target) + "  ->  " + show(result));
  k = k + 1;
}
print("");

// Headline.
let r = combination_sum([2, 3, 6, 7], 7);
print("Headline: combination_sum([2,3,6,7], 7) = " + show(r));
print("");

// Sanity assertions.
assert_eq(combination_sum([2, 3, 6, 7], 7), [3, 2, 2, 3, 1, 7]);
assert_eq(combination_sum([2, 3, 5], 8), [4, 2, 2, 2, 2, 3, 2, 3, 3, 2, 3, 5]);
assert_eq(combination_sum([2], 1), []);
assert_eq(combination_sum([1], 3), [3, 1, 1, 1]);
assert_eq(combination_sum([7, 3, 2], 7), [1, 7, 3, 3, 2, 2]);

// Count check: total elements should be sum of (1 + size) for each combo.
// For cands=[2,3,6,7], target=7: 2 combos of sizes 3 and 1 -> flat length = (1+3) + (1+1) = 6.
assert_eq(len(combination_sum([2, 3, 6, 7], 7)), 6);
print("All assertions passed.");
