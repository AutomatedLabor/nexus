// shortest_common_superseq.ae
// ===========================
// Shortest Common Supersequence (SCS) of two strings. The SCS is
// the shortest string that contains both `s1` and `s2` as
// subsequences. We compute it via DP using the relation:
//   scs_len(i, j) = m + n - lcs_len(i, j)
// and we reconstruct the actual string by walking back through
// the DP table, choosing characters from either string when they
// differ.

fn make2d(rows: int, cols: int, init: int) -> [[int]] {
  let mut out = [];
  let mut i = 0;
  while i < rows {
    let mut row = [];
    let mut j = 0;
    while j < cols { push(row, init); j = j + 1; }
    push(out, row);
    i = i + 1;
  }
  out
}

fn lcs_table(s1: string, s2: string) -> [[int]] {
  let m = len(s1);
  let n = len(s2);
  let mut dp = make2d(m + 1, n + 1, 0);
  let mut a = 1;
  while a <= m {
    let mut b = 1;
    while b <= n {
      if charCode(s1, a - 1) == charCode(s2, b - 1) {
        dp[a][b] = dp[a - 1][b - 1] + 1;
      } else {
        let u = dp[a - 1][b];
        let l = dp[a][b - 1];
        dp[a][b] = if u > l { u } else { l };
      };
      b = b + 1;
    }
    a = a + 1;
  }
  dp
}

fn scs_reconstruct(s1: string, s2: string) -> string {
  let dp = lcs_table(s1, s2);
  let mut out = "";
  let mut i = len(s1);
  let mut j = len(s2);
  let mut safety = 0;
  while (i > 0 || j > 0) && (safety < 10000) {
    if i > 0 && j > 0 {
      if charCode(s1, i - 1) == charCode(s2, j - 1) {
        out = s1[i - 1] + out;
        i = i - 1;
        j = j - 1;
      } else {
        if dp[i - 1][j] > dp[i][j - 1] {
          out = s1[i - 1] + out;
          i = i - 1;
        } else {
          out = s2[j - 1] + out;
          j = j - 1;
        };
      };
    } else {
      if i > 0 {
        out = s1[i - 1] + out;
        i = i - 1;
      } else {
        out = s2[j - 1] + out;
        j = j - 1;
      };
    };
    safety = safety + 1;
  }
  out
}

print("== Shortest Common Supersequence ==");
print("");

let pairs = [
  ("abac", "cab"),
  ("AGGTAB", "GXTXAYB"),
  ("abc", "abc"),
  ("abc", "xyz"),
  ("", "abc")
];
let mut p = 0;
while p < len(pairs) {
  let pair = pairs[p];
  let s1 = pair.0;
  let s2 = pair.1;
  let dp = lcs_table(s1, s2);
  let lcs_len = dp[len(s1)][len(s2)];
  let scs_len = len(s1) + len(s2) - lcs_len;
  let scs = scs_reconstruct(s1, s2);
  print(f"  \"{s1}\" + \"{s2}\": SCS = \"{scs}\"  (length {scs_len})");
  p = p + 1;
}
print("");

// Sanity assertions.
assert_eq(len(scs_reconstruct("abac", "cab")), 5);
assert_eq(len(scs_reconstruct("AGGTAB", "GXTXAYB")), 9);
assert_eq(scs_reconstruct("abc", "abc"), "abc");
assert_eq(len(scs_reconstruct("abc", "xyz")), 6);
assert_eq(scs_reconstruct("", "abc"), "abc");
print("All assertions passed.");
