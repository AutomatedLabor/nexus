// bst_demo2.ae
// =============
// Iterative binary search tree — same insert order (7, 3, 9, 1, 5,
// 8, 10) as the recursive `bst_demo.ae`, but with a struct-based
// node representation and an explicit-stack in-order traversal
// rather than recursion.
//
// The point of this variant is to show the iterative in-order
// traversal pattern: push left-spine, visit, push right, repeat.
// No recursion, no enum — just structs, indices, and a stack.
// Useful when the tree is deep enough that recursion would blow
// the evaluator's depth limit (the v1 evaluator caps call depth).
//
// All iteration uses `while` (no for-loops) to avoid the v1
// evaluator's for-loop-scope quirk. Every `if` / `if/else` block
// used as a STATEMENT is followed by `;` (the v1 parser is strict
// about this; only the LAST expression of a function body may
// omit the trailing `;`).

struct Node {
  key: int,
  left: any,    // index into the node array, or -1 for none
  right: any,   // index into the node array, or -1 for none
}

// Build a single node with no children.
fn mk(key: int) -> Node {
  Node { key: key, left: -1, right: -1 }
}

// Insert a key into a tree rooted at `root_idx` in the `nodes`
// array. Returns the new root index (same as `root_idx` unless
// the tree was empty). Mutates `nodes` by appending new nodes.
fn insert(nodes: [Node], root_idx: int, key: int) -> int {
  if root_idx < 0 {
    push(nodes, mk(key));
    len(nodes) - 1
  } else {
    let mut cur = root_idx;
    let mut cont = 1;
    while cont == 1 {
      if key < nodes[cur].key {
        if nodes[cur].left < 0 {
          push(nodes, mk(key));
          nodes[cur].left = len(nodes) - 1;
          cont = 0;
        } else {
          cur = nodes[cur].left;
        };
      } else {
        if nodes[cur].right < 0 {
          push(nodes, mk(key));
          nodes[cur].right = len(nodes) - 1;
          cont = 0;
        } else {
          cur = nodes[cur].right;
        };
      };
    }
    root_idx
  }
}

// Iterative in-order traversal: visit left, root, right. Uses an
// explicit stack of node indices.
fn in_order(nodes: [Node], root_idx: int) -> [int] {
  let mut out = [];
  let mut stack = [];
  let mut cur = root_idx;
  let mut cont = 1;
  while cont == 1 {
    if cur >= 0 {
      push(stack, cur);
      cur = nodes[cur].left;
    } else {
      if len(stack) > 0 {
        let top = stack[len(stack) - 1];
        let mut rest = [];
        let mut k = 0;
        while k < len(stack) - 1 {
          push(rest, stack[k]);
          k = k + 1;
        }
        stack = rest;
        push(out, nodes[top].key);
        cur = nodes[top].right;
      } else {
        cont = 0;
      };
    };
  }
  out
}

// Iterative pre-order traversal: visit root, left, right.
fn pre_order(nodes: [Node], root_idx: int) -> [int] {
  let mut out = [];
  let mut stack = [];
  if root_idx >= 0 {
    push(stack, root_idx);
  };
  while len(stack) > 0 {
    let top = stack[len(stack) - 1];
    let mut rest = [];
    let mut k = 0;
    while k < len(stack) - 1 {
      push(rest, stack[k]);
      k = k + 1;
    }
    stack = rest;
    push(out, nodes[top].key);
    if nodes[top].right >= 0 {
      push(stack, nodes[top].right);
    };
    if nodes[top].left >= 0 {
      push(stack, nodes[top].left);
    };
  }
  out
}

// Iterative membership test.
fn search(nodes: [Node], root_idx: int, key: int) -> bool {
  let mut cur = root_idx;
  let mut found = false;
  let mut cont = 1;
  while cont == 1 {
    if cur < 0 {
      cont = 0;
    } else {
      if key == nodes[cur].key {
        found = true;
        cont = 0;
      } else {
        if key < nodes[cur].key {
          cur = nodes[cur].left;
        } else {
          cur = nodes[cur].right;
        };
      };
    };
  }
  found
}

// Iterative depth (max root-to-leaf path length, in nodes).
fn depth(nodes: [Node], root_idx: int) -> int {
  let mut max_d = 0;
  let mut stack = [];
  if root_idx >= 0 {
    push(stack, [root_idx, 1]);
  };
  while len(stack) > 0 {
    let top = stack[len(stack) - 1];
    let mut rest = [];
    let mut k = 0;
    while k < len(stack) - 1 {
      push(rest, stack[k]);
      k = k + 1;
    }
    stack = rest;
    let v = top[0];
    let d = top[1];
    if d > max_d {
      max_d = d;
    };
    if nodes[v].left >= 0 {
      push(stack, [nodes[v].left, d + 1]);
    };
    if nodes[v].right >= 0 {
      push(stack, [nodes[v].right, d + 1]);
    };
  }
  max_d
}

fn show_ints(arr: [int]) -> string {
  let body = reduce(arr, fn(acc: string, x: int) -> string {
    if acc == "" { str(x) } else { acc + ", " + str(x) }
  }, "");
  "[" + body + "]"
}

print("== Iterative BST (struct + explicit stack) ==");
print("");

let vals = [7, 3, 9, 1, 5, 8, 10];
print(f"insert order: {show_ints(vals)}");

let nodes = [];
let mut root = -1;
let mut i = 0;
while i < len(vals) {
  root = insert(nodes, root, vals[i]);
  i = i + 1;
}

print(f"node count:   {len(nodes)}");
print(f"pre-order:    {show_ints(pre_order(nodes, root))}");
print(f"in-order:     {show_ints(in_order(nodes, root))}  (sorted)");
print(f"depth:        {depth(nodes, root)}");
print("");

// Membership tests.
print("membership tests:");
let hits = [7, 1, 5, 10];
let misses = [0, 4, 11, 99];
let mut j = 0;
while j < len(hits) {
  print(f"  search({hits[j]}) = {search(nodes, root, hits[j])}");
  j = j + 1;
}
j = 0;
while j < len(misses) {
  print(f"  search({misses[j]}) = {search(nodes, root, misses[j])}");
  j = j + 1;
}
print("");

// Sanity assertions — same answers as the recursive variant.
assert_eq(in_order(nodes, root), [1, 3, 5, 7, 8, 9, 10]);
assert_eq(pre_order(nodes, root), [7, 3, 1, 5, 9, 8, 10]);
assert_eq(search(nodes, root, 5), true);
assert_eq(search(nodes, root, 6), false);
assert_eq(depth(nodes, root), 3);

// Empty tree: in-order is [], depth is 0.
let empty_nodes = [];
assert_eq(in_order(empty_nodes, -1), []);
assert_eq(depth(empty_nodes, -1), 0);

print("All assertions passed.");
