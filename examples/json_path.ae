// json_path.ae
// =============
// A tiny JSONPath evaluator.  Given a "JSON-like" data structure
// (represented as nested parallel arrays — keys and values are
// kept in parallel arrays to mimic objects — and arrays of such
// "objects"), evaluate a path like $.store.book[0].title and
// print the matched value.
//
// The data model:
//   - An "object" is a 2-tuple: ["obj", [[key, value], ...]].
//   - An "array"  is a 2-tuple: ["arr", [v, v, ...]].
//   - A "string"  is a 2-tuple: ["str", "text"].
//   - An "int"   is a 2-tuple: ["int", 42].
//
// The path syntax (very small subset):
//   - "$"           — the root.
//   - ".name"       — descend into an object's "name" field.
//   - "[i]"         — index into an array.
// Anywhere we can't descend, we print "(no match)".

// Build an object from a list of (key, value) pairs.
fn obj(entries: [[any]]) -> [any] {
  ["obj", entries]
}

// Build an array from a list of values.
fn arr(values: [any]) -> [any] {
  ["arr", values]
}

fn str_v(s: string) -> [any] {
  ["str", s]
}

fn int_v(n: int) -> [any] {
  ["int", n]
}

// Look up a key in an object's entries list.
fn obj_get(o: [any], key: string) -> any {
  let entries = o[1];
  let mut i = 0;
  let mut found: any = ();
  let mut ok = false;
  while (i < len(entries)) && (!ok) {
    let e = entries[i];
    if e[0] == key {
      found = e[1];
      ok = true;
    };
    i = i + 1;
  }
  if ok { found } else { () }
}

// Get the i-th element of an array value.
fn arr_get(a: [any], i: int) -> any {
  let vs = a[1];
  if i >= 0 && i < len(vs) {
    vs[i]
  } else {
    ()
  }
}

// Render a value as a string (for printing).
fn render(v: any) -> string {
  if type_of(v) == "array" {
    let tag = v[0];
    if tag == "str" {
      "\"" + str(v[1]) + "\""
    } else {
      if tag == "int" {
        str(v[1])
      } else {
        if tag == "obj" {
          let mut s = "{";
          let entries = v[1];
          let mut i = 0;
          while i < len(entries) {
            let e = entries[i];
            s = s + "\"" + str(e[0]) + "\": " + render(e[1]);
            if i + 1 < len(entries) { s = s + ", " };
            i = i + 1;
          }
          s = s + "}"
        } else {
          if tag == "arr" {
            let mut s = "[";
            let vs = v[1];
            let mut i = 0;
            while i < len(vs) {
              s = s + render(vs[i]);
              if i + 1 < len(vs) { s = s + ", " };
              i = i + 1;
            }
            s = s + "]"
          } else {
            "<unknown>"
          }
        }
      }
    }
  } else {
    str(v)
  }
}

// Parse a path like "$.store.book[0].title" into a list of steps:
//   ["root"], ["key", "store"], ["key", "book"], ["index", 0],
//   ["key", "title"]
fn parse_path(p: string) -> [[any]] {
  let steps = [];
  let mut i = 0;
  let n = len(p);
  // Expect a leading "$".
  if i < n && strSlice(p, i, i + 1) == "$" {
    push(steps, ["root"]);
    i = i + 1;
  };
  while i < n {
    let c = strSlice(p, i, i + 1);
    if c == "." {
      // Read the next identifier.
      i = i + 1;
      let mut j = i;
      let mut done = false;
      while (j < n) && (!done) {
        let cj = strSlice(p, j, j + 1);
        if cj == "." || cj == "[" {
          done = true;
        } else {
          j = j + 1;
        };
      };
      let name = strSlice(p, i, j);
      push(steps, ["key", name]);
      i = j;
    } else {
      if c == "[" {
        // Read until "]".
        let mut j = i + 1;
        let mut done = false;
        while (j < n) && (!done) {
          if strSlice(p, j, j + 1) == "]" {
            done = true;
          } else {
            j = j + 1;
          };
        };
        let idx_str = strSlice(p, i + 1, j);
        let idx = int(idx_str);
        push(steps, ["index", idx]);
        i = j + 1;
      } else {
        i = i + 1;
      }
    }
  }
  steps
}

// Evaluate a parsed path against a root value.
fn eval_path(root: [any], steps: [[any]]) -> any {
  let mut cur: any = root;
  let mut i = 0;
  while i < len(steps) {
    let s = steps[i];
    if s[0] == "root" {
      cur = root;
    } else {
      if s[0] == "key" {
        if type_of(cur) == "array" && cur[0] == "obj" {
          cur = obj_get(cur, s[1]);
        } else {
          return ();
        }
      } else {
        if s[0] == "index" {
          if type_of(cur) == "array" && cur[0] == "arr" {
            cur = arr_get(cur, s[1]);
          } else {
            return ();
          }
        }
      }
    };
    i = i + 1;
  }
  cur
}

// --- The hardcoded "JSON-like" data ---

let book1 = obj([
  ["category", str_v("reference")],
  ["author", str_v("Nigel Rees")],
  ["title", str_v("Sayings of the Century")],
  ["price", int_v(895)],
]);

let book2 = obj([
  ["category", str_v("fiction")],
  ["author", str_v("Evelyn Waugh")],
  ["title", str_v("Sword of Honour")],
  ["price", int_v(1299)],
]);

let store = obj([
  ["book", arr([book1, book2])],
  ["bicycle", obj([
    ["color", str_v("red")],
    ["price", int_v(1999)],
  ])],
]);

let root = obj([
  ["store", store],
]);

print("== Tiny JSONPath evaluator ==");
print("");

let path = "$.store.book[0].title";
print("path: " + str(path));
let steps = parse_path(path);
print("parsed steps: " + str(steps));
let v = eval_path(root, steps);
print("value: " + render(v));
print("");

let path2 = "$.store.book[1].author";
print("path: " + str(path2));
let v2 = eval_path(root, parse_path(path2));
print("value: " + render(v2));
print("");

let path3 = "$.store.bicycle.color";
print("path: " + str(path3));
let v3 = eval_path(root, parse_path(path3));
print("value: " + render(v3));
print("");

let path4 = "$.store.book[0].price";
print("path: " + str(path4));
let v4 = eval_path(root, parse_path(path4));
print("value: " + render(v4));
print("");

// Missing path returns ().
let path5 = "$.store.book[5].title";
let v5 = eval_path(root, parse_path(path5));
print("missing path: " + str(v5));

// Sanity assertions.
assert_eq(render(v), "\"Sayings of the Century\"");
assert_eq(render(v2), "\"Evelyn Waugh\"");
assert_eq(render(v3), "\"red\"");
assert_eq(render(v4), "895");
print("");
print("All assertions passed.");
