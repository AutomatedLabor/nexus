// lru_cache_demo2.ae
// ==================
// A simple LRU (Least Recently Used) cache.  This demo runs 20
// operations (put + get) on a 5-capacity cache and prints the
// cache state after each operation.  When a new item is added
// beyond capacity, the least-recently-used entry is evicted; we
// record each eviction and print it.
//
// The cache is a 3-tuple (cap, keys, vals) where `keys` and `vals`
// are parallel arrays ordered from LRU (index 0) to MRU (end).
// We use arrays rather than a doubly-linked-list+hash-map (the
// textbook O(1) LRU) because the code is much shorter, and for a
// 5-capacity cache, O(n) get/put is fine.

// Find the index of `key` in `arr`, or -1 if absent.
fn index_of(arr: [int], key: int) -> int {
  let mut i = 0;
  let mut found = -1;
  while i < len(arr) {
    if arr[i] == key { found = i };
    i = i + 1;
  }
  found
}

// Move the entry at index `i` to the end of both parallel arrays.
// Returns (new_keys, new_vals).
fn move_to_end(keys: [int], vals: [int], i: int) -> ([int], [int]) {
  let k = keys[i];
  let v = vals[i];
  let mut new_keys = [];
  let mut new_vals = [];
  let mut j = 0;
  while j < len(keys) {
    if j != i {
      push(new_keys, keys[j]);
      push(new_vals, vals[j]);
    };
    j = j + 1;
  }
  push(new_keys, k);
  push(new_vals, v);
  (new_keys, new_vals)
}

// Create a fresh cache with capacity `cap`.
fn lru_new(cap: int) -> (int, [int], [int]) {
  (cap, [], [])
}

// Get a value by key. Returns (value, new_cache) on hit (and marks
// the entry MRU), or (-9999, cache) on miss.
fn lru_get(cache: (int, [int], [int]), key: int) -> (int, (int, [int], [int])) {
  let cap = cache.0;
  let keys = cache.1;
  let vals = cache.2;
  let i = index_of(keys, key);
  if i == -1 {
    (-9999, cache)
  } else {
    let moved = move_to_end(keys, vals, i);
    let new_keys = moved.0;
    let new_vals = moved.1;
    (new_vals[len(new_vals) - 1], (cap, new_keys, new_vals))
  }
}

// Put (key, v) into the cache. Returns (new_cache, evicted_key_or_-1).
// If the key exists, update the value and mark MRU (no eviction).
// If new, append; if at capacity, evict the LRU (index 0) first.
fn lru_put(cache: (int, [int], [int]), key: int, v: int) -> ((int, [int], [int]), int) {
  let cap = cache.0;
  let keys = cache.1;
  let vals = cache.2;
  let i = index_of(keys, key);
  if i != -1 {
    // Update + move to end; no eviction.
    let moved = move_to_end(keys, vals, i);
    let mut new_keys = moved.0;
    let mut new_vals = moved.1;
    new_vals[len(new_vals) - 1] = v;
    ((cap, new_keys, new_vals), -1)
  } else {
    let mut new_keys = keys;
    let mut new_vals = vals;
    let mut evicted = -1;
    if len(new_keys) >= cap {
      evicted = new_keys[0];
      let mut trimmed_keys = [];
      let mut trimmed_vals = [];
      let mut j = 1;
      while j < len(new_keys) {
        push(trimmed_keys, new_keys[j]);
        push(trimmed_vals, new_vals[j]);
        j = j + 1;
      }
      new_keys = trimmed_keys;
      new_vals = trimmed_vals;
    };
    push(new_keys, key);
    push(new_vals, v);
    ((cap, new_keys, new_vals), evicted)
  }
}

// Render the cache state as "key=val | ..." (LRU on left, MRU on right).
fn show_cache(cache: (int, [int], [int])) -> string {
  let keys = cache.1;
  let vals = cache.2;
  let cap = cache.0;
  let mut out = "";
  let mut i = 0;
  while i < len(keys) {
    let s = if i == 0 { "" } else { " | " };
    out = out + s + str(keys[i]) + "=" + str(vals[i]);
    i = i + 1;
  }
  "[" + out + "] (cap=" + str(cap) + ", size=" + str(len(keys)) + ")"
}

print("== LRU cache demo (20 ops, capacity 5) ==");
print("");

let mut cache = lru_new(5);
print(f"new cache: {show_cache(cache)}");
print("");

// A scripted 20-op sequence: alternating put and get, with some
// updates to mark entries MRU.
let ops_put = [
  (1, 100),
  (2, 200),
  (3, 300),
  (4, 400),
  (5, 500),    // fills to capacity
  (6, 600),    // evicts 1
  (7, 700),    // evicts 2
  (3, 333),    // update 3, marks MRU
  (8, 800),    // evicts 4
  (9, 900),    // evicts 5
  (10, 1000),  // evicts 6
  (11, 1100),  // evicts 7
  (12, 1200),  // evicts 3
  (13, 1300),  // evicts 8
  (14, 1400),  // evicts 9
  (15, 1500),  // evicts 10
  (16, 1600),  // evicts 11
  (17, 1700),  // evicts 12
  (18, 1800),  // evicts 13
  (19, 1900)   // evicts 14
];
let mut i = 0;
let mut evictions = 0;
while i < len(ops_put) {
  let op = ops_put[i];
  let k = op.0;
  let v = op.1;
  let result = lru_put(cache, k, v);
  cache = result.0;
  let evicted = result.1;
  if evicted != -1 {
    evictions = evictions + 1;
    print(f"put({k}, {v}): evict {evicted}  ->  {show_cache(cache)}");
  } else {
    print(f"put({k}, {v}): no evict        ->  {show_cache(cache)}");
  };
  i = i + 1;
}
print("");

print(f"total evictions: {evictions}");
print(f"final cache: {show_cache(cache)}");
print("");

// Now do 2 gets on items still in the cache + 1 get on an evicted item.
print("probes:");
let probe_keys = [15, 19, 1];   // 15 and 19 are in cache; 1 was evicted early
let mut p = 0;
while p < len(probe_keys) {
  let k = probe_keys[p];
  let r = lru_get(cache, k);
  let v = r.0;
  cache = r.1;
  let label = if v == -9999 { "MISS" } else { "hit" };
  print(f"  get({k}) = {v}  ({label})  ->  {show_cache(cache)}");
  p = p + 1;
}
print("");

assert_eq(evictions, 14);
assert_eq(len(cache.1), 5);
assert_eq(cache.1[0], 16);    // LRU after probes
assert_eq(cache.1[1], 17);
assert_eq(cache.1[2], 18);
assert_eq(cache.1[3], 15);    // moved up by get(15)
assert_eq(cache.1[4], 19);    // MRU (most-recently get'd)
print("All assertions passed.");
