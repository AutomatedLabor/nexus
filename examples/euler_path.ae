// euler_path.ae
// =============
// Find an Euler path in a directed graph using Hierholzer's
// algorithm. An Euler path is one that traverses every edge
// exactly once. For a directed graph, an Euler path exists
// iff at most one vertex has out_deg - in_deg = 1, at most one
// vertex has in_deg - out_deg = 1, and every other vertex has
// in_deg == out_deg, and the underlying graph is connected on
// the edges (ignoring direction).
//
// We use the iterative form of Hierholzer with an explicit
// stack of nodes to "return to" once we hit a dead-end.
//
// Graph (5 nodes 0..4):
//   0 -> 1
//   1 -> 2, 1 -> 3
//   2 -> 4
//   3 -> 0, 3 -> 4
// (out_deg - in_deg):
//   0: 1 - 1 = 0
//   1: 2 - 1 = 1   <- start node (Euler path starts here)
//   2: 1 - 1 = 0
//   3: 2 - 1 = 1   <- but two starts? need to re-check
//   4: 0 - 2 = -2  <- imbalance, so no Euler path.
//
// Let me recompute. Edges:
//   0 -> 1     out[0]++, in[1]++
//   1 -> 2     out[1]++, in[2]++
//   1 -> 3     out[1]++, in[3]++
//   2 -> 4     out[2]++, in[4]++
//   3 -> 0     out[3]++, in[0]++
//   3 -> 4     out[3]++, in[4]++
// out: 0=1, 1=2, 2=1, 3=2, 4=0
// in:  0=1, 1=1, 2=1, 3=1, 4=2
// diff: 0=0, 1=1, 2=0, 3=1, 4=-2 -> bad
//
// Let me redesign:
//   0 -> 1, 1 -> 2, 2 -> 0, 2 -> 3, 3 -> 1
// out: 0=1, 1=1, 2=2, 3=1
// in:  0=1, 1=2, 2=1, 3=1
// diff: 0=0, 1=-1, 2=1, 3=0
// So node 2 has +1, node 1 has -1. Euler path starts at 2 and ends at 1.
//   2 -> 3 -> 1 -> 0 -> 2... wait that uses 2->3, 3->1, then 1->0? but 1 doesn't go to 0.
// Let me pick edges carefully:
//   0 -> 1
//   1 -> 2
//   2 -> 0
//   2 -> 3
//   3 -> 1
// Possible Euler path: 2 -> 0 -> 1 -> 2 -> 3 -> 1
//   uses edges: 2->0, 0->1, 1->2, 2->3, 3->1. Yes all 5 edges.

fn repeat(n: int, v: int) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < n { push(out, v); i = i + 1; }
  out
}

// Hierholzer's algorithm: builds the path in reverse. We use
// adjacency lists with a "next" cursor per node so we can mutate
// which edges have been used (by skipping past them).
//
// Returns the Euler path as an int array, or [] if no path.

fn hierholzer(adj: [[int]], n: int, start: int) -> [int] {
  let mut cursor = repeat(n, 0);
  let mut stack  = [start];
  let mut path   = [];
  let mut safety = 0;
  let max_safety = 100000;
  while (len(stack) > 0) && (safety < max_safety) {
    let v = stack[len(stack) - 1];
    if cursor[v] < len(adj[v]) {
      // Take the next available edge from v.
      let w = adj[v][cursor[v]];
      cursor[v] = cursor[v] + 1;
      push(stack, w);
    } else {
      // No more edges from v: pop and prepend to path.
      let head_v = stack[len(stack) - 1];
      pop(stack);
      push(path, head_v);
    };
    safety = safety + 1;
  }
  // path is in reverse order; reverse it
  let mut out = [];
  let mut i = len(path) - 1;
  while i >= 0 {
    push(out, path[i]);
    i = i - 1;
  }
  out
}

fn show(arr: [int]) -> string {
  let mut s = "";
  let mut i = 0;
  while i < len(arr) {
    if i > 0 {
      s = s + " -> ";
    };
    s = s + str(arr[i]);
    i = i + 1;
  }
  s
}

print("== Euler path (Hierholzer) ==");
print("");

let adj = [
  [1],       // 0
  [2],       // 1
  [0, 3],    // 2
  [1],       // 3
];
let n = 4;
let start = 2;  // out-in = +1, so start here

print("graph (adjacency list):");
let mut i = 0;
while i < n {
  print(f"  {i}: {adj[i]}");
  i = i + 1;
}
print("");

let path = hierholzer(adj, n, start);
print(f"Euler path from {start}: {show(path)}");
print(f"length: {len(path) - 1} edges");
print("");

// Sanity assertions.
assert_eq(len(path), 6);   // 5 edges + 1 node
assert_eq(path[0], 2);     // start
assert_eq(path[5], 1);    // ends at the in-only node
print("All assertions passed.");
