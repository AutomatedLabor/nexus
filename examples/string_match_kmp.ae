// string_match_kmp.ae
// =====================
// KMP (Knuth–Morris–Pratt) string matching. We precompute the LPS
// (longest-proper-prefix-which-is-also-suffix) table for the pattern
// and then scan the text in a single pass, using the table to skip
// ahead on mismatches. We print every starting index at which the
// pattern occurs in the text.

// Build the LPS table for `pattern`. lps[i] is the length of the
// longest proper prefix of pattern[0..=i] that is also a suffix of
// pattern[0..=i].
fn build_lps(pattern: string) -> [int] {
  let m = len(pattern);
  let mut lps = [];
  let mut i = 0;
  while i < m { push(lps, 0); i = i + 1; }
  let mut length = 0;  // length of the previous longest prefix-suffix
  let mut i = 1;
  while i < m {
    if charAt(pattern, i) == charAt(pattern, length) {
      length = length + 1;
      lps[i] = length;
      i = i + 1;
    } else {
      if length != 0 {
        length = lps[length - 1];
      } else {
        lps[i] = 0;
        i = i + 1;
      };
    }
  }
  lps
}

// Return the single-character string at index `i` of `s`.
fn charAt(s: string, i: int) -> string {
  str(s[i])
}

// KMP search. Returns the list of starting indices in `text` where
// `pattern` occurs.
fn kmp(text: string, pattern: string) -> [int] {
  let n = len(text);
  let m = len(pattern);
  let mut out = [];
  if m == 0 { return out };
  let lps = build_lps(pattern);
  let mut i = 0;  // index into text
  let mut j = 0;  // index into pattern
  while i < n {
    if charAt(text, i) == charAt(pattern, j) {
      i = i + 1;
      j = j + 1;
    };
    if j == m {
      push(out, i - j);
      j = lps[j - 1];
    } else {
      if i < n && (charAt(text, i) != charAt(pattern, j)) {
        if j != 0 {
          j = lps[j - 1];
        } else {
          i = i + 1;
        };
      };
    }
  }
  out
}

// Render an int array as a comma-separated "[a, b, c]" string.
fn show(arr: [int]) -> string {
  let mut out = "[";
  let mut i = 0;
  while i < len(arr) {
    if i > 0 { out = out + ", " };
    out = out + str(arr[i]);
    i = i + 1;
  }
  out + "]"
}

print("== KMP string matching ==");
print("");

let cases = [
  ("abcabcabcababc", "abc"),
  ("aaaaaaa", "aaa"),
  ("hello world", "o"),
  ("the quick brown fox", "quick"),
  ("aaaaaaaaaa", "xyz"),
  ("mississippi", "issi"),
  ("abababab", "abab")
];
let mut i = 0;
while i < len(cases) {
  let c = cases[i];
  let text = c.0;
  let pattern = c.1;
  let matches = kmp(text, pattern);
  let lps = build_lps(pattern);
  print(f"  text:    {text}");
  print(f"  pattern: {pattern}");
  print(f"  lps:     {show(lps)}");
  print(f"  matches: {show(matches)}");
  print("");
  i = i + 1;
}

// Sanity assertions.
assert_eq(kmp("abcabcabcababc", "abc"), [0, 3, 6, 11]);
assert_eq(kmp("aaaaaaa", "aaa"), [0, 1, 2, 3, 4]);
assert_eq(kmp("hello world", "o"), [4, 7]);
assert_eq(kmp("aaaaaaaaaa", "xyz"), []);
assert_eq(kmp("mississippi", "issi"), [1, 4]);
assert_eq(kmp("abababab", "abab"), [0, 2, 4]);
assert_eq(build_lps("aaa"), [0, 1, 2]);
assert_eq(build_lps("abc"), [0, 0, 0]);
assert_eq(build_lps("abab"), [0, 0, 1, 2]);
print("All assertions passed.");
