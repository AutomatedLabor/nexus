// max_depth_tree.ae
// =================
// Compute the maximum depth of a binary tree. The depth is the
// number of nodes on the longest path from the root to a leaf.
//
//   Tree:       1            -> depth 3
//              / \
//             2   3
//            /
//           4
//
// Tree type: a recursive enum with `Node(value, left, right)` and
// `Leaf` (empty tree). We use pure-functional recursion — the
// tree is immutable.

enum Tree {
  Node(int, Tree, Tree),
  Leaf,
}

// Max depth of a tree. A leaf has depth 0; a node has depth
// 1 + max(depth(left), depth(right)).
fn max_depth(t: Tree) -> int {
  match t {
    Tree::Leaf => 0,
    Tree::Node(_, l, r) => {
      let dl = max_depth(l);
      let dr = max_depth(r);
      if dl > dr {
        1 + dl
      } else {
        1 + dr
      }
    },
  }
}

// Build a tree from a level-order list of values, where -1 means
// "no node here" (a sentinel). This lets us construct trees
// compactly from a flat array. We use a recursive helper that
// reads from index `i` and returns (tree, next_index).
fn build(arr: [int], i: int) -> (Tree, int) {
  if i >= len(arr) {
    (Tree::Leaf, i)
  } else {
    if arr[i] == -1 {
      (Tree::Leaf, i + 1)
    } else {
      let l_pair = build(arr, i + 1);
      let l = l_pair.0;
      let after_l = l_pair.1;
      let r_pair = build(arr, after_l);
      let r = r_pair.0;
      let after_r = r_pair.1;
      (Tree::Node(arr[i], l, r), after_r)
    }
  }
}

// Wrapper around `build` to ignore the next-index.
fn from_level_order(arr: [int]) -> Tree {
  let p = build(arr, 0);
  p.0
}

print("== Max depth of binary tree ==");
print("");

// Tree:     1
//          / \
//         2   3
//        /
//       4
let t1 = from_level_order([1, 2, 4, -1, -1, -1, 3, -1, -1]);
print("Tree 1: depth = " + str(max_depth(t1)));

// Tree:     1
//          / \
//         2   3
//            /
//           4
//          /
//         5
let t2 = from_level_order([1, 2, -1, -1, 3, 4, 5, -1, -1, -1, -1]);
print("Tree 2: depth = " + str(max_depth(t2)));

// Empty tree.
let t3 = Tree::Leaf;
print("Empty: depth = " + str(max_depth(t3)));

// Single node.
let t4 = Tree::Node(42, Tree::Leaf, Tree::Leaf);
print("Single: depth = " + str(max_depth(t4)));

// Linear left chain of 5 nodes.
let t5 = from_level_order([1, 2, 3, 4, 5, -1, -1, -1, -1, -1, -1]);
print("Left chain of 5: depth = " + str(max_depth(t5)));
print("");

// Headline.
print("Headline: max_depth(t1) = " + str(max_depth(t1)));
print("");

// Sanity assertions.
assert_eq(max_depth(Tree::Leaf), 0);
assert_eq(max_depth(Tree::Node(42, Tree::Leaf, Tree::Leaf)), 1);
assert_eq(max_depth(t1), 3);
assert_eq(max_depth(t2), 4);
assert_eq(max_depth(t3), 0);
assert_eq(max_depth(t4), 1);
assert_eq(max_depth(t5), 5);

// A balanced tree of depth 4 (15 nodes):
//              1
//           /     \
//          2       3
//         / \     / \
//        4   5   6   7
//       /\ /\ /\ /\
//      8 9 ... (8 leaves)
let balanced = from_level_order([1, 2, 4, 8, -1, -1, 9, -1, -1, 5, -1, -1, 3, 6, -1, -1, 7, -1, -1]);
assert_eq(max_depth(balanced), 4);

print("All assertions passed.");
