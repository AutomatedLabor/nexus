// bst_demo.ae
// ===========
// A binary search tree demo. Insert the keys 7, 3, 9, 1, 5, 8, 10;
// in-order traverse to print them in sorted order; run membership
// tests.
//
// The tree is a recursive enum:
//
//   enum Tree {
//     Node(int, Tree, Tree),   // key, left, right
//     Leaf,                    // empty
//   }
//
// All iteration uses `while` with explicit indices or recursion /
// `reduce` to avoid the v1 evaluator's for-loop-scope quirk where
// a `let` bound before a `for` and referenced after the loop can
// fail with "undefined name".

enum Tree {
  Node(int, Tree, Tree),
  Leaf,
}

// Insert a key into a tree, returning a new tree. Functional-persistent
// style: never mutates an existing node — builds a new branch on the
// path from root to the inserted leaf. Duplicate keys go right.
fn insert(t: Tree, k: int) -> Tree {
  match t {
    Tree::Leaf => Tree::Node(k, Tree::Leaf, Tree::Leaf),
    Tree::Node(key, l, r) => {
      if k < key {
        Tree::Node(key, insert(l, k), r)
      } else {
        Tree::Node(key, l, insert(r, k))
      }
    },
  }
}

// In-order traversal: left subtree, root, right subtree.
// Returns the sorted int array.
fn in_order(t: Tree) -> [int] {
  match t {
    Tree::Leaf => [],
    Tree::Node(k, l, r) => in_order(l) + [k] + in_order(r),
  }
}

// Pre-order: root, left, right.
fn pre_order(t: Tree) -> [int] {
  match t {
    Tree::Leaf => [],
    Tree::Node(k, l, r) => [k] + pre_order(l) + pre_order(r),
  }
}

// Membership test.
fn search(t: Tree, k: int) -> bool {
  match t {
    Tree::Leaf => false,
    Tree::Node(key, l, r) => {
      if k == key {
        true
      } else {
        if k < key { search(l, k) } else { search(r, k) }
      }
    },
  }
}

// Tree depth (number of nodes on the longest root-to-leaf path).
fn depth(t: Tree) -> int {
  match t {
    Tree::Leaf => 0,
    Tree::Node(_, l, r) => {
      let dl = depth(l);
      let dr = depth(r);
      1 + (if dl >= dr { dl } else { dr })
    },
  }
}

// Build a tree from an array by inserting each element in turn.
// Recursive helper with an index sidesteps the for-loop-scope quirk.
fn build_from(vals: [int]) -> Tree {
  fn helper(i: int, acc: Tree) -> Tree {
    if i >= len(vals) {
      acc
    } else {
      helper(i + 1, insert(acc, vals[i]))
    }
  }
  helper(0, Tree::Leaf)
}

// Render an int array as "[1, 2, 3]".
fn show_ints(arr: [int]) -> string {
  let body = reduce(arr, fn(acc: string, x: int) -> string {
    if acc == "" { str(x) } else { acc + ", " + str(x) }
  }, "");
  "[" + body + "]"
}

print("== Binary search tree (enum-based) ==");
print("");

let vals = [7, 3, 9, 1, 5, 8, 10];
print(f"insert order:  {show_ints(vals)}");

let tree = build_from(vals);
print(f"pre-order:      {show_ints(pre_order(tree))}");
print(f"in-order:       {show_ints(in_order(tree))}  (sorted)");
print(f"depth:          {depth(tree)}");
print("");

// Membership tests: 4 hits, 4 misses.
print("membership tests:");
let hits = [7, 1, 5, 10];
let misses = [0, 4, 11, 99];
let mut i = 0;
while i < len(hits) {
  print(f"  search({hits[i]}) = {search(tree, hits[i])}");
  i = i + 1;
}
i = 0;
while i < len(misses) {
  print(f"  search({misses[i]}) = {search(tree, misses[i])}");
  i = i + 1;
}
print("");

// Build a degenerate "all-in-order" tree from [1, 2, 3, 4, 5] —
// worst case O(n) shape: every insert goes to the right.
let sorted = [1, 2, 3, 4, 5];
let degenerate = build_from(sorted);
print(f"sorted input:   {show_ints(sorted)}");
print(f"degenerate in-order: {show_ints(in_order(degenerate))}");
print(f"degenerate depth:    {depth(degenerate)}  (worst-case = n)");
print("");

// Sanity assertions.
assert_eq(in_order(tree), [1, 3, 5, 7, 8, 9, 10]);
assert_eq(pre_order(tree), [7, 3, 1, 5, 9, 8, 10]);
assert_eq(search(tree, 5), true);
assert_eq(search(tree, 6), false);
assert_eq(depth(tree), 3);
assert_eq(depth(build_from([])), 0);
print("All assertions passed.");
