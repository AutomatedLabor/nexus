// topo_sort_kahn.ae
// =================
// Topological sort via Kahn's algorithm. We compute the in-degree
// of each node, then repeatedly emit zero-in-degree nodes and
// decrement the in-degrees of their successors. If we run out of
// zero-in-degree nodes before emitting all nodes, the graph has a
// cycle.
//
// Graph (8 nodes 0..7), course prerequisites:
//   0 -> 1, 0 -> 2
//   1 -> 3
//   2 -> 3, 2 -> 4
//   3 -> 5
//   4 -> 5
//   5 -> 6
//   6 -> 7
// Expected topological order: 0, 1, 2, 3, 4, 5, 6, 7.

fn repeat(n: int, v: int) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < n { push(out, v); i = i + 1; }
  out
}

fn topo_sort(adj: [[int]], n: int) -> [int] {
  let mut indeg = repeat(n, 0);
  let mut i = 0;
  while i < n {
    let mut j = 0;
    while j < len(adj[i]) {
      let v = adj[i][j];
      indeg[v] = indeg[v] + 1;
      j = j + 1;
    }
    i = i + 1;
  }
  let mut queue = [];
  let mut k = 0;
  while k < n {
    if indeg[k] == 0 {
      push(queue, k);
    };
    k = k + 1;
  }
  let mut order = [];
  let mut head = 0;
  while head < len(queue) {
    let u = queue[head];
    head = head + 1;
    push(order, u);
    let mut m = 0;
    while m < len(adj[u]) {
      let v = adj[u][m];
      indeg[v] = indeg[v] - 1;
      if indeg[v] == 0 {
        push(queue, v);
      };
      m = m + 1;
    }
  }
  if len(order) < n {
    return [];  // cycle detected
  };
  order
}

print("== Topological sort (Kahn) ==");
print("");

let adj = [
  [1, 2],
  [3],
  [3, 4],
  [5],
  [5],
  [6],
  [7],
  []
];
let n = 8;

print("graph (adjacency list):");
let mut i = 0;
while i < n {
  print(f"  {i}: {adj[i]}");
  i = i + 1;
}
print("");

let order = topo_sort(adj, n);
print(f"topological order: {order}");
print("");

// Sanity assertions.
assert_eq(order, [0, 1, 2, 3, 4, 5, 6, 7]);

// A graph with a cycle (1 -> 2 -> 3 -> 1).
let adj2 = [
  [1],
  [2],
  [3],
  [1]
];
let order2 = topo_sort(adj2, 4);
print(f"cyclic graph order: {order2}  (empty = cycle)");
assert_eq(order2, []);
print("All assertions passed.");
