// longest_common_subseq.ae
// =========================
// Longest Common Subsequence (LCS) of two strings via DP. We build
// a (m+1) x (n+1) table where dp[i][j] is the LCS length of s1[0..i]
// and s2[0..j]. We then reconstruct the actual subsequence by
// walking back from dp[m][n].
//
// We use `charCode(s, i)` to compare characters.

fn make2d(rows: int, cols: int, init: int) -> [[int]] {
  let mut out = [];
  let mut i = 0;
  while i < rows {
    let mut row = [];
    let mut j = 0;
    while j < cols { push(row, init); j = j + 1; }
    push(out, row);
    i = i + 1;
  }
  out
}

fn lcs_length(s1: string, s2: string) -> [[int]] {
  let m = len(s1);
  let n = len(s2);
  let mut dp = make2d(m + 1, n + 1, 0);
  let mut a = 1;
  while a <= m {
    let mut b = 1;
    while b <= n {
      let c1 = charCode(s1, a - 1);
      let c2 = charCode(s2, b - 1);
      if c1 == c2 {
        dp[a][b] = dp[a - 1][b - 1] + 1;
      } else {
        let u = dp[a - 1][b];
        let l = dp[a][b - 1];
        dp[a][b] = if u > l { u } else { l };
      };
      b = b + 1;
    }
    a = a + 1;
  }
  dp
}

fn lcs_reconstruct(dp: [[int]], s1: string, s2: string) -> string {
  let mut out = "";
  let mut i = len(s1);
  let mut j = len(s2);
  let mut safety = 0;
  while (i > 0) && (j > 0) && (safety < 10000) {
    let c1 = charCode(s1, i - 1);
    let c2 = charCode(s2, j - 1);
    if c1 == c2 {
      out = s1[i - 1] + out;
      i = i - 1;
      j = j - 1;
    } else {
      if dp[i - 1][j] > dp[i][j - 1] {
        i = i - 1;
      } else {
        j = j - 1;
      };
    };
    safety = safety + 1;
  }
  out
}

print("== Longest Common Subsequence ==");
print("");

let pairs = [
  ("ABCBDAB", "BDCAB"),
  ("AGGTAB", "GXTXAYB"),
  ("abc", "abc"),
  ("", "abc"),
  ("xyz", "abc")
];
let mut p = 0;
while p < len(pairs) {
  let pair = pairs[p];
  let s1 = pair.0;
  let s2 = pair.1;
  let dp = lcs_length(s1, s2);
  let l = dp[len(s1)][len(s2)];
  let subseq = lcs_reconstruct(dp, s1, s2);
  print(f"  \"{s1}\" / \"{s2}\": LCS = \"{subseq}\"  (length {l})");
  p = p + 1;
}
print("");

// Sanity assertions.
assert_eq(lcs_length("ABCBDAB", "BDCAB")[7][5], 4);
assert_eq(lcs_reconstruct(lcs_length("ABCBDAB", "BDCAB"), "ABCBDAB", "BDCAB"), "BDAB");
assert_eq(lcs_length("AGGTAB", "GXTXAYB")[6][7], 4);
assert_eq(lcs_length("abc", "abc")[3][3], 3);
assert_eq(lcs_length("", "abc")[0][3], 0);
assert_eq(lcs_length("xyz", "abc")[3][3], 0);
print("All assertions passed.");
