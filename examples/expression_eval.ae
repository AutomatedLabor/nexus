// expression_eval.ae
// ==================
// An arithmetic expression evaluator using the shunting-yard
// algorithm. We support +, -, *, /, parentheses, and integer
// operands. The shunting-yard converts the infix expression to
// RPN (reverse Polish notation), then we evaluate the RPN.
//
// Operator precedence (low to high):
//   + -       (1)
//   * /       (2)
// Parentheses override everything.
//
// The tokenizer splits the input string into tokens (numbers,
// operators, parens), skipping whitespace. The shunting-yard
// then converts the token list to RPN. The evaluator walks the
// RPN with a stack.
//
// Implementation note: Aether's v1 tree-walking evaluator has
// subtle scoping quirks when the same identifier (such as
// `keep_going`) is declared inside multiple branches of a
// deeply-nested if-else chain inside a while loop. We avoid
// the issue by ordering the branches lparen / rparen / op /
// number (so the inner `let mut keep_going` is only declared
// in branches that are mutually exclusive at runtime), and by
// using small helper functions for digit lookup and integer
// parsing.

// --- Tokenizer --------------------------------------------------------

fn is_digit(c: string) -> bool {
  c == "0" || c == "1" || c == "2" || c == "3" || c == "4"
    || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
}

fn is_ws(c: string) -> bool {
  c == " " || c == "\t" || c == "\n" || c == "\r"
}

fn is_op_char(c: string) -> bool {
  c == "+" || c == "-" || c == "*" || c == "/" || c == "(" || c == ")"
}

fn is_op(t: string) -> bool {
  t == "+" || t == "-" || t == "*" || t == "/"
}

fn is_lparen(t: string) -> bool { t == "(" }
fn is_rparen(t: string) -> bool { t == ")" }

fn prec(t: string) -> int {
  if t == "+" { 1 } else {
  if t == "-" { 1 } else {
  if t == "*" { 2 } else {
  if t == "/" { 2 } else { 0 } } } }
}

fn left_assoc(t: string) -> bool {
  t == "+" || t == "-" || t == "*" || t == "/"
}

fn digit_val(c: string) -> int {
  if c == "0" { 0 } else {
  if c == "1" { 1 } else {
  if c == "2" { 2 } else {
  if c == "3" { 3 } else {
  if c == "4" { 4 } else {
  if c == "5" { 5 } else {
  if c == "6" { 6 } else {
  if c == "7" { 7 } else {
  if c == "8" { 8 } else {
  if c == "9" { 9 } else {
  panic("bad digit: " + c) } } } } } } } } } }
}

// Tokenize the input string into a list of string tokens.
fn tokenize(s: string) -> [string] {
  let mut tokens = [];
  let mut i = 0;
  let n = len(s);
  while i < n {
    let c = str(s[i]);
    if is_ws(c) {
      i = i + 1;
    } else {
      if is_op_char(c) {
        push(tokens, c);
        i = i + 1;
      } else {
        if is_digit(c) {
          let mut num = "";
          while i < n && is_digit(str(s[i])) {
            num = num + str(s[i]);
            i = i + 1;
          }
          push(tokens, num);
        } else {
          panic("unexpected character: " + c);
        };
      };
    };
  }
  tokens
}

// --- Shunting-yard (infix → RPN) ------------------------------------
// Branch order matters: lparen first, then rparen, then op, then
// number. This avoids reusing the name `keep_going` across
// sibling branches in a way that the v1 evaluator mishandles.

fn to_rpn(tokens: [string]) -> [string] {
  let mut output = [];
  let mut stack = [];
  let mut i = 0;
  while i < len(tokens) {
    let t = tokens[i];
    if is_lparen(t) {
      push(stack, t);
    } else {
      if is_rparen(t) {
        // Pop until we hit the matching left paren.
        let mut keep_going = true;
        while keep_going && len(stack) > 0 {
          let top = stack[len(stack) - 1];
          if is_lparen(top) {
            keep_going = false;
          } else {
            push(output, top);
            let mut new_stack = [];
            let mut j = 0;
            while j < len(stack) - 1 {
              push(new_stack, stack[j]);
              j = j + 1;
            }
            stack = new_stack;
          };
        }
        // Pop the left paren itself.
        let mut new_stack = [];
        let mut j = 0;
        while j < len(stack) - 1 {
          push(new_stack, stack[j]);
          j = j + 1;
        }
        stack = new_stack;
      } else {
        if is_op(t) {
          // Pop higher-or-equal precedence operators to the output.
          let mut keep_going = true;
          while keep_going && len(stack) > 0 {
            let top = stack[len(stack) - 1];
            let should_pop = is_op(top) && (prec(top) > prec(t) || (prec(top) == prec(t) && left_assoc(t)));
            if should_pop {
              push(output, top);
              let mut new_stack = [];
              let mut j = 0;
              while j < len(stack) - 1 {
                push(new_stack, stack[j]);
                j = j + 1;
              }
              stack = new_stack;
            } else {
              keep_going = false;
            };
          }
          push(stack, t);
        } else {
          // A number — push to output.
          push(output, t);
        };
      };
    };
    i = i + 1;
  }
  // Drain the operator stack to the output.
  while len(stack) > 0 {
    let top = stack[len(stack) - 1];
    if is_lparen(top) { panic("unmatched left paren"); };
    push(output, top);
    let mut new_stack = [];
    let mut j = 0;
    while j < len(stack) - 1 {
      push(new_stack, stack[j]);
      j = j + 1;
    }
    stack = new_stack;
  }
  output
}

// --- RPN evaluator ---------------------------------------------------

// Parse a string as an integer (panics on bad input).
fn to_int(s: string) -> int {
  let mut n = 0;
  let mut i = 0;
  let mut neg = false;
  let len_s = len(s);
  if len_s > 0 && str(s[0]) == "-" {
    neg = true;
    i = 1;
  };
  while i < len_s {
    let c = str(s[i]);
    let d = digit_val(c);
    n = n * 10 + d;
    i = i + 1;
  }
  if neg { 0 - n } else { n }
}

// Apply a binary operator.
fn apply_op(op: string, a: int, b: int) -> int {
  if op == "+" { a + b } else {
  if op == "-" { a - b } else {
  if op == "*" { a * b } else {
  if op == "/" {
    if b == 0 { panic("divide by zero"); };
    int(a / b)
  } else {
    panic("unknown op: " + op)
  } } } }
}

// Evaluate an RPN token list to an integer.
fn eval_rpn(rpn: [string]) -> int {
  let mut stack = [];
  let mut i = 0;
  while i < len(rpn) {
    let t = rpn[i];
    if is_op(t) {
      if len(stack) < 2 { panic("stack underflow"); };
      let b = stack[len(stack) - 1];
      let a = stack[len(stack) - 2];
      let r = apply_op(t, a, b);
      let mut new_stack = [];
      let mut j = 0;
      while j < len(stack) - 2 {
        push(new_stack, stack[j]);
        j = j + 1;
      }
      push(new_stack, r);
      stack = new_stack;
    } else {
      push(stack, to_int(t));
    };
    i = i + 1;
  }
  if len(stack) != 1 { panic("invalid expression"); };
  stack[0]
}

// --- Convenience: evaluate an infix string ----------------------------

fn eval_expr(s: string) -> int {
  let tokens = tokenize(s);
  let rpn = to_rpn(tokens);
  eval_rpn(rpn)
}

// Render an array of tokens as a space-joined string.
fn join_tokens(arr: [string]) -> string {
  reduce(arr, fn(acc: string, t: string) -> string {
    if acc == "" { t } else { acc + " " + t }
  }, "")
}

// --- Demonstration ----------------------------------------------------

print("== Arithmetic expression evaluator (shunting-yard) ==");
print("");

let exprs = [
  "3 + 4 * 2",            // 11
  "( 3 + 4 ) * 2",        // 14
  "10 - 2 - 3",           // 5
  "100 / 7",              // 14 (integer division)
  "( 1 + 2 ) * ( 3 + 4 )",// 21
  "2 * 2 * 2 * 2",        // 16
  "7",                    // 7
  "(( 5 ))",              // 5
  "1 + 2 + 3 + 4 + 5",    // 15
  "20 - 3 * 4",           // 8
];

let mut i = 0;
while i < len(exprs) {
  let e = exprs[i];
  let v = eval_expr(e);
  let rpn_str = join_tokens(to_rpn(tokenize(e)));
  print("  " + e + " = " + str(v) + "   (RPN: " + rpn_str + ")");
  i = i + 1;
}
print("");

// Sanity assertions.
assert_eq(eval_expr("3 + 4 * 2"), 11);
assert_eq(eval_expr("( 3 + 4 ) * 2"), 14);
assert_eq(eval_expr("10 - 2 - 3"), 5);
assert_eq(eval_expr("100 / 7"), 14);
assert_eq(eval_expr("( 1 + 2 ) * ( 3 + 4 )"), 21);
assert_eq(eval_expr("2 * 2 * 2 * 2"), 16);
assert_eq(eval_expr("7"), 7);
assert_eq(eval_expr("(( 5 ))"), 5);
assert_eq(eval_expr("1 + 2 + 3 + 4 + 5"), 15);
assert_eq(eval_expr("20 - 3 * 4"), 8);
print("All assertions passed.");
