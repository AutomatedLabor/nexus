// regex_match_dp.ae
// =================
// Regex matching with '.' and '*' via DP. Given a text `s` and a
// pattern `p` where '.' matches any single char and '*' matches
// zero or more of the preceding element, decide if the pattern
// matches the entire text.
//
// Standard DP:
//   dp[i][j] = does s[0..i] match p[0..j]?
//   dp[0][0] = true
//   dp[0][j] = dp[0][j-2] if p[j-1] == '*'
//   dp[i][j] = dp[i-1][j-1] if p[j-1] == s[i-1] or p[j-1] == '.'
//            = dp[i][j-2] || (dp[i-1][j] && match(s[i-1], p[j-2]))
//              if p[j-1] == '*'
//            = false otherwise

fn make2d(rows: int, cols: int) -> [[int]] {
  let mut out = [];
  let mut i = 0;
  while i < rows {
    let mut row = [];
    let mut j = 0;
    while j < cols { push(row, 0); j = j + 1; }
    push(out, row);
    i = i + 1;
  }
  out
}

fn char_match(c: int, p: int) -> int {
  if p == 46 {  // '.'
    1
  } else {
    if c == p { 1 } else { 0 }
  }
}

fn regex_match(s: string, p: string) -> int {
  let m = len(s);
  let n = len(p);
  let mut dp = make2d(m + 1, n + 1);
  dp[0][0] = 1;
  // empty string vs pattern: only true if pattern is all X* forms
  let mut j = 2;
  while j <= n {
    if charCode(p, j - 1) == 42 {  // '*'
      dp[0][j] = dp[0][j - 2];
    };
    j = j + 1;
  }
  let mut a = 1;
  while a <= m {
    let mut b = 1;
    while b <= n {
      let pc = charCode(p, b - 1);
      let sc = charCode(s, a - 1);
      if pc == 42 {  // '*'
        // zero occurrences
        let zero = dp[a][b - 2];
        // one or more occurrences
        let prev_c = charCode(p, b - 2);
        let more = if char_match(sc, prev_c) == 1 { dp[a - 1][b] } else { 0 };
        dp[a][b] = if zero == 1 { 1 } else { more };
      } else {
        if char_match(sc, pc) == 1 {
          dp[a][b] = dp[a - 1][b - 1];
        } else {
          dp[a][b] = 0;
        };
      };
      b = b + 1;
    }
    a = a + 1;
  }
  dp[m][n]
}

print("== Regex match (. and *) ==");
print("");

let cases = [
  ("aa", "a"),
  ("aa", "a*"),
  ("ab", ".*"),
  ("aab", "c*a*b"),
  ("mississippi", "mis*is*p*."),
  ("mississippi", "mis*is*ip*."),
  ("", "a*"),
  ("", "a"),
  ("bbbba", ".*a*a"),
  ("ab", ".*c")
];
let mut k = 0;
while k < len(cases) {
  let c = cases[k];
  let s = c.0;
  let p = c.1;
  let r = regex_match(s, p);
  let label = if r == 1 { "yes" } else { "no" };
  print(f"  \"{s}\" ~ \"{p}\" -> {label}");
  k = k + 1;
}
print("");

// Sanity assertions.
assert_eq(regex_match("aa", "a"), 0);
assert_eq(regex_match("aa", "a*"), 1);
assert_eq(regex_match("ab", ".*"), 1);
assert_eq(regex_match("aab", "c*a*b"), 1);
assert_eq(regex_match("mississippi", "mis*is*ip*."), 1);
assert_eq(regex_match("", "a*"), 1);
assert_eq(regex_match("", "a"), 0);
assert_eq(regex_match("ab", ".*c"), 0);
print("All assertions passed.");
