// dijkstra_full.ae
// =================
// Dijkstra's shortest-path algorithm with full path reconstruction
// from the source to every other node. Uses an O(V^2) priority queue
// (linear scan of the dist array for the unvisited minimum) so the
// code is heap-free. We rebuild each path from src to dst using the
// `prev` table.
//
// Graph: 7 nodes (labelled A..G as 0..6).
//   A --3--> B          A --1--> D
//   B --1--> C          D --5--> B
//   C --2--> E          D --7--> G
//   E --1--> G          G --2--> F
//   F --3--> G          B --6--> E
//
// From A we expect:
//   A:0  B:3  C:4  D:1  E:6  F:9  G:7
// Paths:
//   A->B: A->B            = 3
//   A->C: A->B->C         = 3+1 = 4
//   A->D: A->D            = 1
//   A->E: A->B->C->E      = 3+1+2 = 6  (vs A->B->E = 3+6 = 9)
//   A->G: A->B->C->E->G   = 6+1 = 7    (vs A->D->G = 1+7 = 8)
//   A->F: A->B->C->E->G->F = 7+2 = 9

// A small sentinel large enough for our graphs.
let n_safety = 1000;

fn repeat(n: int, v: int) -> [int] {
  let mut out = [];
  let mut i = 0;
  while i < n { push(out, v); i = i + 1; }
  out
}

fn name_of(i: int) -> string {
  if i == 0 { "A" } else {
  if i == 1 { "B" } else {
  if i == 2 { "C" } else {
  if i == 3 { "D" } else {
  if i == 4 { "E" } else {
  if i == 5 { "F" } else {
  if i == 6 { "G" } else { "?" } } } } } } }
}

fn show_path(arr: [int]) -> string {
  reduce(arr, fn(acc: string, x: int) -> string {
    if acc == "" { name_of(x) } else { acc + " -> " + name_of(x) }
  }, "")
}

fn dijkstra(edges: [[int]], n: int, src: int) -> [[int]] {
  let INF = 1000000;
  let mut dist = repeat(n, INF);
  let mut prev = repeat(n, -1);
  let mut visited = repeat(n, 0);
  dist[src] = 0;
  let mut iter = 0;
  while iter < n {
    let mut u = -1;
    let mut best = INF;
    let mut j = 0;
    while j < n {
      if (visited[j] == 0) && (dist[j] < best) {
        best = dist[j];
        u = j;
      };
      j = j + 1;
    }
    if u == -1 { iter = n + 1; } else {
      visited[u] = 1;
      let mut e = 0;
      while e < len(edges) {
        let edge = edges[e];
        if edge[0] == u {
          let to = edge[1];
          let w  = edge[2];
          if visited[to] == 0 {
            let nd = dist[u] + w;
            if nd < dist[to] {
              dist[to] = nd;
              prev[to] = u;
            };
          };
        };
        e = e + 1;
      }
      iter = iter + 1;
    }
  }
  [dist, prev]
}

fn build_path(prev: [int], src: int, dst: int) -> [int] {
  if prev[dst] == -1 && src != dst { return []; };
  let mut rev = [];
  let mut cur = dst;
  let mut safety = 0;
  while (cur != -1) && (safety < n_safety) {
    push(rev, cur);
    if cur == src { cur = -1; } else { cur = prev[cur]; };
    safety = safety + 1;
  }
  let mut out = [];
  let mut i = len(rev) - 1;
  while i >= 0 { push(out, rev[i]); i = i - 1; }
  out
}

print("== Dijkstra with full path reconstruction ==");
print("");

let edges = [
  [0, 1, 3],
  [0, 3, 1],
  [1, 2, 1],
  [1, 4, 6],
  [2, 4, 2],
  [3, 1, 5],
  [3, 6, 7],
  [4, 6, 1],
  [6, 5, 2],
  [5, 6, 3]
];
let n = 7;
let src = 0;

print("edges:");
let mut k = 0;
while k < len(edges) {
  let e = edges[k];
  print(f"  {name_of(e[0])} --{e[2]}--> {name_of(e[1])}");
  k = k + 1;
}
print("");

let r = dijkstra(edges, n, src);
let dist = r[0];
let prev = r[1];

print("distances and paths from A:");
let mut i = 0;
while i < n {
  let p = build_path(prev, src, i);
  if len(p) == 0 {
    print(f"  {name_of(i)}: unreachable");
  } else {
    print(f"  {name_of(i)}: dist={dist[i]}  path={show_path(p)}");
  };
  i = i + 1;
}
print("");

// Sanity assertions.
assert_eq(dist[0], 0);
assert_eq(dist[1], 3);
assert_eq(dist[2], 4);
assert_eq(dist[3], 1);
assert_eq(dist[4], 6);
assert_eq(dist[5], 9);
assert_eq(dist[6], 7);
print("All assertions passed.");
