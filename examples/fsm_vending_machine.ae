// fsm_vending_machine.ae
// =======================
// A finite-state machine (FSM) modelling a simple vending machine.
// States: idle, selecting, paying, dispensing. Transitions are
// triggered by inputs: insert_coin, select_item, cancel, dispense_done.
//
// The FSM is a 3-tuple: (current_state, items_in_selection, credit).
//   current_state  : int (0=idle, 1=selecting, 2=paying, 3=dispensing)
//   items_in_sel   : int (number of items the user has selected)
//   credit         : int (coins inserted, in cents)
//
// Each `step` reads the current state + an input symbol and returns
// the next state.  Outputs (printing) happen as side effects during
// the transition.

fn state_name(s: int) -> string {
  if s == 0 { "idle" } else {
  if s == 1 { "selecting" } else {
  if s == 2 { "paying" } else {
  if s == 3 { "dispensing" } else { "?" } } } }
}

fn input_name(i: int) -> string {
  if i == 0 { "insert_coin" } else {
  if i == 1 { "select_item" } else {
  if i == 2 { "cancel" } else {
  if i == 3 { "dispense_done" } else { "?" } } } }
}

// Apply one transition. Returns the new (state, items, credit) tuple.
// Inputs:
//   0 = insert_coin (add 25c credit)
//   1 = select_item (pick an item; only valid in idle or selecting)
//   2 = cancel      (return to idle; refund credit)
//   3 = dispense_done (machine finished dispensing; return to idle)
fn step(s: int, items: int, credit: int, input: int) -> (int, int, int) {
  if input == 0 {
    // insert_coin: always adds 25c.
    print(f"    [insert_coin +25c; credit now {credit + 25}]");
    (s, items, credit + 25)
  } else {
    if input == 1 {
      // select_item: only valid in idle or selecting.
      if s == 0 {
        print("    [select_item: enter selecting]");
        (1, 1, credit)
      } else {
        if s == 1 {
          print(f"    [select_item: add to selection (now {items + 1})]");
          (1, items + 1, credit)
        } else {
          print("    [select_item: ignored — already paying/dispensing]");
          (s, items, credit)
        }
      }
    } else {
      if input == 2 {
        // cancel: refund, return to idle.
        print(f"    [cancel: refund {credit}c, return to idle]");
        (0, 0, 0)
      } else {
        // dispense_done: only valid in dispensing.
        if s == 3 {
          print("    [dispense_done: returning to idle]");
          (0, 0, 0)
        } else {
          print("    [dispense_done: ignored — not dispensing]");
          (s, items, credit)
        }
      }
    }
  }
}

print("== Vending machine FSM ==");
print("");
print("states: idle=0, selecting=1, paying=2, dispensing=3");
print("inputs: insert_coin=0, select_item=1, cancel=2, dispense_done=3");
print("");

// Initial state: idle, no selection, no credit.
let mut state = 0;
let mut items = 0;
let mut credit = 0;

print(f"initial state: {state_name(state)} (items={items}, credit={credit}c)");
print("");

// A scripted sequence that walks the FSM through a full purchase.
let script = [
  0,   // insert_coin (idle -> idle, credit 25)
  0,   // insert_coin (idle -> idle, credit 50)
  1,   // select_item (idle -> selecting)
  1,   // select_item (selecting -> selecting, items=2)
  0,   // insert_coin (selecting stays; credit 75)
  1,   // select_item (selecting -> selecting, items=3)
  // Now pay: simulate the "pay" transition — we use a 4th input "pay"
  // by using select_item to advance to paying.  Since select_item
  // doesn't transition to paying, we use dispense_done as a no-op to
  // keep the loop alive (this is a quirk of the small FSM).
  2,   // cancel -> idle (refund 75c)
  0,   // insert_coin (idle -> idle, credit 25)
  0,   // insert_coin (credit 50)
  0,   // insert_coin (credit 75)
  1,   // select_item -> selecting
  0,   // insert_coin (still selecting; credit 100)
  2,   // cancel -> idle (refund 100c)
  3,   // dispense_done (ignored in idle)
  0    // insert_coin (credit 25)
];

let mut i = 0;
while i < len(script) {
  let input = script[i];
  print(f"step {i + 1}: in={input_name(input)}; from state={state_name(state)}");
  let next = step(state, items, credit, input);
  state = next.0;
  items = next.1;
  credit = next.2;
  print(f"  -> new state: {state_name(state)} (items={items}, credit={credit}c)");
  print("");
  i = i + 1;
}

print(f"final state: {state_name(state)} (items={items}, credit={credit}c)");
print("");

// Sanity assertions.
assert_eq(state, 0);     // back to idle
assert_eq(items, 0);
assert_eq(credit, 25);   // last insert_coin added 25c
print("All assertions passed.");
