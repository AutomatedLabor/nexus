// forth_interp.ae
// ===============
// A tiny Forth interpreter.  Forth is a stack-based language:
// every operation either pushes a value onto the stack or pops
// some values and pushes a result.
//
// Supported:
//   - int literals (pushed onto the stack)
//   - +, -, *           binary arithmetic (pop two, push result)
//   - dup, drop, swap    stack manipulation
//   - .                  print top of stack and pop
//   - emit               print top of stack as a char and pop
//   - ;                  no-op separator (just visual)
//
// Programs are space-separated token strings.  Example:
//   "1 2 + ."        -> prints 3
//   "3 4 * 5 + ."    -> prints 17
//   "10 dup * ."     -> prints 100  (square)
//   "65 emit"        -> prints "A"

// Tokenise a Forth source string into a list of tokens (split on
// whitespace runs).
fn tokenize(s: string) -> [string] {
  let out = [];
  let mut cur = "";
  let mut i = 0;
  let n = len(s);
  while i < n {
    let c = strSlice(s, i, i + 1);
    if c == " " || c == "\t" || c == "\n" {
      if cur != "" { push(out, cur) };
      cur = "";
    } else {
      cur = cur + c;
    };
    i = i + 1;
  }
  if cur != "" { push(out, cur) };
  out
}

// Is this token an integer?
fn is_int_tok(t: string) -> bool {
  let n = len(t);
  if n == 0 { 0 } else {
    let mut i = 0;
    if strSlice(t, 0, 1) == "-" {
      if n == 1 { return false };
      i = 1;
    };
    let mut ok = true;
    while i < n {
      let c = strSlice(t, i, i + 1);
      if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" ||
         c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
      } else {
        ok = false;
      };
      i = i + 1;
    }
    ok
  }
}

fn parse_int_tok(t: string) -> int {
  let mut neg = false;
  let mut i = 0;
  if strSlice(t, 0, 1) == "-" {
    neg = true;
    i = 1;
  };
  let mut v = 0;
  while i < len(t) {
    let c = strSlice(t, i, i + 1);
    let d =
      if c == "0" { 0 } else {
      if c == "1" { 1 } else {
      if c == "2" { 2 } else {
      if c == "3" { 3 } else {
      if c == "4" { 4 } else {
      if c == "5" { 5 } else {
      if c == "6" { 6 } else {
      if c == "7" { 7 } else {
      if c == "8" { 8 } else {
      9 } } } } } } } } };
    v = v * 10 + d;
    i = i + 1;
  }
  if neg { -v } else { v }
}

// State: parallel arrays (stack) + output string.
// Stack is a list of ints; output is a single string.
fn run_forth(src: string) -> [any] {
  let stack = [];
  let mut out = "";
  let tokens = tokenize(src);
  let mut i = 0;
  while i < len(tokens) {
    let t = tokens[i];
    if is_int_tok(t) {
      push(stack, parse_int_tok(t));
    } else {
      if t == "+" {
        let b = pop(stack);
        let a = pop(stack);
        push(stack, a + b);
      } else {
        if t == "-" {
          let b = pop(stack);
          let a = pop(stack);
          push(stack, a - b);
        } else {
          if t == "*" {
            let b = pop(stack);
            let a = pop(stack);
            push(stack, a * b);
          } else {
            if t == "dup" {
              let top = stack[len(stack) - 1];
              push(stack, top);
            } else {
              if t == "drop" {
                let _ = pop(stack);
              } else {
                if t == "swap" {
                  let b = pop(stack);
                  let a = pop(stack);
                  push(stack, b);
                  push(stack, a);
                } else {
                  if t == "." {
                    let v = pop(stack);
                    if out != "" { out = out + " " };
                    out = out + str(v);
                  } else {
                    if t == "emit" {
                      let v = pop(stack);
                      out = out + fromCharCode(v);
                    } else {
                      if t == ";" {
                        // separator — ignore
                      } else {
                        // Unknown token — emit as a comment.
                        if out != "" { out = out + " " };
                        out = out + "[?" + t + "?]";
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    };
    i = i + 1;
  }
  [stack, out]
}

// Run a program and print the result.
fn demo(label: string, src: string) {
  let result = run_forth(src);
  let stack = result[0];
  let out = result[1];
  print("program: " + src);
  print("  output: " + str(out));
  print("  final stack: " + str(stack));
  print("");
}

print("== Tiny Forth interpreter ==");
print("");

demo("add", "1 2 + .");
demo("arith", "3 4 * 5 + .");
demo("square", "10 dup * .");
demo("two outputs", "1 . 2 . 3 .");
demo("emit char", "65 emit");
demo("emit word", "72 105 emit emit");
demo("swap", "1 2 swap . .");
demo("drop", "1 2 drop .");
demo("nested", "2 3 + 4 * .");
demo("negative", "5 neg; drop; 0 5 - .");
demo("sum 1..5", "1 2 + 3 + 4 + 5 + .");
demo("max of two", "10 20 swap drop; 20 .");

// Sanity assertions.
let r1 = run_forth("1 2 + .");
assert_eq(r1[1], "3");
let r2 = run_forth("3 4 * 5 + .");
assert_eq(r2[1], "17");
let r3 = run_forth("10 dup * .");
assert_eq(r3[1], "100");
let r4 = run_forth("1 . 2 . 3 .");
assert_eq(r4[1], "1 2 3");
let r5 = run_forth("65 emit");
assert_eq(r5[1], "A");
let r6 = run_forth("1 2 swap . .");
assert_eq(r6[1], "1 2");
let r7 = run_forth("2 3 + 4 * .");
assert_eq(r7[1], "20");
let r8 = run_forth("0 5 - .");
assert_eq(r8[1], "-5");
let r9 = run_forth("5 6 + 7 + 8 + .");
assert_eq(r9[1], "26");
print("All assertions passed.");
