// csv_to_json.ae
// ==============
// Parse a CSV string into rows of fields, then emit a JSON-ish
// string.  Quoted fields with embedded commas are supported
// (escaping: "" inside a quoted field is a literal ").
//
// Output format:
//   [ {"col1":"a","col2":"b"}, {"col1":"c","col2":"d"} ]
//
// The first row of the CSV is treated as the header (column names).

// Trim a single trailing \r from a line (handles Windows CRLF).
fn strip_cr(s: string) -> string {
  let n = len(s);
  if n > 0 && strSlice(s, n - 1, n) == "\r" {
    strSlice(s, 0, n - 1)
  } else {
    s
  }
}

// Split a multi-line CSV string into a list of lines (no \n).
fn split_lines(s: string) -> [string] {
  let out = [];
  let mut cur = "";
  let mut i = 0;
  let n = len(s);
  while i < n {
    let c = strSlice(s, i, i + 1);
    if c == "\n" {
      push(out, strip_cr(cur));
      cur = "";
    } else {
      cur = cur + c;
    };
    i = i + 1;
  }
  if cur != "" { push(out, strip_cr(cur)) };
  out
}

// Parse a single CSV line into a list of fields.  Handles quoted
// fields ("..." with "" as an escape) and unquoted fields
// (everything up to the next comma).
fn parse_csv_line(line: string) -> [string] {
  let fields = [];
  let mut cur = "";
  let mut in_quote = false;
  let mut i = 0;
  let n = len(line);
  while i < n {
    let c = strSlice(line, i, i + 1);
    if in_quote {
      if c == "\"" {
        // Look ahead: "" is an escaped quote.
        if i + 1 < n && strSlice(line, i + 1, i + 2) == "\"" {
          cur = cur + "\"";
          i = i + 2;
        } else {
          in_quote = false;
          i = i + 1;
        };
      } else {
        cur = cur + c;
        i = i + 1;
      };
    } else {
      if c == "\"" {
        in_quote = true;
        i = i + 1;
      } else {
        if c == "," {
          push(fields, cur);
          cur = "";
          i = i + 1;
        } else {
          cur = cur + c;
          i = i + 1;
        };
      };
    };
  }
  push(fields, cur);
  fields
}

// Parse a CSV string into a list of field lists (one per row).
fn parse_csv(s: string) -> [[string]] {
  let rows = [];
  let lines = split_lines(s);
  let mut i = 0;
  while i < len(lines) {
    if lines[i] != "" { push(rows, parse_csv_line(lines[i])) };
    i = i + 1;
  }
  rows
}

// JSON-escape a string field: escape " and \, leave others.
fn json_escape(s: string) -> string {
  let mut out = "";
  let mut i = 0;
  let n = len(s);
  while i < n {
    let c = strSlice(s, i, i + 1);
    if c == "\"" {
      out = out + "\\\"";
    } else {
      if c == "\\" {
        out = out + "\\\\";
      } else {
        out = out + c;
      };
    };
    i = i + 1;
  }
  out
}

// Convert parsed rows to a JSON-ish string.  Row 0 is the header.
fn to_json(rows: [[string]]) -> string {
  if len(rows) == 0 {
    "[]"
  } else {
    let header = rows[0];
    let mut out = "[";
    let mut r = 1;
    while r < len(rows) {
      let row = rows[r];
      out = out + "{";
      let mut c = 0;
      while c < len(header) {
        let col = header[c];
        let val =
          if c < len(row) { row[c] } else { "" };
        out = out + "\"" + json_escape(col) + "\":\"" + json_escape(val) + "\"";
        if c + 1 < len(header) { out = out + ", " };
        c = c + 1;
      }
      out = out + "}";
      if r + 1 < len(rows) { out = out + ", " };
      r = r + 1;
    }
    out = out + "]"
  }
}

print("== CSV -> JSON converter ==");
print("");

let csv = "name,age,city\nAda,36,London\nLinus,54,Helsinki\nGrace,85,\"New York, NY\"\n";
print("input CSV:");
print(csv);
print("");

let rows = parse_csv(csv);
print("parsed rows (" + str(len(rows)) + " total, including header):");
let mut r = 0;
while r < len(rows) {
  print("  " + str(rows[r]));
  r = r + 1;
}
print("");

let json = to_json(rows);
print("JSON output:");
print(json);
print("");

// Edge cases.
print("--- Edge cases ---");
let csv2 = "a,b\n1,2\n";
print("simple: " + to_json(parse_csv(csv2)));

let csv3 = "x\n";
print("header only: " + to_json(parse_csv(csv3)));

let csv4 = "";
print("empty: " + to_json(parse_csv(csv4)));

let csv5 = "k1,k2\nv1,\"hello, world\"\n";
print("quoted comma: " + to_json(parse_csv(csv5)));

let csv6 = "k\n\"she said \"\"hi\"\"\"\n";
print("escaped quote: " + to_json(parse_csv(csv6)));

// Sanity assertions.
assert_eq(to_json(parse_csv(csv)), "[{\"name\":\"Ada\", \"age\":\"36\", \"city\":\"London\"}, {\"name\":\"Linus\", \"age\":\"54\", \"city\":\"Helsinki\"}, {\"name\":\"Grace\", \"age\":\"85\", \"city\":\"New York, NY\"}]");
assert_eq(to_json(parse_csv("")), "[]");
assert_eq(to_json(parse_csv("x\n")), "[]");
assert_eq(to_json(parse_csv("a,b\n1,2\n")), "[{\"a\":\"1\", \"b\":\"2\"}]");
print("");
print("All assertions passed.");
