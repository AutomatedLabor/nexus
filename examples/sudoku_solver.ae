// sudoku_solver.ae
// ================
// Solve a 4x4 Sudoku puzzle (block size 2x2) via backtracking. The
// grid uses 0 for empty cells. We print the puzzle, solve it, and
// print the solution.
//
// Algorithm:
//   - Find the next empty cell (row-major order).
//   - Try each digit 1..4 in turn.
//   - For each digit, check if it's consistent with the row, column,
//     and 2x2 box.
//   - If consistent, place it and recurse; if recursion fails, undo.
//
// The puzzle:
//   1 . . .
//   . . 3 .
//   . 2 . .
//   . . . 4
//
// The solution:
//   1 3 2 4
//   4 1 3 2
//   3 2 4 1
//   2 4 1 3

let n = 4;  // grid size
let block = 2;  // block size (block x block cells per block)

// We use a flat array of 16 cells; index = row * n + col.
let mut grid = [
  1, 0, 0, 0,
  0, 0, 3, 0,
  0, 2, 0, 0,
  0, 0, 0, 4,
];

fn consistent(grid: [int], row: int, col: int, val: int) -> bool {
  let mut ok = true;
  // Check the row.
  let mut c = 0;
  while c < n {
    if grid[row * n + c] == val {
      ok = false;
    };
    c = c + 1;
  }
  // Check the column.
  let mut r = 0;
  while r < n {
    if grid[r * n + col] == val {
      ok = false;
    };
    r = r + 1;
  }
  // Check the block.
  let br = int(row / block) * block;
  let bc = int(col / block) * block;
  let mut i = 0;
  while i < block {
    let mut j = 0;
    while j < block {
      if grid[(br + i) * n + (bc + j)] == val {
        ok = false;
      };
      j = j + 1;
    };
    i = i + 1;
  }
  ok
}

fn find_empty(grid: [int]) -> int {
  // Returns the index of the next empty cell, or -1 if none.
  let mut idx = -1;
  let mut i = 0;
  let mut cont = true;
  while i < n * n && cont {
    if grid[i] == 0 {
      idx = i;
      cont = false;
    };
    i = i + 1;
  }
  idx
}

fn solve(grid: [int]) -> bool {
  let idx = find_empty(grid);
  if idx == -1 {
    true  // all cells filled — solved.
  } else {
    let row = int(idx / n);
    let col = idx % n;
    let mut solved = false;
    let mut val = 1;
    while val <= n && !solved {
      if consistent(grid, row, col, val) {
        grid[idx] = val;
        if solve(grid) {
          solved = true;
        } else {
          grid[idx] = 0;
        };
      };
      val = val + 1;
    }
    solved
  }
}

fn show_grid(grid: [int]) -> string {
  let mut out = "";
  let mut r = 0;
  while r < n {
    let mut row_str = "";
    let mut c = 0;
    while c < n {
      let v = grid[r * n + c];
      let s = str(v);
      if c == 0 {
        row_str = s;
      } else {
        row_str = row_str + " " + s;
      };
      c = c + 1;
    }
    if r == 0 {
      out = row_str;
    } else {
      out = out + "\n" + row_str;
    };
    r = r + 1;
  }
  out
}

print("== 4x4 Sudoku solver demo ==");
print("");
print("puzzle:");
print(show_grid(grid));
print("");

let solved = solve(grid);
if solved {
  print("solution:");
  print(show_grid(grid));
} else {
  print("no solution exists");
};

print("");
print("Sudoku solver complete.");
