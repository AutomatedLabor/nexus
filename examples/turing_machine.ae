// turing_machine.ae
// =================
// A small Turing machine that increments a binary number.
// The tape is a list of characters (each "0", "1", or "_" blank),
// extended infinitely on both sides by blanks. The head moves
// left/right one cell per step.
//
// Machine definition (increment a binary number):
//
//   States:  { Start, Rewind, AddOne, Done }
//   Symbols: { 0, 1, _ }
//
// Algorithm (informal):
//   1. From the start, walk right until we hit a blank — that's the
//      right end of the number.
//   2. Step left to the least-significant bit.
//   3. Carry-add: while the current bit is "1", write "0" and step
//      left. When we hit a "0", write "1" and stop. When we hit a
//      blank (carry overflowed past the top bit), write "1" and stop.
//
// We represent the tape as a dynamic array of strings plus a head
// index. To stay simple, we don't auto-extend the tape (we pre-pad
// with blanks so the head never runs off the end for the test
// inputs).

// Tape representation: a [string] of "0", "1", or "_".
// The head is an int index into that array.

// Read the symbol under the head.
fn read_tape(tape: [string], head: int) -> string {
  tape[head]
}

// Write `s` to the cell under the head. Returns a fresh tape
// (no in-place mutation — Aether v1 arrays are value-ish).
fn write_tape(tape: [string], head: int, s: string) -> [string] {
  let mut out = [];
  let mut i = 0;
  while i < len(tape) {
    if i == head {
      push(out, s);
    } else {
      push(out, tape[i]);
    };
    i = i + 1;
  }
  out
}

// Render the tape as a string with the head marked by ^.
fn show_tape(tape: [string], head: int) -> string {
  let mut cells = "";
  let mut marker = "";
  let mut i = 0;
  while i < len(tape) {
    let c = tape[i];
    cells = cells + " " + c + " ";
    let pad = "  ";
    marker = marker + (if i == head { " ^ " } else { "   " });
    i = i + 1;
  }
  cells + "\n" + marker
}

// Render a state as a printable label.
fn state_name(s: string) -> string { s }

// Run the increment machine. Returns the final tape (the head
// position is informational — we leave it where the machine
// halted). We step until we reach the "Done" state or until we
// exceed a safety limit (avoids infinite loops on a malformed
// machine definition).
fn run_increment(tape: [string], head: int) -> [string] {
  let mut t = tape;
  let mut h = head;
  let mut state = "Start";
  let mut steps = 0;
  let mut safety = 0;
  while state != "Done" && safety < 1000 {
    safety = safety + 1;
    let c = read_tape(t, h);

    if state == "Start" {
      // Walk right over 0/1 until we hit a blank (the right end).
      if c == "0" || c == "1" {
        h = h + 1;
      } else {
        // Hit blank — step left to the LSB and enter AddOne.
        h = h - 1;
        state = "AddOne";
      };
    } else {
      if state == "AddOne" {
        // Add the carry. If current is "1", write "0", step left.
        // If current is "0" or "_", write "1", and we're done.
        if c == "1" {
          t = write_tape(t, h, "0");
          h = h - 1;
        } else {
          if c == "0" {
            t = write_tape(t, h, "1");
            state = "Done";
          } else {
            // Blank — carry overflowed past the top. Write a 1 here.
            t = write_tape(t, h, "1");
            state = "Done";
          };
        };
      };
    };
    steps = steps + 1;
  }
  t
}

print("== Turing machine: binary increment ==");
print("");
print("A small TM that adds 1 to a binary number.");
print("Tape symbols: 0, 1, _ (blank). Head marked by ^.");
print("");

// Test 1: increment 0 (binary) → 1.
let t1 = ["_", "0", "_"];
let h1 = 1;
print("Test 1: increment '0'");
print("before:");
print(show_tape(t1, h1));
let t1b = run_increment(t1, h1);
print("after:");
print(show_tape(t1b, 1));
print("");

// Test 2: increment 1 → 10.
let t2 = ["_", "1", "_"];
let h2 = 1;
print("Test 2: increment '1' (expect '10')");
print("before:");
print(show_tape(t2, h2));
let t2b = run_increment(t2, h2);
print("after:");
print(show_tape(t2b, 1));
print("");

// Test 3: increment 1011 (binary 11) → 1100 (binary 12).
let t3 = ["_", "1", "0", "1", "1", "_"];
let h3 = 1;
print("Test 3: increment '1011' (expect '1100')");
print("before:");
print(show_tape(t3, h3));
let t3b = run_increment(t3, h3);
print("after:");
print(show_tape(t3b, 1));
print("");

// Test 4: increment 111 (binary 7) → 1000 (binary 8) — carry
// overflow past the top bit.
let t4 = ["_", "1", "1", "1", "_"];
let h4 = 1;
print("Test 4: increment '111' (expect '1000' — carry overflow)");
print("before:");
print(show_tape(t4, h4));
let t4b = run_increment(t4, h4);
print("after:");
print(show_tape(t4b, 1));
print("");

// Test 5: increment 101010 (binary 42) → 101011 (binary 43).
let t5 = ["_", "1", "0", "1", "0", "1", "0", "_"];
let h5 = 1;
print("Test 5: increment '101010' (expect '101011')");
print("before:");
print(show_tape(t5, h5));
let t5b = run_increment(t5, h5);
print("after:");
print(show_tape(t5b, 1));
print("");

// Sanity assertions on the produced tapes.
// Tape format: [ "_", d1, d2, ..., dn, "_" ].
// We verify the binary value of the produced digits equals
// the expected value.

// Read the digits out of the tape (skip the surrounding blanks).
fn digits(tape: [string]) -> [string] {
  let mut out = [];
  let mut i = 0;
  while i < len(tape) {
    let c = tape[i];
    if c == "0" || c == "1" {
      push(out, c);
    };
    i = i + 1;
  }
  out
}

// Convert a [string] of "0"/"1" to a binary int (most-significant first).
fn bin_to_int(arr: [string]) -> int {
  let mut n = 0;
  let mut i = 0;
  while i < len(arr) {
    let bit = if arr[i] == "1" { 1 } else { 0 };
    n = n * 2 + bit;
    i = i + 1;
  }
  n
}

assert_eq(bin_to_int(digits(t1b)), 1);     // 0 + 1 = 1
assert_eq(bin_to_int(digits(t2b)), 2);     // 1 + 1 = 2
assert_eq(bin_to_int(digits(t3b)), 12);    // 11 + 1 = 12
assert_eq(bin_to_int(digits(t4b)), 8);     // 7 + 1 = 8
assert_eq(bin_to_int(digits(t5b)), 43);    // 42 + 1 = 43

print("All assertions passed.");
