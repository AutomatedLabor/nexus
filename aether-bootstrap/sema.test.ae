  // `enum E { A, B }` -> 0 errors
  let parts = [
    "Keyword", "enum", "Ident", "E", "Punct", "{",
      "Ident", "A", "Punct", ",", "Ident", "B",
    "Punct", "}"
  ];
  checkEq(st, C(parts), 0, "enum-decl: 0 errors");
  0
}

fn test_enum_variant_unit(st: Stats) -> int {
  // `enum E { A, B } let a = E::A;` -> 0 errors
  let parts = [
    "Keyword", "enum", "Ident", "E", "Punct", "{",
      "Ident", "A", "Punct", ",", "Ident", "B",
    "Punct", "}",
    "Keyword", "let", "Ident", "a", "Punct", "=", "Ident", "E", "Punct", "::", "Ident", "A", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "enum-variant-unit: 0 errors");
  0
}

fn test_enum_variant_tuple(st: Stats) -> int {
  // `enum E { A, B(int) } let b = E::B(42);` -> 0 errors
  let parts = [
    "Keyword", "enum", "Ident", "E", "Punct", "{",
      "Ident", "A", "Punct", ",", "Ident", "B", "Punct", "(", "Ident", "int", "Punct", ")",
