  // `let x = !true;` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Punct", "!", "Keyword", "true", "Punct", ";"]), 0, "unary-not: 0 errors");
  0
}

fn test_unary_not_int(st: Stats) -> int {
  // `let x = !5;` -> 1 error
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Punct", "!", "Int", "5", "Punct", ";"]), 1, "unary-not-int: 1 error");
  0
}

// =====================================================================
// Tests: struct
// =====================================================================

fn test_struct_decl(st: Stats) -> int {
  // `struct P { x: int, y: int }` -> 0 errors
  let parts = [
    "Keyword", "struct", "Ident", "P", "Punct", "{",
      "Ident", "x", "Punct", ":", "Ident", "int", "Punct", ",",
      "Ident", "y", "Punct", ":", "Ident", "int",
    "Punct", "}"
  ];
  checkEq(st, C(parts), 0, "struct-decl: 0 errors");
  0
}

fn test_struct_expr(st: Stats) -> int {
  // `struct P { x: int, y: int } let p = P { x: 1, y: 2 };` -> 0 errors
  let parts = [
    "Keyword", "struct", "Ident", "P", "Punct", "{",
      "Ident", "x", "Punct", ":", "Ident", "int", "Punct", ",",
      "Ident", "y", "Punct", ":", "Ident", "int",
    "Punct", "}",
    "Keyword", "let", "Ident", "p", "Punct", "=", "Ident", "P", "Punct", "{",
      "Ident", "x", "Punct", ":", "Int", "1", "Punct", ",",
      "Ident", "y", "Punct", ":", "Int", "2",
    "Punct", "}", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "struct-expr: 0 errors");
  0
}

fn test_struct_missing_field(st: Stats) -> int {
  // `struct P { x: int, y: int } let p = P { x: 1 };` -> 1+ errors (missing y)
  let parts = [
    "Keyword", "struct", "Ident", "P", "Punct", "{",
      "Ident", "x", "Punct", ":", "Ident", "int", "Punct", ",",
      "Ident", "y", "Punct", ":", "Ident", "int",
    "Punct", "}",
    "Keyword", "let", "Ident", "p", "Punct", "=", "Ident", "P", "Punct", "{",
      "Ident", "x", "Punct", ":", "Int", "1",
    "Punct", "}", "Punct", ";"
  ];
  checkStat(st, C(parts) >= 1, "struct-missing-field: >= 1 error");
  0
}

fn test_struct_unknown_field(st: Stats) -> int {
  // `struct P { x: int } let p = P { z: 1 };` -> 1 error
  let parts = [
    "Keyword", "struct", "Ident", "P", "Punct", "{",
      "Ident", "x", "Punct", ":", "Ident", "int",
    "Punct", "}",
    "Keyword", "let", "Ident", "p", "Punct", "=", "Ident", "P", "Punct", "{",
      "Ident", "z", "Punct", ":", "Int", "1",
    "Punct", "}", "Punct", ";"
  ];
  checkStat(st, C(parts) >= 1, "struct-unknown-field: >= 1 error");
  0
}

fn test_struct_field_access(st: Stats) -> int {
  // `struct P { x: int } let p = P { x: 1 }; let y = p.x;` -> 0 errors
  let parts = [
    "Keyword", "struct", "Ident", "P", "Punct", "{",
      "Ident", "x", "Punct", ":", "Ident", "int",
    "Punct", "}",
    "Keyword", "let", "Ident", "p", "Punct", "=", "Ident", "P", "Punct", "{",
      "Ident", "x", "Punct", ":", "Int", "1",
    "Punct", "}", "Punct", ";",
    "Keyword", "let", "Ident", "y", "Punct", "=", "Ident", "p", "Punct", ".", "Ident", "x", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "struct-field-access: 0 errors");
  0
}

