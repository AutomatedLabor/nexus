// =====================================================================
// Tests: typeToString sanity
// =====================================================================

fn test_type_to_string(st: Stats) -> int {
  checkEqStr(st, typeToString(tInt()), "int", "ts-int");
  checkEqStr(st, typeToString(tFloat()), "float", "ts-float");
  checkEqStr(st, typeToString(tBool()), "bool", "ts-bool");
  checkEqStr(st, typeToString(tString()), "string", "ts-string");
  checkEqStr(st, typeToString(tChar()), "char", "ts-char");
  checkEqStr(st, typeToString(tUnit()), "()", "ts-unit");
  checkEqStr(st, typeToString(tNever()), "never", "ts-never");
  checkEqStr(st, typeToString(tArray(tInt())), "[int]", "ts-array");
  checkEqStr(st, typeToString(tOption(tInt())), "option<int>", "ts-option");
  checkEqStr(st, typeToString(tResult(tInt(), tString())), "result<int, string>", "ts-result");
  checkEqStr(st, typeToString(tNamed("Range", [])), "Range", "ts-named");
  0
}

fn test_type_eq(st: Stats) -> int {
  checkStat(st, typeEq(tInt(), tInt()), "typeEq int int");
  checkStat(st, !typeEq(tInt(), tFloat()), "typeEq int float (neg)");
  checkStat(st, typeEq(tArray(tInt()), tArray(tInt())), "typeEq array int");
  checkStat(st, typeEq(tFunc([tInt()], tInt()), tFunc([tInt()], tInt())), "typeEq fn int->int");
  checkStat(st, !typeEq(tFunc([tInt()], tInt()), tFunc([tString()], tInt())), "typeEq fn different (neg)");
  0
}

// =====================================================================
// Tests: patterns (more)
// =====================================================================

fn test_wildcard_pattern(st: Stats) -> int {
  // `match 1 { _ => 0 }` -> 0 errors
  let parts = [
    "Keyword", "let", "Ident", "r", "Punct", "=", "Keyword", "match", "Int", "1", "Punct", "{",
      "Punct", "_", "Punct", "=>", "Int", "0",
    "Punct", "}", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "wildcard-pat: 0 errors");
  0
}

fn test_lit_pattern(st: Stats) -> int {
  // `match 0 { 0 => "zero", 1 => "one", _ => "many" }` -> 0 errors
  let parts = [
    "Keyword", "let", "Ident", "r", "Punct", "=", "Keyword", "match", "Int", "0", "Punct", "{",
      "Int", "0", "Punct", "=>", "String", "zero", "Punct", ",",
      "Int", "1", "Punct", "=>", "String", "one", "Punct", ",",
      "Punct", "_", "Punct", "=>", "String", "many",
    "Punct", "}", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "lit-pat: 0 errors");
  0
}

fn test_or_pattern(st: Stats) -> int {
  // `enum E { A, B, C } match E::A { A | B => 1, C => 2 }` -> 0 errors
  let parts = [
    "Keyword", "enum", "Ident", "E", "Punct", "{", "Ident", "A", "Punct", ",", "Ident", "B", "Punct", ",", "Ident", "C", "Punct", "}",
    "Keyword", "let", "Ident", "r", "Punct", "=", "Keyword", "match", "Ident", "E", "Punct", "::", "Ident", "A", "Punct", "{",
      "Ident", "A", "Punct", "|", "Ident", "B", "Punct", "=>", "Int", "1", "Punct", ",",
      "Ident", "C", "Punct", "=>", "Int", "2",
    "Punct", "}", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "or-pat: 0 errors");
  0
}

fn test_struct_pattern(st: Stats) -> int {
  // `struct P { x: int, y: int } match P { x: a, y: b => a + b }` -> 0 errors
  let parts = [
    "Keyword", "struct", "Ident", "P", "Punct", "{",
      "Ident", "x", "Punct", ":", "Ident", "int", "Punct", ",",
      "Ident", "y", "Punct", ":", "Ident", "int",
    "Punct", "}",
    "Keyword", "let", "Ident", "p", "Punct", "=", "Ident", "P", "Punct", "{",
      "Ident", "x", "Punct", ":", "Int", "1", "Punct", ",",
      "Ident", "y", "Punct", ":", "Int", "2",
    "Punct", "}", "Punct", ";",
    "Keyword", "let", "Ident", "r", "Punct", "=", "Keyword", "match", "Ident", "p", "Punct", "{",
      "Ident", "P", "Punct", "{", "Ident", "x", "Punct", ":", "Ident", "a", "Punct", ",", "Ident", "y", "Punct", ":", "Ident", "b", "Punct", "}",
      "Punct", "=>", "Ident", "a", "Punct", "+", "Ident", "b",
    "Punct", "}", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "struct-pat: 0 errors");
  0
}

// =====================================================================
// Tests: option / result sugar
// =====================================================================

fn test_option_sugar(st: Stats) -> int {
  // `let x: option<int> = Option::None;` -> 0 errors
  let parts = [
    "Keyword", "let", "Ident", "x", "Punct", ":", "Ident", "option", "Punct", "<", "Ident", "int", "Punct", ">",
    "Punct", "=", "Ident", "Option", "Punct", "::", "Ident", "None", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "option-sugar: 0 errors");
  0
}

fn test_result_sugar(st: Stats) -> int {
  // `let x: result<int, string> = Result::Ok(42);` -> 0 errors
  let parts = [
    "Keyword", "let", "Ident", "x", "Punct", ":", "Ident", "result", "Punct", "<", "Ident", "int", "Punct", ",", "Ident", "string", "Punct", ">",
    "Punct", "=", "Ident", "Result", "Punct", "::", "Ident", "Ok", "Punct", "(", "Int", "42", "Punct", ")", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "result-sugar: 0 errors");
  0
}

fn test_result_error(st: Stats) -> int {
  // `let x: result<int, string> = Result::Err("oops");` -> 0 errors
  let parts = [
    "Keyword", "let", "Ident", "x", "Punct", ":", "Ident", "result", "Punct", "<", "Ident", "int", "Punct", ",", "Ident", "string", "Punct", ">",
    "Punct", "=", "Ident", "Result", "Punct", "::", "Ident", "Err", "Punct", "(", "String", "oops", "Punct", ")", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "result-error: 0 errors");
  0
}

// =====================================================================
// Tests: edge cases
// =====================================================================

fn test_paren_expr(st: Stats) -> int {
  // `let x = (42);` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Punct", "(", "Int", "42", "Punct", ")", "Punct", ";"]), 0, "paren-expr: 0 errors");
  0
}

fn test_bitwise_ops(st: Stats) -> int {
  // `let x = 1 & 2; let y = 3 | 4; let z = 5 ^ 6;` -> 0 errors
  let parts = [
    "Keyword", "let", "Ident", "x", "Punct", "=", "Int", "1", "Punct", "&", "Int", "2", "Punct", ";",
    "Keyword", "let", "Ident", "y", "Punct", "=", "Int", "3", "Punct", "|", "Int", "4", "Punct", ";",
    "Keyword", "let", "Ident", "z", "Punct", "=", "Int", "5", "Punct", "^", "Int", "6", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "bitwise: 0 errors");
  0
}

fn test_bitwise_wrong_type(st: Stats) -> int {
  // `let x = "a" & "b";` -> 1 error
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "String", "a", "Punct", "&", "String", "b", "Punct", ";"]), 1, "bitwise-wrong: 1 error");
  0
}

fn test_method_call_push(st: Stats) -> int {
  // `let a = [1]; a.push(2);` -> 0 errors
  let parts = [
    "Keyword", "let", "Ident", "a", "Punct", "=", "Punct", "[", "Int", "1", "Punct", "]", "Punct", ";",
    "Ident", "a", "Punct", ".", "Ident", "push", "Punct", "(", "Int", "2", "Punct", ")", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "method-push: 0 errors");
  0
}

fn test_index_non_array(st: Stats) -> int {
  // `let x = 5; let y = x[0];` -> 1 error
  let parts = [
    "Keyword", "let", "Ident", "x", "Punct", "=", "Int", "5", "Punct", ";",
    "Keyword", "let", "Ident", "y", "Punct", "=", "Ident", "x", "Punct", "[", "Int", "0", "Punct", "]", "Punct", ";"
  ];
  checkEq(st, C(parts), 1, "index-non-array: 1 error");
  0
}

fn test_string_concat(st: Stats) -> int {
  // `let x = "a" + "b"; let y = x + "c";` -> 0 errors
  let parts = [
    "Keyword", "let", "Ident", "x", "Punct", "=", "String", "a", "Punct", "+", "String", "b", "Punct", ";",
    "Keyword", "let", "Ident", "y", "Punct", "=", "Ident", "x", "Punct", "+", "String", "c", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "string-concat: 0 errors");
  0
}

fn test_let_with_call(st: Stats) -> int {
  // `fn inc(x: int) -> int { x + 1 } let y = inc(5); let z = inc(y);` -> 0 errors
  let parts = [
    "Keyword", "fn", "Ident", "inc", "Punct", "(", "Ident", "x", "Punct", ":", "Ident", "int", "Punct", ")", "Punct", "->", "Ident", "int",
    "Punct", "{", "Ident", "x", "Punct", "+", "Int", "1", "Punct", "}",
    "Keyword", "let", "Ident", "y", "Punct", "=", "Ident", "inc", "Punct", "(", "Int", "5", "Punct", ")", "Punct", ";",
    "Keyword", "let", "Ident", "z", "Punct", "=", "Ident", "inc", "Punct", "(", "Ident", "y", "Punct", ")", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "let-with-call: 0 errors");
  0
}

fn test_nested_fn(st: Stats) -> int {
  // `fn outer() -> int { fn inner() -> int { 1 } inner() }` -> 0 errors
  let parts = [
    "Keyword", "fn", "Ident", "outer", "Punct", "(", "Punct", ")", "Punct", "->", "Ident", "int",
    "Punct", "{",
      "Keyword", "fn", "Ident", "inner", "Punct", "(", "Punct", ")", "Punct", "->", "Ident", "int",
      "Punct", "{", "Int", "1", "Punct", "}",
      "Ident", "inner", "Punct", "(", "Punct", ")",
    "Punct", "}"
  ];
  checkEq(st, C(parts), 0, "nested-fn: 0 errors");
  0
}

fn test_two_errors(st: Stats) -> int {
  // `let x: int = "hi"; let y: int = 3.14;` -> 2 errors
  let parts = [
    "Keyword", "let", "Ident", "x", "Punct", ":", "Ident", "int", "Punct", "=", "String", "hi", "Punct", ";",
    "Keyword", "let", "Ident", "y", "Punct", ":", "Ident", "int", "Punct", "=", "Float", "3.14", "Punct", ";"
  ];
  checkEq(st, C(parts), 2, "two-errors: 2 errors");
  0
}

fn test_shadowing_warning(st: Stats) -> int {
  // `let x = 1; let x = 2;` -> 0 errors but 1+ warning
  let parts = [
    "Keyword", "let", "Ident", "x", "Punct", "=", "Int", "1", "Punct", ";",
    "Keyword", "let", "Ident", "x", "Punct", "=", "Int", "2", "Punct", ";"
  ];
  let r = parse(toks(parts));
  let cr = check(r.program);
  checkEq(st, len(cr.errors), 0, "shadowing: 0 errors");
  checkStat(st, len(cr.warnings) >= 1, "shadowing: >= 1 warning");
  0
}

// =====================================================================
// Driver
// =====================================================================

fn runAllTests() -> int {
  let st = Stats { passed: 0, failed: 0 };

  // literals & basic let inference
  test_let_int(st);
  test_let_float(st);
  test_let_bool(st);
  test_let_string(st);
  test_let_char(st);
  test_let_unit(st);
  test_let_annotated_int(st);
  test_let_annotated_float(st);
  test_let_annotated_bool(st);
  test_let_widening_int_to_float(st);
  test_let_mismatch_float_to_int(st);
  test_let_mismatch_string_to_float(st);
  test_let_mismatch_int_to_string(st);
  test_let_undefined_name(st);

  // function declarations
  test_fn_decl_simple(st);
  test_fn_decl_with_params(st);
  test_fn_decl_wrong_return(st);
  test_fn_decl_no_return(st);
  test_fn_call_args(st);
  test_fn_call_wrong_arg(st);
  test_fn_call_arity(st);
  test_fn_recursive(st);

  // generics
  test_generic_id(st);
  test_generic_id_explicit_type(st);
  test_generic_pair(st);

  // arithmetic
  test_arith_add(st);
  test_arith_float(st);
  test_arith_string_concat(st);
  test_arith_int_string(st);
  test_arith_mod(st);

  // comparisons
  test_cmp_lt(st);
  test_cmp_eq(st);
  test_cmp_mismatch(st);

  // logical
  test_logical_and(st);
  test_logical_or(st);
  test_logical_mismatch(st);

  // unary
  test_unary_neg(st);
  test_unary_not(st);
  test_unary_not_int(st);

  // struct
  test_struct_decl(st);
  test_struct_expr(st);
  test_struct_missing_field(st);
  test_struct_unknown_field(st);
  test_struct_field_access(st);

  // enum
  test_enum_decl(st);
  test_enum_variant_unit(st);
  test_enum_variant_tuple(st);
  test_enum_variant_wrong_arg(st);
  test_enum_unknown_variant(st);

  // tuple / array / map
  test_tuple_expr(st);
  test_tuple_field(st);
  test_array_expr(st);
  test_array_index(st);
  test_array_index_wrong_type(st);
  test_map_expr(st);
  test_map_index(st);

  // if / match
  test_if_expr(st);
  test_if_cond_not_bool(st);
  test_if_no_else(st);
  test_match_simple(st);
  test_match_with_bind(st);

  // while / for / break / continue / return
  test_while(st);
  test_while_cond_not_bool(st);
  test_for_in(st);
  test_break_outside_loop(st);
  test_continue_outside_loop(st);
  test_return_outside_fn(st);
  test_return_in_fn(st);
  test_return_wrong_type(st);

  // assign / compound assign
  test_assign_mut(st);
  test_assign_immutable(st);
  test_assign_wrong_type(st);
  test_compound_assign(st);

  // closures / lambda
  test_lambda_simple(st);
  test_lambda_wrong_body(st);
  test_closure_capture(st);

  // cast / range / error prop
  test_cast_int_to_float(st);
  test_cast_invalid(st);
  test_range(st);
  test_error_prop_option(st);

  // builtins
  test_builtin_len(st);
  test_builtin_print(st);
  test_builtin_assert(st);
  test_builtin_assert_wrong_arg(st);
  test_builtin_map(st);

  // const / mut let / pub fn
  test_const_decl(st);
  test_mut_let(st);
  test_pub_fn(st);

  // import / type alias / blocks
  test_import(st);
  test_type_alias(st);
  test_block_expr(st);
  test_empty_program(st);

  // multiple statements
  test_multi_let(st);
  test_undefined_after_let(st);

  // typeToString + typeEq sanity
  test_type_to_string(st);
  test_type_eq(st);

  // patterns (more)
  test_wildcard_pattern(st);
  test_lit_pattern(st);
  test_or_pattern(st);
  test_struct_pattern(st);

  // option / result sugar
  test_option_sugar(st);
  test_result_sugar(st);
  test_result_error(st);

  // edge cases
  test_paren_expr(st);
  test_bitwise_ops(st);
  test_bitwise_wrong_type(st);
  test_method_call_push(st);
  test_index_non_array(st);
  test_string_concat(st);
  test_let_with_call(st);
  test_nested_fn(st);
  test_two_errors(st);
  test_shadowing_warning(st);

  print("=============================");
  print("Sema test results:");
  print("  passed: " + str(st.passed));
  print("  failed: " + str(st.failed));
  if st.failed == 0 {
    print("  STATUS: ALL PASS");
  } else {
    print("  STATUS: FAILURES");
  };
  print("=============================");
  assert_eq(st.failed, 0);
  st.passed
}

// Run all tests
let npass = runAllTests();
print("Total asserts passed: " + str(npass));
