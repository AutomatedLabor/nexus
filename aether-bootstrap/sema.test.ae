// =============================================================================
// aether-bootstrap/sema.test.ae — Unit tests for the Aether semantic analyzer
// =============================================================================
// 100+ test cases that drive the sema via the parser's `parse(toks(...))`
// pipeline. Each test parses a small Aether snippet, runs `check(program)`,
// and asserts the error count (and sometimes the first error message).
//
// Test pipeline:
//   cat ast.ae parser.ae sema.ae sema.test.ae > /tmp/combined_sema.ae
//   bun /tmp/verify_one.ts /tmp/combined_sema.ae
//
// All test functions return 0 (int) — never `print(...)` as a function
// value (Aether rejects `let x = print(...)` with "cannot call non-function
// value '<expression>'"). Side-effecting tests use blocks `{ print(...); 0 }`
// or just return the result.
// =============================================================================

// --- Imports ---
// When concatenated, this is a no-op (sema.ae + parser.ae bindings are
// already in scope). When run via the module loader, it pulls in `check`
// + `parse` + `toks` from the bootstrap files.
import { check, parse, toks, typeToString, typeEq } from "./sema.ae";

// --- Test driver ---
struct Stats { passed: int, failed: int }

fn checkStat(st: Stats, cond: int, msg: string) -> int {
  if cond {
    st.passed = st.passed + 1;
  } else {
    st.failed = st.failed + 1;
    print("FAIL: " + msg);
  };
  0
}

fn checkEq(st: Stats, actual: int, expected: int, msg: string) -> int {
  if actual == expected {
    st.passed = st.passed + 1;
  } else {
    st.failed = st.failed + 1;
    print("FAIL: " + msg + " (expected " + str(expected) + ", got " + str(actual) + ")");
  };
  0
}

fn checkEqStr(st: Stats, actual: string, expected: string, msg: string) -> int {
  if actual == expected {
    st.passed = st.passed + 1;
  } else {
    st.failed = st.failed + 1;
    print("FAIL: " + msg + " (expected '" + expected + "', got '" + actual + "')");
  };
  0
}

// --- Helpers: parse a source string and run check, return error count ---
// We use the parser's `parse(toks([...]))` to build the AST from a token
// stream, then `check(program)` to run sema.

// ParseResult -> CheckResult.errors.length
fn C(parts: [string]) -> int {
  let r = parse(toks(parts));
  let cr = check(r.program);
  len(cr.errors)
}

// ParseResult -> first error message (or "" if no errors)
fn C_first(parts: [string]) -> string {
  let r = parse(toks(parts));
  let cr = check(r.program);
  if len(cr.errors) == 0 { "" }
  else { cr.errors[0].message }
}

// =====================================================================
// Tests: literals & basic let inference
// =====================================================================

fn test_let_int(st: Stats) -> int {
  // `let x = 42;` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Int", "42", "Punct", ";"]), 0, "let-int: 0 errors");
  0
}

fn test_let_float(st: Stats) -> int {
  // `let x = 3.14;` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Float", "3.14", "Punct", ";"]), 0, "let-float: 0 errors");
  0
}

fn test_let_bool(st: Stats) -> int {
  // `let x = true;` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Keyword", "true", "Punct", ";"]), 0, "let-bool: 0 errors");
  0
}

fn test_let_string(st: Stats) -> int {
  // `let x = "hi";` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "String", "hi", "Punct", ";"]), 0, "let-string: 0 errors");
  0
}

fn test_let_char(st: Stats) -> int {
  // `let x = 'a';` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Char", "a", "Punct", ";"]), 0, "let-char: 0 errors");
  0
}

fn test_let_unit(st: Stats) -> int {
  // `let x = ();` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Punct", "(", "Punct", ")", "Punct", ";"]), 0, "let-unit: 0 errors");
  0
}

fn test_let_annotated_int(st: Stats) -> int {
  // `let x: int = 42;` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", ":", "Ident", "int", "Punct", "=", "Int", "42", "Punct", ";"]), 0, "let-annot-int: 0 errors");
  0
}

fn test_let_annotated_float(st: Stats) -> int {
  // `let x: float = 3.14;` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", ":", "Ident", "float", "Punct", "=", "Float", "3.14", "Punct", ";"]), 0, "let-annot-float: 0 errors");
  0
}

fn test_let_annotated_bool(st: Stats) -> int {
  // `let x: bool = true;` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", ":", "Ident", "bool", "Punct", "=", "Keyword", "true", "Punct", ";"]), 0, "let-annot-bool: 0 errors");
  0
}

fn test_let_widening_int_to_float(st: Stats) -> int {
  // `let x: float = 42;` -> 0 errors (int widens to float)
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", ":", "Ident", "float", "Punct", "=", "Int", "42", "Punct", ";"]), 0, "widening: 0 errors");
  0
}

fn test_let_mismatch_float_to_int(st: Stats) -> int {
  // `let x: int = 3.14;` -> 1 error
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", ":", "Ident", "int", "Punct", "=", "Float", "3.14", "Punct", ";"]), 1, "mismatch-float-int: 1 error");
  0
}

fn test_let_mismatch_string_to_float(st: Stats) -> int {
  // `let y: float = "hi";` -> 1 error
  let n = C(["Keyword", "let", "Ident", "y", "Punct", ":", "Ident", "float", "Punct", "=", "String", "hi", "Punct", ";"]);
  checkEq(st, n, 1, "mismatch-string-float: 1 error");
  // Also check the error message
  let msg = C_first(["Keyword", "let", "Ident", "y", "Punct", ":", "Ident", "float", "Punct", "=", "String", "hi", "Punct", ";"]);
  checkEqStr(st, msg, "expected float, found string", "mismatch-string-float: message");
  0
}

fn test_let_mismatch_int_to_string(st: Stats) -> int {
  // `let s: string = 42;` -> 1 error
  checkEq(st, C(["Keyword", "let", "Ident", "s", "Punct", ":", "Ident", "string", "Punct", "=", "Int", "42", "Punct", ";"]), 1, "mismatch-int-string: 1 error");
  0
}

fn test_let_undefined_name(st: Stats) -> int {
  // `let x = undefined_var;` -> 1 error "undefined name 'undefined_var'"
  let parts = ["Keyword", "let", "Ident", "x", "Punct", "=", "Ident", "undefined_var", "Punct", ";"];
  let n = C(parts);
  checkEq(st, n, 1, "undefined-name: 1 error");
  let msg = C_first(parts);
  checkEqStr(st, msg, "undefined name 'undefined_var'", "undefined-name: message");
  0
}

// =====================================================================
// Tests: function declarations
// =====================================================================

fn test_fn_decl_simple(st: Stats) -> int {
  // `fn f() -> int { 42 }` -> 0 errors
  let parts = [
    "Keyword", "fn", "Ident", "f", "Punct", "(", "Punct", ")", "Punct", "->", "Ident", "int",
    "Punct", "{", "Int", "42", "Punct", "}"
  ];
  checkEq(st, C(parts), 0, "fn-simple: 0 errors");
  0
}

fn test_fn_decl_with_params(st: Stats) -> int {
  // `fn add(x: int, y: int) -> int { x + y }` -> 0 errors
  let parts = [
    "Keyword", "fn", "Ident", "add", "Punct", "(",
      "Ident", "x", "Punct", ":", "Ident", "int", "Punct", ",",
      "Ident", "y", "Punct", ":", "Ident", "int",
    "Punct", ")", "Punct", "->", "Ident", "int",
    "Punct", "{", "Ident", "x", "Punct", "+", "Ident", "y", "Punct", "}"
  ];
  checkEq(st, C(parts), 0, "fn-params: 0 errors");
  0
}

fn test_fn_decl_wrong_return(st: Stats) -> int {
  // `fn f() -> int { "hi" }` -> 1 error
  let parts = [
    "Keyword", "fn", "Ident", "f", "Punct", "(", "Punct", ")", "Punct", "->", "Ident", "int",
    "Punct", "{", "String", "hi", "Punct", "}"
  ];
  checkEq(st, C(parts), 1, "fn-wrong-return: 1 error");
  0
}

fn test_fn_decl_no_return(st: Stats) -> int {
  // `fn f() { 42; }` -> 0 errors (no return type, body returns unit)
  let parts = [
    "Keyword", "fn", "Ident", "f", "Punct", "(", "Punct", ")",
    "Punct", "{", "Int", "42", "Punct", ";", "Punct", "}"
  ];
  checkEq(st, C(parts), 0, "fn-no-return: 0 errors");
  0
}

fn test_fn_call_args(st: Stats) -> int {
  // `fn id(x: int) -> int { x } let y = id(42);` -> 0 errors
  let parts = [
    "Keyword", "fn", "Ident", "id", "Punct", "(",
      "Ident", "x", "Punct", ":", "Ident", "int",
    "Punct", ")", "Punct", "->", "Ident", "int",
    "Punct", "{", "Ident", "x", "Punct", "}",
    "Keyword", "let", "Ident", "y", "Punct", "=", "Ident", "id", "Punct", "(", "Int", "42", "Punct", ")", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "fn-call-args: 0 errors");
  0
}

fn test_fn_call_wrong_arg(st: Stats) -> int {
  // `fn id(x: int) -> int { x } let y = id("hi");` -> 1 error
  let parts = [
    "Keyword", "fn", "Ident", "id", "Punct", "(",
      "Ident", "x", "Punct", ":", "Ident", "int",
    "Punct", ")", "Punct", "->", "Ident", "int",
    "Punct", "{", "Ident", "x", "Punct", "}",
    "Keyword", "let", "Ident", "y", "Punct", "=", "Ident", "id", "Punct", "(", "String", "hi", "Punct", ")", "Punct", ";"
  ];
  checkEq(st, C(parts), 1, "fn-call-wrong-arg: 1 error");
  0
}

fn test_fn_call_arity(st: Stats) -> int {
  // `fn f(x: int) -> int { x } let y = f(1, 2);` -> 1 error (too many args)
  let parts = [
    "Keyword", "fn", "Ident", "f", "Punct", "(",
      "Ident", "x", "Punct", ":", "Ident", "int",
    "Punct", ")", "Punct", "->", "Ident", "int",
    "Punct", "{", "Ident", "x", "Punct", "}",
    "Keyword", "let", "Ident", "y", "Punct", "=", "Ident", "f", "Punct", "(", "Int", "1", "Punct", ",", "Int", "2", "Punct", ")", "Punct", ";"
  ];
  checkEq(st, C(parts), 1, "fn-call-arity: 1 error");
  0
}

fn test_fn_recursive(st: Stats) -> int {
  // `fn fact(n: int) -> int { if n == 0 { 1 } else { n * fact(n - 1) } }` -> 0 errors
  let parts = [
    "Keyword", "fn", "Ident", "fact", "Punct", "(",
      "Ident", "n", "Punct", ":", "Ident", "int",
    "Punct", ")", "Punct", "->", "Ident", "int",
    "Punct", "{",
      "Keyword", "if", "Ident", "n", "Punct", "==", "Int", "0", "Punct", "{", "Int", "1", "Punct", "}",
      "Keyword", "else", "Punct", "{",
        "Ident", "n", "Punct", "*", "Ident", "fact", "Punct", "(", "Ident", "n", "Punct", "-", "Int", "1", "Punct", ")",
      "Punct", "}",
    "Punct", "}"
  ];
  checkEq(st, C(parts), 0, "fn-recursive: 0 errors");
  0
}

// =====================================================================
// Tests: generics
// =====================================================================

fn test_generic_id(st: Stats) -> int {
  // `fn id<T>(x: T) -> T { x } let y = id(42);` -> 0 errors
  let parts = [
    "Keyword", "fn", "Ident", "id", "Punct", "<", "Ident", "T", "Punct", ">", "Punct", "(",
      "Ident", "x", "Punct", ":", "Ident", "T",
    "Punct", ")", "Punct", "->", "Ident", "T",
    "Punct", "{", "Ident", "x", "Punct", "}",
    "Keyword", "let", "Ident", "y", "Punct", "=", "Ident", "id", "Punct", "(", "Int", "42", "Punct", ")", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "generic-id: 0 errors");
  0
}

fn test_generic_id_explicit_type(st: Stats) -> int {
  // `fn id<T>(x: T) -> T { x } let y = id<int>(42);` -> 0 errors
  let parts = [
    "Keyword", "fn", "Ident", "id", "Punct", "<", "Ident", "T", "Punct", ">", "Punct", "(",
      "Ident", "x", "Punct", ":", "Ident", "T",
    "Punct", ")", "Punct", "->", "Ident", "T",
    "Punct", "{", "Ident", "x", "Punct", "}",
    "Keyword", "let", "Ident", "y", "Punct", "=", "Ident", "id", "Punct", "<", "Ident", "int", "Punct", ">", "Punct", "(", "Int", "42", "Punct", ")", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "generic-id-explicit: 0 errors");
  0
}

fn test_generic_pair(st: Stats) -> int {
  // `fn pair<T, U>(x: T, y: U) -> T { x } let z = pair(1, "hi");` -> 0 errors
  let parts = [
    "Keyword", "fn", "Ident", "pair", "Punct", "<", "Ident", "T", "Punct", ",", "Ident", "U", "Punct", ">", "Punct", "(",
      "Ident", "x", "Punct", ":", "Ident", "T", "Punct", ",",
      "Ident", "y", "Punct", ":", "Ident", "U",
    "Punct", ")", "Punct", "->", "Ident", "T",
    "Punct", "{", "Ident", "x", "Punct", "}",
    "Keyword", "let", "Ident", "z", "Punct", "=", "Ident", "pair", "Punct", "(", "Int", "1", "Punct", ",", "String", "hi", "Punct", ")", "Punct", ";"
  ];
  checkEq(st, C(parts), 0, "generic-pair: 0 errors");
  0
}

// =====================================================================
// Tests: arithmetic
// =====================================================================

fn test_arith_add(st: Stats) -> int {
  // `let x = 1 + 2;` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Int", "1", "Punct", "+", "Int", "2", "Punct", ";"]), 0, "arith-add: 0 errors");
  0
}

fn test_arith_float(st: Stats) -> int {
  // `let x = 1.0 + 2;` -> 0 errors (int widens to float)
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Float", "1.0", "Punct", "+", "Int", "2", "Punct", ";"]), 0, "arith-float: 0 errors");
  0
}

fn test_arith_string_concat(st: Stats) -> int {
  // `let x = "a" + "b";` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "String", "a", "Punct", "+", "String", "b", "Punct", ";"]), 0, "arith-string: 0 errors");
  0
}

fn test_arith_int_string(st: Stats) -> int {
  // `let x = 1 + "hi";` -> 1 error
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Int", "1", "Punct", "+", "String", "hi", "Punct", ";"]), 1, "arith-int-string: 1 error");
  0
}

fn test_arith_mod(st: Stats) -> int {
  // `let x = 10 % 3;` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Int", "10", "Punct", "%", "Int", "3", "Punct", ";"]), 0, "arith-mod: 0 errors");
  0
}

// =====================================================================
// Tests: comparisons
// =====================================================================

fn test_cmp_lt(st: Stats) -> int {
  // `let x = 1 < 2;` -> 0 errors (bool result)
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Int", "1", "Punct", "<", "Int", "2", "Punct", ";"]), 0, "cmp-lt: 0 errors");
  0
}

fn test_cmp_eq(st: Stats) -> int {
  // `let x = 1 == 2;` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Int", "1", "Punct", "==", "Int", "2", "Punct", ";"]), 0, "cmp-eq: 0 errors");
  0
}

fn test_cmp_mismatch(st: Stats) -> int {
  // `let x = 1 < "hi";` -> 1 error
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Int", "1", "Punct", "<", "String", "hi", "Punct", ";"]), 1, "cmp-mismatch: 1 error");
  0
}

// =====================================================================
// Tests: logical operators
// =====================================================================

fn test_logical_and(st: Stats) -> int {
  // `let x = true && false;` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Keyword", "true", "Punct", "&&", "Keyword", "false", "Punct", ";"]), 0, "logical-and: 0 errors");
  0
}

fn test_logical_or(st: Stats) -> int {
  // `let x = true || false;` -> 0 errors
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Keyword", "true", "Punct", "||", "Keyword", "false", "Punct", ";"]), 0, "logical-or: 0 errors");
  0
}

fn test_logical_mismatch(st: Stats) -> int {
  // `let x = 1 && 2;` -> 1 error (left must be bool)
  checkEq(st, C(["Keyword", "let", "Ident", "x", "Punct", "=", "Int", "1", "Punct", "&&", "Int", "2", "Punct", ";"]), 1, "logical-mismatch: 1 error");
  0
}

