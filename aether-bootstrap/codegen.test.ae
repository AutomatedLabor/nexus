fn test_loadbool_false(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opLoadBool(0, 0)]));
  checkEq(st, code[0].op, OP_LOAD_BOOL, "loadbool-false: op");
  checkEq(st, code[0].imm, 0, "loadbool-false: imm=0");
  0
}

fn test_loadunit(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opLoadUnit(0)]));
  checkEq(st, code[0].op, OP_LOAD_UNIT, "loadunit: op");
  checkEq(st, code[0].a, 0, "loadunit: a=0");
  0
}

fn test_string_interning(st: Stats) -> int {
  // Two LoadString ops with the same string should share the string table index.
  let ops = [opLoadString(0, "x"), opLoadString(1, "x")];
  let f = compileMockFn(mockFn("f", ops));
  checkEq(st, len(f.strings), 1, "intern: 1 string");
  checkStrEq(st, f.strings[0], "x", "intern: string is 'x'");
  checkEq(st, f.code[0].imm, 0, "intern: first imm=0");
  checkEq(st, f.code[1].imm, 0, "intern: second imm=0 (deduped)");
  0
}

fn test_string_interning_distinct(st: Stats) -> int {
  let ops = [opLoadString(0, "a"), opLoadString(1, "b")];
  let f = compileMockFn(mockFn("f", ops));
  checkEq(st, len(f.strings), 2, "intern-distinct: 2 strings");
  checkEq(st, f.code[0].imm, 0, "intern-distinct: first imm=0");
  checkEq(st, f.code[1].imm, 1, "intern-distinct: second imm=1");
  0
}

fn test_float_interning(st: Stats) -> int {
  let ops = [opLoadFloat(0, 2.5), opLoadFloat(1, 2.5)];
  let f = compileMockFn(mockFn("f", ops));
  checkEq(st, len(f.constants), 1, "intern-float: 1 const");
  checkEq(st, f.code[0].imm, 0, "intern-float: first imm=0");
  checkEq(st, f.code[1].imm, 0, "intern-float: second imm=0 (deduped)");
  0
}

