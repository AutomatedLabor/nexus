// =============================================================================
// 6. Control flow ops
// =============================================================================

fn test_jmp(st: Stats) -> int {
  // Two blocks: block 0 has Jmp(1); block 1 has Return(0).
  let b0 = IrBlock { id: 0, instrs: [opJmp(1)] };
  let b1 = IrBlock { id: 1, instrs: [opReturn(0)] };
  let code = compileMock(mockFnBlocks("f", [b0, b1]));
  checkEq(st, len(code), 2, "jmp: 2 instrs");
  checkEq(st, code[0].op, OP_JMP, "jmp: op");
  // Block 1 starts at instr index 1.
  checkEq(st, code[0].imm, 1, "jmp: imm=1 (block 1 offset)");
  checkEq(st, code[1].op, OP_RETURN, "jmp: block1 has Return");
  0
}

fn test_jmpif(st: Stats) -> int {
  let b0 = IrBlock { id: 0, instrs: [opJmpIf(2, 1)] };
  let b1 = IrBlock { id: 1, instrs: [opReturn(0)] };
  let code = compileMock(mockFnBlocks("f", [b0, b1]));
  checkEq(st, code[0].op, OP_JMPIF, "jmpif: op");
  checkEq(st, code[0].a, 2, "jmpif: a=cond=2");
  checkEq(st, code[0].imm, 1, "jmpif: imm=1");
  0
}

fn test_jmpifnot(st: Stats) -> int {
  let b0 = IrBlock { id: 0, instrs: [opJmpIfNot(2, 1)] };
  let b1 = IrBlock { id: 1, instrs: [opReturn(0)] };
  let code = compileMock(mockFnBlocks("f", [b0, b1]));
  checkEq(st, code[0].op, OP_JMPIFNOT, "jmpifnot: op");
  checkEq(st, code[0].a, 2, "jmpifnot: a=cond=2");
  checkEq(st, code[0].imm, 1, "jmpifnot: imm=1");
  0
}

fn test_return(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opReturn(3)]));
  checkEq(st, code[0].op, OP_RETURN, "return: op");
  checkEq(st, code[0].a, 3, "return: a=3");
  0
}

fn test_three_block_jmp(st: Stats) -> int {
  // Block 0: Jmp(2); Block 1: Return(0); Block 2: Return(1).
  // Code layout: [Jmp, Return(0), Return(1)] but block order is [0, 1, 2].
  // Block 0 offset = 0, Block 1 offset = 1, Block 2 offset = 2.
  let b0 = IrBlock { id: 0, instrs: [opJmp(2)] };
  let b1 = IrBlock { id: 1, instrs: [opReturn(0)] };
  let b2 = IrBlock { id: 2, instrs: [opReturn(1)] };
  let code = compileMock(mockFnBlocks("f", [b0, b1, b2]));
  checkEq(st, len(code), 3, "three-block: 3 instrs");
  checkEq(st, code[0].imm, 2, "three-block: jmp imm=2 (block 2 offset)");
  0
}

// =============================================================================
// 7. Call ops
// =============================================================================

fn test_call(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opCall(0, 1, [2, 3])]));
  checkEq(st, code[0].op, OP_CALL, "call: op");
  checkEq(st, code[0].a, 0, "call: a=dest=0");
  checkEq(st, code[0].b, 1, "call: b=fn=1");
  check(st, code[0].regs >= 0, "call: regs index set");
  0
}

fn test_call_reglist_interning(st: Stats) -> int {
  let ops = [opCall(0, 1, [2, 3]), opCall(4, 1, [2, 3])];
  let f = compileMockFn(mockFn("f", ops));
  // Both calls have the same args [2, 3], so they share the regList index.
  checkEq(st, f.code[0].regs, f.code[1].regs, "call-reglist: same regList idx");
  checkEq(st, len(f.regLists), 1, "call-reglist: 1 regList");
  0
}

fn test_callbuiltin(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opCallBuiltin(0, "len", [1])]));
  checkEq(st, code[0].op, OP_CALLBUILTIN, "callbuiltin: op");
  checkEq(st, code[0].a, 0, "callbuiltin: a=dest=0");
  check(st, code[0].imm >= 0, "callbuiltin: imm (string idx) set");
  0
}

fn test_callbuiltin_name_interning(st: Stats) -> int {
  let ops = [opCallBuiltin(0, "len", [1]), opCallBuiltin(2, "len", [3])];
  let f = compileMockFn(mockFn("f", ops));
  checkEq(st, f.code[0].imm, f.code[1].imm, "callbuiltin-intern: same name idx");
  checkStrEq(st, f.strings[f.code[0].imm], "len", "callbuiltin-intern: name is 'len'");
  0
}

fn test_callclosure(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opCallClosure(0, 1, [2])]));
  checkEq(st, code[0].op, OP_CALLCLOSURE, "callclosure: op");
  checkEq(st, code[0].a, 0, "callclosure: a=dest=0");
  checkEq(st, code[0].b, 1, "callclosure: b=closure=1");
  0
}

