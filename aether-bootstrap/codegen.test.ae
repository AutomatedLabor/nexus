// =============================================================================
// 9. Closure / box ops
// =============================================================================

fn test_makeclosure(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opMakeClosure(0, 1, [2, 3])]));
  checkEq(st, code[0].op, OP_MAKECLOSURE, "makeclosure: op");
  checkEq(st, code[0].a, 0, "makeclosure: a=dest=0");
  checkEq(st, code[0].imm, 1, "makeclosure: imm=funcIdx=1");
  check(st, code[0].regs >= 0, "makeclosure: regs idx set");
  0
}

fn test_makeclosure_caps(st: Stats) -> int {
  let f = compileMockFn(mockFn("f", [opMakeClosure(0, 1, [2, 3])]));
  // The regList at index `regs` should be [2, 3].
  let rl = f.regLists[f.code[0].regs];
  checkEq(st, len(rl), 2, "makeclosure-caps: 2 captures");
  checkEq(st, rl[0], 2, "makeclosure-caps: first cap=2");
  checkEq(st, rl[1], 3, "makeclosure-caps: second cap=3");
  0
}

fn test_getupvalue(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opGetUpvalue(0, 2)]));
  checkEq(st, code[0].op, OP_GETUPVALUE, "getupvalue: op");
  checkEq(st, code[0].a, 0, "getupvalue: a=dest=0");
