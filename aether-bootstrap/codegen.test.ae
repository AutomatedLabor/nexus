fn test_allocstruct(st: Stats) -> int {
  let fields = [IrField { name: "x", reg: 1 }, IrField { name: "y", reg: 2 }];
  let code = compileMock(mockFn("f", [opAllocStruct(0, "Point", fields)]));
  checkEq(st, code[0].op, OP_ALLOCSTRUCT, "allocstruct: op");
  checkEq(st, code[0].a, 0, "allocstruct: a=dest=0");
  check(st, code[0].imm >= 0, "allocstruct: imm (name idx) set");
  check(st, code[0].fields >= 0, "allocstruct: fields idx set");
  0
}

fn test_allocstruct_name(st: Stats) -> int {
  let fields = [IrField { name: "x", reg: 1 }];
  let f = compileMockFn(mockFn("f", [opAllocStruct(0, "Foo", fields)]));
  checkStrEq(st, f.strings[f.code[0].imm], "Foo", "allocstruct-name: name is 'Foo'");
  0
}

