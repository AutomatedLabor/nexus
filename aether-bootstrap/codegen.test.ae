// =============================================================================
// 12. Loop detection (Break / Continue → Jmp)
// =============================================================================

fn test_loop_break(st: Stats) -> int {
  // A simple while loop (mirrors IR's lowerWhile structure):
  //   block 0 (entry): Jmp(1)
  //   block 1 (condBlock): JmpIfNot(cond, 4)   ← breakBlock = 4
  //   block 2 (intermediate): Jmp(3)
  //   block 3 (bodyBlock): Break; Jmp(1)   ← back-edge to condBlock 1
  //   block 4 (breakBlock): Return(0)
  // Block layout offsets: b0=0, b1=1, b2=2, b3=3, b4=5.
  // Break should compile to Jmp to block 4's offset (5).
  let b0 = IrBlock { id: 0, instrs: [opJmp(1)] };
  let b1 = IrBlock { id: 1, instrs: [opJmpIfNot(0, 4)] };
  let b2 = IrBlock { id: 2, instrs: [opJmp(3)] };
  let b3 = IrBlock { id: 3, instrs: [opBreak(), opJmp(1)] };
  let b4 = IrBlock { id: 4, instrs: [opReturn(0)] };
  let code = compileMock(mockFnBlocks("f", [b0, b1, b2, b3, b4]));
  let mut found = 0;
  let mut i = 0;
  while i < len(code) {
    if code[i].op == OP_JMP && code[i].imm == 5 { found = 1; i = len(code); };
    i = i + 1;
  }
  check(st, found == 1, "loop-break: Break compiled to Jmp(5)");
  0
}

fn test_loop_continue(st: Stats) -> int {
  // Same loop structure as test_loop_break, but with Continue instead of Break.
  // Continue should jump to condBlock (block 1, offset 1).
  let b0 = IrBlock { id: 0, instrs: [opJmp(1)] };
  let b1 = IrBlock { id: 1, instrs: [opJmpIfNot(0, 4)] };
  let b2 = IrBlock { id: 2, instrs: [opJmp(3)] };
  let b3 = IrBlock { id: 3, instrs: [opContinue(), opJmp(1)] };
  let b4 = IrBlock { id: 4, instrs: [opReturn(0)] };
  let code = compileMock(mockFnBlocks("f", [b0, b1, b2, b3, b4]));
  // Continue should be Jmp to block 1's offset (1).
  let mut found = 0;
  let mut i = 0;
  while i < len(code) {
    if code[i].op == OP_JMP && code[i].imm == 1 { found = 1; i = len(code); };
    i = i + 1;
  }
  check(st, found == 1, "loop-continue: Continue compiled to Jmp(1)");
  0
}

// =============================================================================
// 13. Match table conversion
// =============================================================================

fn test_match_table(st: Stats) -> int {
  // Build an IrFunc with a match table containing one entry.
  // The Match op is in block 0, the arm body is in block 1, the else is in block 2.
  // Match table: [Wildcard entry → block 1, default → block 2]
  let wildEntry = MatchEntry {
    patternKind: "Wildcard", bindName: "", litValue: mkUnit(),
    structName: "", enumName: "", variant: "",
    fieldBindings: [], subregs: [], orPatterns: [], hasRest: 0, target: 1,
  };
  let table = MatchTable { entries: [wildEntry], defaultTarget: 2 };
  let func = IrFunc {
    name: "f", nparams: 0, nlocals: 4,
    blocks: [
      IrBlock { id: 0, instrs: [opMatch(0, 0)] },
      IrBlock { id: 1, instrs: [opReturn(0)] },
      IrBlock { id: 2, instrs: [opReturn(1)] },
    ],
    entry: 0, captures: [], selfReg: -1, isMain: 0, nested: [],
    matchTables: [table],
    strings: [], regLists: [], fieldLists: [], constants: [], matchBindings: [],
  };
  let f = compileMockFn(func);
  checkEq(st, f.code[0].op, OP_MATCH, "match: op");
  checkEq(st, f.code[0].a, 0, "match: a=scrutinee=0");
  checkEq(st, f.code[0].imm, 0, "match: imm=tableIdx=0");
  checkEq(st, len(f.matchTables), 1, "match: 1 table");
  let t = f.matchTables[0];
  // Table has 1 entry (Wildcard) + 1 default (Wildcard).
  checkEq(st, len(t), 2, "match: table has 2 entries (1 + default)");
  checkStrEq(st, t[0].patternKind, "Wildcard", "match: first entry Wildcard");
  // Block 1 is at offset 1 (block 0 has 1 instr: Match).
  checkEq(st, t[0].target, 1, "match: first entry target=1 (block 1 offset)");
  checkEq(st, t[1].target, 2, "match: default target=2 (block 2 offset)");
  0
}

fn test_match_bind_entry(st: Stats) -> int {
  // Match with a Bind entry.
  let bindEntry = MatchEntry {
    patternKind: "Bind", bindName: "x", litValue: mkUnit(),
    structName: "", enumName: "", variant: "",
    fieldBindings: [], subregs: [], orPatterns: [], hasRest: 0, target: 1,
  };
  let table = MatchTable { entries: [bindEntry], defaultTarget: 2 };
  let func = IrFunc {
    name: "f", nparams: 0, nlocals: 4,
    blocks: [
      IrBlock { id: 0, instrs: [opMatch(0, 0)] },
      IrBlock { id: 1, instrs: [opReturn(0)] },
      IrBlock { id: 2, instrs: [opReturn(1)] },
    ],
    entry: 0, captures: [], selfReg: -1, isMain: 0, nested: [],
    matchTables: [table],
    strings: [], regLists: [], fieldLists: [], constants: [],
    matchBindings: [MatchBinding { tableIdx: 0, name: "x", reg: 2 }],
  };
  let f = compileMockFn(func);
  let t = f.matchTables[0];
  checkStrEq(st, t[0].patternKind, "Bind", "match-bind: first entry Bind");
  checkStrEq(st, t[0].bindName, "x", "match-bind: bindName='x'");
  checkEq(st, len(f.matchBindings), 1, "match-bind: 1 binding");
  checkStrEq(st, f.matchBindings[0].name, "x", "match-bind: binding name='x'");
  checkEq(st, f.matchBindings[0].reg, 2, "match-bind: binding reg=2");
  0
}

fn test_match_lit_entry(st: Stats) -> int {
  let litEntry = MatchEntry {
    patternKind: "Lit", bindName: "", litValue: mkInt(42),
    structName: "", enumName: "", variant: "",
    fieldBindings: [], subregs: [], orPatterns: [], hasRest: 0, target: 1,
  };
  let table = MatchTable { entries: [litEntry], defaultTarget: 2 };
  let func = IrFunc {
    name: "f", nparams: 0, nlocals: 4,
    blocks: [
      IrBlock { id: 0, instrs: [opMatch(0, 0)] },
      IrBlock { id: 1, instrs: [opReturn(0)] },
      IrBlock { id: 2, instrs: [opReturn(1)] },
    ],
    entry: 0, captures: [], selfReg: -1, isMain: 0, nested: [],
    matchTables: [table],
    strings: [], regLists: [], fieldLists: [], constants: [], matchBindings: [],
  };
  let f = compileMockFn(func);
  let t = f.matchTables[0];
  checkStrEq(st, t[0].patternKind, "Lit", "match-lit: first entry Lit");
  checkEq(st, t[0].litValue.ival, 42, "match-lit: litValue=42");
  0
}

// =============================================================================
// 14. Module-level: entry function selection
// =============================================================================

fn test_entry_main(st: Stats) -> int {
  // Two funcs: foo (isMain=0) and <main> (isMain=1). Entry should be 1.
  let foo = mockFn("foo", [opReturn(0)]);
  let main_ = IrFunc {
    name: "<main>", nparams: 0, nlocals: 4,
    blocks: [IrBlock { id: 0, instrs: [opReturn(0)] }],
    entry: 0, captures: [], selfReg: -1, isMain: 1, nested: [],
    matchTables: [], strings: [], regLists: [], fieldLists: [],
    constants: [], matchBindings: [],
  };
  let prog = IrProgram { funcs: [foo, main_], globals: [], entry: 1 };
  let mod_ = compileToBytecode(prog);
  checkEq(st, mod_.entry, 1, "entry-main: entry=1");
  checkEq(st, len(mod_.funcs), 2, "entry-main: 2 funcs");
  checkStrEq(st, mod_.funcs[1].name, "<main>", "entry-main: func 1 name=<main>");
  0
}

fn test_entry_no_main(st: Stats) -> int {
  // No main; entry should default to 0.
  let foo = mockFn("foo", [opReturn(0)]);
  let prog = mockProg(foo);
  let mod_ = compileToBytecode(prog);
  checkEq(st, mod_.entry, 0, "entry-no-main: entry=0");
  0
}

// =============================================================================
// 15. opNameToInt tests
// =============================================================================

fn test_opname_to_int(st: Stats) -> int {
  checkEq(st, opNameToInt("LoadInt"), OP_LOAD_INT, "opname: LoadInt");
  checkEq(st, opNameToInt("Add"), OP_ADD, "opname: Add");
  checkEq(st, opNameToInt("Sub"), OP_SUB, "opname: Sub");
  checkEq(st, opNameToInt("Mul"), OP_MUL, "opname: Mul");
  checkEq(st, opNameToInt("Div"), OP_DIV, "opname: Div");
  checkEq(st, opNameToInt("Eq"), OP_EQ, "opname: Eq");
  checkEq(st, opNameToInt("Lt"), OP_LT, "opname: Lt");
  checkEq(st, opNameToInt("Gt"), OP_GT, "opname: Gt");
  checkEq(st, opNameToInt("Jmp"), OP_JMP, "opname: Jmp");
  checkEq(st, opNameToInt("JmpIf"), OP_JMPIF, "opname: JmpIf");
  checkEq(st, opNameToInt("JmpIfNot"), OP_JMPIFNOT, "opname: JmpIfNot");
  checkEq(st, opNameToInt("Return"), OP_RETURN, "opname: Return");
  checkEq(st, opNameToInt("Call"), OP_CALL, "opname: Call");
  checkEq(st, opNameToInt("CallBuiltin"), OP_CALLBUILTIN, "opname: CallBuiltin");
  checkEq(st, opNameToInt("CallClosure"), OP_CALLCLOSURE, "opname: CallClosure");
  checkEq(st, opNameToInt("Match"), OP_MATCH, "opname: Match");
  checkEq(st, opNameToInt("Print"), OP_PRINT, "opname: Print");
  checkEq(st, opNameToInt("Panic"), OP_PANIC, "opname: Panic");
  checkEq(st, opNameToInt("MakeClosure"), OP_MAKECLOSURE, "opname: MakeClosure");
  checkEq(st, opNameToInt("LoadGlobal"), OP_LOADGLOBAL, "opname: LoadGlobal");
  0
}

// =============================================================================
// 16. Multi-op function
// =============================================================================

fn test_multi_op(st: Stats) -> int {
  // A function with several ops in sequence.
  let ops = [
    opLoadInt(0, 10),
    opLoadInt(1, 20),
    opBin("Add", 2, 0, 1),
    opReturn(2),
  ];
  let code = compileMock(mockFn("f", ops));
  checkEq(st, len(code), 4, "multi-op: 4 instrs");
  checkEq(st, code[0].op, OP_LOAD_INT, "multi-op: 0=LoadInt");
  checkEq(st, code[1].op, OP_LOAD_INT, "multi-op: 1=LoadInt");
  checkEq(st, code[2].op, OP_ADD, "multi-op: 2=Add");
  checkEq(st, code[3].op, OP_RETURN, "multi-op: 3=Return");
  0
}

// =============================================================================
// Driver: run all tests
// =============================================================================

fn runAllTests() -> int {
  let st = Stats { passed: 0, failed: 0 };

  // Constants
  test_loadint(st);
  test_loadint_zero(st);
  test_loadint_neg(st);
  test_loadfloat(st);
  test_loadstring(st);
  test_loadbool_true(st);
  test_loadbool_false(st);
  test_loadunit(st);
  test_string_interning(st);
  test_string_interning_distinct(st);
  test_float_interning(st);

  // Move
  test_move(st);

  // Arithmetic
  test_add(st);
  test_sub(st);
  test_mul(st);
  test_div(st);
  test_idiv(st);
  test_mod(st);
  test_bitand(st);
  test_bitor(st);
  test_bitxor(st);
  test_shl(st);
  test_shr(st);

  // Comparison
  test_eq(st);
  test_neq(st);
  test_lt(st);
  test_le(st);
  test_gt(st);
  test_ge(st);

  // Unary
  test_neg(st);
  test_not(st);
  test_bitnot(st);

  // Control flow
  test_jmp(st);
  test_jmpif(st);
  test_jmpifnot(st);
  test_return(st);
  test_three_block_jmp(st);

  // Calls
  test_call(st);
  test_call_reglist_interning(st);
  test_callbuiltin(st);
  test_callbuiltin_name_interning(st);
  test_callclosure(st);

  // Memory
  test_allocstruct(st);
  test_allocstruct_name(st);
  test_allocvariant(st);
  test_allocvariant_tag(st);
  test_allocarray(st);
  test_allocmap(st);
  test_allocrange(st);
  test_loadfield(st);
  test_storefield(st);
  test_indexget(st);
  test_indexset(st);
  test_len(st);
  test_push(st);
  test_poparr(st);

  // Closures / boxes
  test_makeclosure(st);
  test_makeclosure_caps(st);
  test_getupvalue(st);
  test_setupvalue(st);
  test_makebox(st);
  test_unbox(st);
  test_setbox(st);

  // Print / cast / panic
  test_print(st);
  test_panic(st);
  test_castint(st);
  test_castfloat(st);
  test_castbool(st);
  test_caststring(st);

  // LoadGlobal
  test_loadglobal(st);

  // Loops
  test_loop_break(st);
  test_loop_continue(st);

  // Match
  test_match_table(st);
  test_match_bind_entry(st);
  test_match_lit_entry(st);

  // Module entry
  test_entry_main(st);
  test_entry_no_main(st);

  // opNameToInt
  test_opname_to_int(st);

  // Multi-op
  test_multi_op(st);

  print("=============================");
  print("Codegen test results:");
  print("  passed: " + str(st.passed));
  print("  failed: " + str(st.failed));
  if st.failed == 0 {
    print("  STATUS: ALL PASS");
  } else {
    print("  STATUS: FAILURES");
  };
  print("=============================");
  assert_eq(st.failed, 0);
  st.passed
}

let npass = runAllTests();
print("Total asserts passed: " + str(npass));
