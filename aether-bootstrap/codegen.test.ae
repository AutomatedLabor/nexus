// =====================================================================
// aether-bootstrap/codegen.test.ae — Tests for the IR → bytecode codegen
// =====================================================================
// 50+ tests that exercise each IrOp kind → expected bytecode Instr.
// Each test builds a mock IrFunc with one block + a single IrOp, runs
// `compileToBytecode`, and asserts on the resulting code array.
//
// Run via:
//   cat ast.ae parser.ae ir.ae codegen.ae codegen.test.ae > /tmp/combined.ae
//   bun /tmp/verify_one.ts /tmp/combined.ae
// =====================================================================

// -----------------------------------------------------------------------------
// Test driver
// -----------------------------------------------------------------------------
struct Stats { passed: int, failed: int }

fn check(st: Stats, cond: int, msg: string) -> int {
  if cond {
    st.passed = st.passed + 1;
  } else {
    st.failed = st.failed + 1;
    print("FAIL: " + msg);
  };
  0
}

fn checkEq(st: Stats, actual: int, expected: int, msg: string) -> int {
  if actual == expected {
    st.passed = st.passed + 1;
  } else {
    st.failed = st.failed + 1;
    print("FAIL: " + msg + " (expected " + str(expected) + ", got " + str(actual) + ")");
  };
  0
}

fn checkStrEq(st: Stats, actual: string, expected: string, msg: string) -> int {
  if actual == expected {
    st.passed = st.passed + 1;
  } else {
    st.failed = st.failed + 1;
    print("FAIL: " + msg + " (expected '" + expected + "', got '" + actual + "')");
  };
  0
}

// -----------------------------------------------------------------------------
// Mock IR builders
// -----------------------------------------------------------------------------

// Build an IrFunc with one block and a list of IrOps.
fn mockFn(name: string, ops: [IrOp]) -> IrFunc {
  let b = IrBlock { id: 0, instrs: ops };
  IrFunc {
    name: name,
    nparams: 0,
    nlocals: 8,
    blocks: [b],
    entry: 0,
    captures: [],
    selfReg: -1,
    isMain: 0,
    nested: [],
    matchTables: [],
    strings: [],
    regLists: [],
    fieldLists: [],
    constants: [],
    matchBindings: [],
  }
}

// Build an IrFunc with multiple blocks (for control-flow tests).
fn mockFnBlocks(name: string, blocks: [IrBlock]) -> IrFunc {
  IrFunc {
    name: name,
    nparams: 0,
    nlocals: 8,
    blocks: blocks,
    entry: 0,
    captures: [],
    selfReg: -1,
    isMain: 0,
    nested: [],
    matchTables: [],
    strings: [],
    regLists: [],
    fieldLists: [],
    constants: [],
    matchBindings: [],
  }
}

// Wrap a single IrFunc in an IrProgram.
fn mockProg(func: IrFunc) -> IrProgram {
  IrProgram { funcs: [func], globals: [], entry: 0 }
}

// Compile a mock IrFunc and return its code array.
fn compileMock(func: IrFunc) -> [Instr] {
  let prog = mockProg(func);
  let mod_ = compileToBytecode(prog);
  mod_.funcs[0].code
}

// Compile a mock IrFunc and return the BytecodeFunc (for inspecting side tables).
fn compileMockFn(func: IrFunc) -> BytecodeFunc {
  let prog = mockProg(func);
  let mod_ = compileToBytecode(prog);
  mod_.funcs[0]
}

// =============================================================================
// 1. Constant ops
// =============================================================================

fn test_loadint(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opLoadInt(3, 42)]));
  checkEq(st, len(code), 1, "loadint: 1 instr");
  checkEq(st, code[0].op, OP_LOAD_INT, "loadint: op");
  checkEq(st, code[0].a, 3, "loadint: a=3");
  checkEq(st, code[0].imm, 42, "loadint: imm=42");
  0
}

fn test_loadint_zero(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opLoadInt(0, 0)]));
  checkEq(st, code[0].op, OP_LOAD_INT, "loadint-zero: op");
  checkEq(st, code[0].imm, 0, "loadint-zero: imm=0");
  0
}

fn test_loadint_neg(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opLoadInt(2, -100)]));
  checkEq(st, code[0].op, OP_LOAD_INT, "loadint-neg: op");
  checkEq(st, code[0].imm, -100, "loadint-neg: imm=-100");
  0
}

fn test_loadfloat(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opLoadFloat(1, 3.14)]));
  checkEq(st, code[0].op, OP_LOAD_FLOAT, "loadfloat: op");
  checkEq(st, code[0].a, 1, "loadfloat: a=1");
  0
}

fn test_loadstring(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opLoadString(2, "hello")]));
  checkEq(st, code[0].op, OP_LOAD_STRING, "loadstring: op");
  checkEq(st, code[0].a, 2, "loadstring: a=2");
  0
}

fn test_loadbool_true(st: Stats) -> int {
  let code = compileMock(mockFn("f", [opLoadBool(0, 1)]));
  checkEq(st, code[0].op, OP_LOAD_BOOL, "loadbool-true: op");
  checkEq(st, code[0].imm, 1, "loadbool-true: imm=1");
  0
