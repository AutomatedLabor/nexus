// =====================================================================
// aether-bootstrap/ir.ae — Aether IR + AST→IR lowering (bootstrap part 4/7)
// Mirrors aether/core/ir/ir.ts.  Pure Aether; runs on the host tree-walker.
// =====================================================================
//
// Public surface
// --------------
//   pub fn lowerToIr(program: Node) -> IrProgram
//   pub fn mkInt(v: int) -> Value
//   pub fn mkFloat(v: float) -> Value
//   pub fn mkBool(v: int) -> Value
//   pub fn mkStr(v: string) -> Value
//   pub fn mkUnit() -> Value
//   pub fn mkArray(items: [Value]) -> Value
//   pub fn mkStruct(name: string, fields: [VField]) -> Value
//   pub fn mkVariant(enumName: string, variant: string, data: [Value]) -> Value
//   pub fn mkClosure(fnIdx: int, ups: [Value]) -> Value
//   pub fn mkRange(start: int, end: int, step: int) -> Value
//   pub fn mkMap(pairs: [KVP]) -> Value
//   pub fn mkBox(v: Value) -> Value
//
// Design notes
// ------------
// - Each IrFunc has a flat list of basic blocks; jumps reference block IDs.
//   The codegen flattens blocks to instr indices.
// - Each block ends in a terminator (Jmp/JmpIf/JmpIfNot/Return/Match).
// - Register allocation is simple: every binding gets a fresh vreg.
// - Match: lowering builds a MatchTable per match expr; the IrOp "Match"
//   references it by index into IrFunc.matchTables.
// - Self-reference: each non-main function has a `selfReg`. When a closure
//   is called, the VM writes the closure value into `selfReg`. References
//   to the function's own name resolve to `selfReg`.
// - Closures: nested fns capture enclosing variables as upvalues. Captured
//   variables are wrapped in Boxes (MakeBox) at declaration time so they're
//   shared by reference. The MakeClosure op carries capture registers.
// =====================================================================

// -----------------------------------------------------------------------------
// Value representation — tagged struct (mirrors the TS VM's tagged Value).
// -----------------------------------------------------------------------------

struct Value {
  tag: string,         // "int" | "float" | "bool" | "string" | "unit" | "null" | "array" | "map" | "struct" | "variant" | "closure" | "native" | "range" | "box"
  ival: int,           // int value, bool (0/1), range start, closure fnIdx
  fval: float,         // float value
  sval: string,        // string value, native name, struct/enum name
  arr: [Value],        // array elements, variant data, closure upvalues, box contents
  pairs: [KVP],        // map entries
  fields: [VField],    // struct fields
  vname: string,       // variant name
  rangeEnd: int,       // range end
  rangeStep: int,      // range step
}

struct KVP { key: Value, val: Value }
struct VField { name: string, val: Value }

// Value constructors. Each fills all fields with sentinels for safety.
pub fn mkInt(v: int) -> Value {
  Value { tag: "int", ival: v, fval: 0.0, sval: "", arr: [], pairs: [], fields: [], vname: "", rangeEnd: 0, rangeStep: 1 }
}
pub fn mkFloat(v: float) -> Value {
  Value { tag: "float", ival: 0, fval: v, sval: "", arr: [], pairs: [], fields: [], vname: "", rangeEnd: 0, rangeStep: 1 }
}
pub fn mkBool(v: int) -> Value {
  Value { tag: "bool", ival: v, fval: 0.0, sval: "", arr: [], pairs: [], fields: [], vname: "", rangeEnd: 0, rangeStep: 1 }
}
pub fn mkStr(v: string) -> Value {
  Value { tag: "string", ival: 0, fval: 0.0, sval: v, arr: [], pairs: [], fields: [], vname: "", rangeEnd: 0, rangeStep: 1 }
}
pub fn mkUnit() -> Value {
  Value { tag: "unit", ival: 0, fval: 0.0, sval: "", arr: [], pairs: [], fields: [], vname: "", rangeEnd: 0, rangeStep: 1 }
}
pub fn mkNull() -> Value {
  Value { tag: "null", ival: 0, fval: 0.0, sval: "", arr: [], pairs: [], fields: [], vname: "", rangeEnd: 0, rangeStep: 1 }
}
pub fn mkArray(items: [Value]) -> Value {
  Value { tag: "array", ival: 0, fval: 0.0, sval: "", arr: items, pairs: [], fields: [], vname: "", rangeEnd: 0, rangeStep: 1 }
}
pub fn mkStructN(name: string, fields: [VField]) -> Value {
  Value { tag: "struct", ival: 0, fval: 0.0, sval: name, arr: [], pairs: [], fields: fields, vname: "", rangeEnd: 0, rangeStep: 1 }
}
pub fn mkVariant(enumName: string, variant: string, data: [Value]) -> Value {
  Value { tag: "variant", ival: 0, fval: 0.0, sval: enumName, arr: data, pairs: [], fields: [], vname: variant, rangeEnd: 0, rangeStep: 1 }
}
pub fn mkClosure(fnIdx: int, ups: [Value]) -> Value {
  Value { tag: "closure", ival: fnIdx, fval: 0.0, sval: "", arr: ups, pairs: [], fields: [], vname: "", rangeEnd: 0, rangeStep: 1 }
}
pub fn mkNative(name: string) -> Value {
  Value { tag: "native", ival: 0, fval: 0.0, sval: name, arr: [], pairs: [], fields: [], vname: "", rangeEnd: 0, rangeStep: 1 }
}
pub fn mkRange(start: int, end: int, step: int) -> Value {
  Value { tag: "range", ival: start, fval: 0.0, sval: "", arr: [], pairs: [], fields: [], vname: "", rangeEnd: end, rangeStep: step }
}
pub fn mkMapV(pairs: [KVP]) -> Value {
  Value { tag: "map", ival: 0, fval: 0.0, sval: "", arr: [], pairs: pairs, fields: [], vname: "", rangeEnd: 0, rangeStep: 1 }
}
pub fn mkBox(v: Value) -> Value {
  Value { tag: "box", ival: 0, fval: 0.0, sval: "", arr: [v], pairs: [], fields: [], vname: "", rangeEnd: 0, rangeStep: 1 }
}

// Truthiness — matches the tree-walker's semantics.
pub fn truthy(v: Value) -> int {
  if v.tag == "bool" { return v.ival; };
  if v.tag == "unit" { return 0; };
  if v.tag == "null" { return 0; };
  if v.tag == "int" { if v.ival == 0 { return 0; } else { return 1; }; };
  if v.tag == "float" { if v.fval == 0.0 { return 0; } else { return 1; }; };
  if v.tag == "string" { if len(v.sval) == 0 { return 0; } else { return 1; }; };
  if v.tag == "array" { if len(v.arr) == 0 { return 0; } else { return 1; }; };
  if v.tag == "map" { if len(v.pairs) == 0 { return 0; } else { return 1; }; };
  1
}

// Display — matches the tree-walker's `display`.
pub fn displayV(v: Value) -> string {
  if v.tag == "int" { return str(v.ival); };
  if v.tag == "float" { return str(v.fval); };
  if v.tag == "bool" { if v.ival == 1 { return "true"; } else { return "false"; }; };
  if v.tag == "string" { return v.sval; };
  if v.tag == "unit" { return "null"; };
  if v.tag == "null" { return "null"; };
  if v.tag == "array" { return displayArray(v.arr); };
  if v.tag == "map" { return displayMap(v.pairs); };
  if v.tag == "struct" { return displayStruct(v.sval, v.fields); };
  if v.tag == "variant" { return displayVariant(v.sval, v.vname, v.arr); };
  if v.tag == "closure" { return "<closure " + str(v.ival) + ">"; };
  if v.tag == "native" { return "<native " + v.sval + ">"; };
  if v.tag == "range" { return "range(" + str(v.ival) + ", " + str(v.rangeEnd) + ")"; };
  if v.tag == "box" { return "<box " + displayV(v.arr[0]) + ">"; };
  "<value>"
}

fn displayArray(arr: [Value]) -> string {
  let out = "[";
  let mut i = 0;
  while i < len(arr) {
    if i > 0 { out = out + ", "; };
    out = out + displayV(arr[i]);
    i = i + 1;
  }
  out + "]"
}

fn displayMap(pairs: [KVP]) -> string {
  let out = "{";
  let mut i = 0;
  while i < len(pairs) {
    if i > 0 { out = out + ", "; };
    out = out + displayV(pairs[i].key) + ": " + displayV(pairs[i].val);
    i = i + 1;
  }
  out + "}"
}

fn displayStruct(name: string, fields: [VField]) -> string {
  let out = name + " { ";
  let mut i = 0;
  while i < len(fields) {
    if i > 0 { out = out + ", "; };
    out = out + fields[i].name + ": " + displayV(fields[i].val);
    i = i + 1;
  }
  out + " }"
}

fn displayVariant(enumName: string, variant: string, data: [Value]) -> string {
  if len(data) == 0 { return enumName + "::" + variant; };
  let out = enumName + "::" + variant + "(";
  let mut i = 0;
  while i < len(data) {
    if i > 0 { out = out + ", "; };
    out = out + displayV(data[i]);
    i = i + 1;
  }
  out + ")"
}

// Deep value equality — matches the tree-walker's `valueEq`.
pub fn valueEq(a: Value, b: Value) -> int {
  if a.tag == "int" && b.tag == "int" { if a.ival == b.ival { return 1; } else { return 0; }; };
  if a.tag == "float" && b.tag == "float" { if a.fval == b.fval { return 1; } else { return 0; }; };
  if a.tag == "int" && b.tag == "float" { if intEqFloat(a.ival, b.fval) { return 1; } else { return 0; }; };
  if a.tag == "float" && b.tag == "int" { if intEqFloat(b.ival, a.fval) { return 1; } else { return 0; }; };
  if a.tag == "bool" && b.tag == "bool" { if a.ival == b.ival { return 1; } else { return 0; }; };
  if a.tag == "string" && b.tag == "string" { if a.sval == b.sval { return 1; } else { return 0; }; };
  if a.tag == "unit" && b.tag == "unit" { return 1; };
  if a.tag == "null" && b.tag == "null" { return 1; };
  if a.tag == "unit" && b.tag == "null" { return 1; };
  if a.tag == "null" && b.tag == "unit" { return 1; };
  if a.tag == "array" && b.tag == "array" { return arrEq(a.arr, b.arr); };
  if a.tag == "map" && b.tag == "map" { return mapEq(a.pairs, b.pairs); };
  if a.tag == "struct" && b.tag == "struct" {
    if a.sval != b.sval { return 0; };
    return fieldsEq(a.fields, b.fields);
  };
  if a.tag == "variant" && b.tag == "variant" {
    if a.sval != b.sval { return 0; };
    if a.vname != b.vname { return 0; };
    return arrEq(a.arr, b.arr);
  };
  if a.tag == "range" && b.tag == "range" {
    if a.ival != b.ival { return 0; };
    if a.rangeEnd != b.rangeEnd { return 0; };
    if a.rangeStep != b.rangeStep { return 0; };
    return 1;
  };
  0
}

fn intEqFloat(i: int, f: float) -> int {
  // best-effort: compare if f has no fractional part and equals i.
  let g = int(f);
  if g == i { if int(g) == i { return 1; }; };
  0
}

fn arrEq(a: [Value], b: [Value]) -> int {
  if len(a) != len(b) { return 0; };
  let mut i = 0;
  while i < len(a) {
    if valueEq(a[i], b[i]) == 0 { return 0; };
    i = i + 1;
  }
  1
}

fn mapEq(a: [KVP], b: [KVP]) -> int {
  if len(a) != len(b) { return 0; };
  let mut i = 0;
  while i < len(a) {
    let mut found = 0;
    let mut j = 0;
    while j < len(b) {
      if valueEq(a[i].key, b[j].key) == 1 {
        if valueEq(a[i].val, b[j].val) == 1 { found = 1; };
        j = len(b);
      } else {
        j = j + 1;
      };
    }
    if found == 0 { return 0; };
    i = i + 1;
  }
  1
}

fn fieldsEq(a: [VField], b: [VField]) -> int {
  if len(a) != len(b) { return 0; };
  let mut i = 0;
  while i < len(a) {
    let mut found = 0;
    let mut j = 0;
    while j < len(b) {
      if a[i].name == b[j].name {
        if valueEq(a[i].val, b[j].val) == 1 { found = 1; };
        j = len(b);
      } else {
        j = j + 1;
      };
    }
    if found == 0 { return 0; };
    i = i + 1;
  }
  1
}

// -----------------------------------------------------------------------------
// IR types
// -----------------------------------------------------------------------------

struct IrOp {
  op: string,         // op name (same as bytecode op name)
  a: int,             // dest or register operand 1
  b: int,             // src or register operand 2
  c: int,             // src or register operand 3
  imm: int,           // immediate value or jump target (block id pre-codegen, instr index post)
  imm2: int,          // second immediate (e.g., args count for Call)
  fval: float,        // for LoadFloat
  sval: string,       // for LoadString, builtin name, struct name, field name
  bval: int,          // 0/1 for LoadBool
  vname: string,      // for AllocVariant: variant name
  regs: [int],        // variadic register list (args, captures, elems, variant data, map entries flat)
  fields: [IrField],  // for AllocStruct: ordered (name, reg)
  target: int,        // for Match: match table index in func.matchTables
  value: Value,       // reserved (unused; constants are emitted as LoadInt/LoadFloat/LoadString/LoadBool/LoadUnit)
}

struct IrField { name: string, reg: int }

struct IrBlock { id: int, instrs: [IrOp] }

struct MatchEntry {
  patternKind: string,   // "Wildcard" | "Bind" | "Lit" | "Tuple" | "Array" | "Struct" | "Enum" | "Or"
  bindName: string,       // for Bind
  litValue: Value,        // for Lit
  structName: string,     // for Struct
  enumName: string,       // for Enum
  variant: string,        // for Enum
  fieldBindings: [MatchField],   // for Struct
  subregs: [MatchSub],          // for Tuple/Array/Enum
  orPatterns: [MatchSub],       // for Or
  hasRest: int,                 // for Array rest
  target: int,                  // jump target (block id pre-codegen, instr index post)
}

struct MatchField { name: string, pattern: MatchEntry }
struct MatchSub { pattern: MatchEntry }

struct MatchTable { entries: [MatchEntry], defaultTarget: int }

struct IrFunc {
  name: string,
  nparams: int,
  nlocals: int,
  blocks: [IrBlock],
  entry: int,            // block id (always 0 in v1)
  captures: [string],    // upvalue names (in order)
  selfReg: int,          // -1 if none
  isMain: int,           // 1 for <main>
  nested: [int],         // indexes into IrProgram.funcs
  matchTables: [MatchTable],
  strings: [string],    // per-function string table
  regLists: [[int]],     // per-function reg-list table
  fieldLists: [[IrField]],   // per-function field-list table
  constants: [Value],    // per-function constant pool (for big ints, floats, strings)
  matchBindings: [MatchBinding],  // (tableIdx, name) -> reg
}

struct MatchBinding { tableIdx: int, name: string, reg: int }

struct GlobalEntry { name: string, reg: int }

struct IrProgram {
  funcs: [IrFunc],
  globals: [GlobalEntry],
  entry: int,
}

// -----------------------------------------------------------------------------
// Lowering context
// -----------------------------------------------------------------------------

struct VarBinding { vreg: int, boxed: int, isUpvalue: int, upvalueIndex: int }

struct LowerCtx {
  funcs: [IrFunc],
  current: int,         // index into funcs (current function being lowered)
  currentBlock: int,    // current block id within current function
  scopes: [[ScopeEntry]],
  capturedNames: [string],
  nextBlockId: int,
}

struct ScopeEntry { name: string, binding: VarBinding }

// Empty Value placeholder for IrOp defaults.
fn emptyIrOp() -> IrOp {
  IrOp { op: "Nop", a: 0, b: 0, c: 0, imm: 0, imm2: 0, fval: 0.0, sval: "", bval: 0, vname: "", regs: [], fields: [], target: 0, value: mkUnit() }
}

pub fn opNop() -> IrOp { emptyIrOp() }
pub fn opLoadInt(dest: int, v: int) -> IrOp {
  let o = emptyIrOp();
  o.op = "LoadInt";
  o.a = dest;
  o.imm = v;
  o
}
pub fn opLoadFloat(dest: int, v: float) -> IrOp {
  let o = emptyIrOp();
  o.op = "LoadFloat";
  o.a = dest;
  o.fval = v;
  o
}
