// =====================================================================
// aether-bootstrap/parser.test.ae — Unit tests for the Aether parser
// =====================================================================
// 100+ test cases that drive the parser via mock token streams (built
// with the `toks` helper exported from parser.ae). Each test parses a
// small Aether snippet, checks the AST shape, the number of top-level
// statements, and (for clean parses) the number of errors.
//
// Since the Aether bootstrap doesn't support imports via the simple
// `bun /tmp/verify_bootstrap.ts file.ae` runner (that path uses
// `compileAndRun`, not the module-system `runModule`), this file is
// concatenated with parser.ae at test time:
//
//   cat parser.ae parser.test.ae > /tmp/combined.ae
//   bun /tmp/verify_bootstrap.ts /tmp/combined.ae
//
// All test functions are called from a single `runAllTests()` driver
// at the bottom of the file. Tests use `assert_eq(actual, expected)` and
// `assert(condition)`; any failure throws and halts the run.
// =====================================================================

// --- Test driver ---
// Tracks pass/fail counts. We avoid the for-loop-scope bug by mutating
// struct fields through a passed struct reference (the `Stats` struct
// is mutated inside `check()` via reference semantics).
struct Stats { passed: int, failed: int }

fn check(st: Stats, cond: int, msg: string) -> int {
  if cond == 1 {
    st.passed = st.passed + 1;
  } else {
    st.failed = st.failed + 1;
    print("FAIL: " + msg);
  };
  0
}

fn checkEq(st: Stats, actual: int, expected: int, msg: string) -> int {
  if actual == expected {
    st.passed = st.passed + 1;
  } else {
    st.failed = st.failed + 1;
    print("FAIL: " + msg + " (expected " + str(expected) + ", got " + str(actual) + ")");
  };
  0
}

fn checkEqStr(st: Stats, actual: string, expected: string, msg: string) -> int {
  if actual == expected {
    st.passed = st.passed + 1;
  } else {
    st.failed = st.failed + 1;
    print("FAIL: " + msg + " (expected '" + expected + "', got '" + actual + "')");
  };
  0
}

// Convenience: parse a flat (kind, text) list and return the ParseResult
fn P(parts: [string]) -> ParseResult { parse(toks(parts)) }

// Convenience: parse and return error count
fn P_err(parts: [string]) -> int { len(P(parts).errors) }

// Convenience: parse and return statement count
fn P_n(parts: [string]) -> int { P(parts).program.ival }

// Convenience: parse and return stmt 0 kind
fn P_k0(parts: [string]) -> string { P(parts).program.items[0].kind }

// Convenience: parse and return stmt 0 name (for let/fn/enum/struct)
fn P_n0(parts: [string]) -> string { P(parts).program.items[0].name }

// =====================================================================
// Tests: literals & atoms
// =====================================================================

fn test_int_literal(st: Stats) -> int {
  // `42;`
  let r = P(["Int", "42", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "int-literal: no errors");
  checkEq(st, r.program.ival, 1, "int-literal: 1 stmt");
  let s = r.program.items[0];
  checkEqStr(st, s.kind, "ExprStmt", "int-literal: stmt kind");
  let e = s.items[0];
  checkEqStr(st, e.kind, "IntLit", "int-literal: expr kind");
  checkEq(st, e.ival, 42, "int-literal: value");
  0
}

fn test_float_literal(st: Stats) -> int {
  // `3.14;`
  let r = P(["Float", "3.14", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "float-literal: no errors");
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "FloatLit", "float-literal: expr kind");
  0
}

fn test_bool_literal_true(st: Stats) -> int {
  let r = P(["Keyword", "true", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "bool-true: no errors");
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "BoolLit", "bool-true: kind");
  checkEq(st, e.ival, 1, "bool-true: value");
  0
}

fn test_bool_literal_false(st: Stats) -> int {
  let r = P(["Keyword", "false", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "bool-false: no errors");
  let e = r.program.items[0].items[0];
  checkEq(st, e.ival, 0, "bool-false: value");
  0
}

fn test_string_literal(st: Stats) -> int {
  let r = P(["String", "hello", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "string-literal: no errors");
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "StringLit", "string-literal: kind");
  checkEqStr(st, e.text, "hello", "string-literal: text");
  0
}

fn test_char_literal(st: Stats) -> int {
  let r = P(["Char", "a", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "char-literal: no errors");
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "CharLit", "char-literal: kind");
  0
}

fn test_unit_literal(st: Stats) -> int {
  // `();`
  let r = P(["Punct", "(", "Punct", ")", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "unit-literal: no errors");
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "UnitLit", "unit-literal: kind");
  0
}

fn test_self_expr(st: Stats) -> int {
  let r = P(["Keyword", "self", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "self-expr: no errors");
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "SelfExpr", "self-expr: kind");
  0
}

fn test_ident_expr(st: Stats) -> int {
  let r = P(["Ident", "x", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "ident-expr: no errors");
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Ident", "ident-expr: kind");
  checkEqStr(st, e.name, "x", "ident-expr: name");
  0
}

fn test_paren_expr(st: Stats) -> int {
  // `(42);`
  let r = P(["Punct", "(", "Int", "42", "Punct", ")", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "paren: no errors");
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Paren", "paren: kind");
  checkEqStr(st, e.items[0].kind, "IntLit", "paren: inner kind");
  0
}

fn test_tuple_expr(st: Stats) -> int {
  // `(1, 2, 3);`
  let r = P(["Punct", "(", "Int", "1", "Punct", ",", "Int", "2", "Punct", ",", "Int", "3", "Punct", ")", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "tuple: no errors");
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "TupleExpr", "tuple: kind");
  checkEq(st, e.ival, 3, "tuple: 3 elements");
  0
}

fn test_array_expr(st: Stats) -> int {
  // `[1, 2, 3];`
  let r = P(["Punct", "[", "Int", "1", "Punct", ",", "Int", "2", "Punct", ",", "Int", "3", "Punct", "]", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "array: no errors");
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "ArrayExpr", "array: kind");
  checkEq(st, e.ival, 3, "array: 3 elements");
  0
}

fn test_empty_array(st: Stats) -> int {
  let r = P(["Punct", "[", "Punct", "]", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "empty-array: no errors");
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "ArrayExpr", "empty-array: kind");
  checkEq(st, e.ival, 0, "empty-array: 0 elements");
  0
}

fn test_map_expr(st: Stats) -> int {
  // `{"a": 1};`
  let r = P(["Punct", "{", "String", "a", "Punct", ":", "Int", "1", "Punct", "}", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "map: no errors");
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "MapExpr", "map: kind");
  checkEq(st, e.ival, 1, "map: 1 entry");
  0
}

// =====================================================================
// Tests: binary / unary / precedence
// =====================================================================

fn test_addition(st: Stats) -> int {
  let r = P(["Int", "1", "Punct", "+", "Int", "2", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Binary", "addition: kind");
  checkEqStr(st, e.name, "+", "addition: op");
  checkEq(st, e.items[0].ival, 1, "addition: left");
  checkEq(st, e.items[1].ival, 2, "addition: right");
  0
}

fn test_precedence_mul_over_add(st: Stats) -> int {
  // 1 + 2 * 3 -> 1 + (2 * 3)
  let r = P(["Int", "1", "Punct", "+", "Int", "2", "Punct", "*", "Int", "3", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.name, "+", "prec: top op is +");
  checkEqStr(st, e.items[0].kind, "IntLit", "prec: left is IntLit");
  checkEqStr(st, e.items[1].kind, "Binary", "prec: right is Binary");
  checkEqStr(st, e.items[1].name, "*", "prec: right op is *");
  0
}

fn test_left_assoc_sub(st: Stats) -> int {
  // 1 - 2 - 3 -> (1 - 2) - 3
  let r = P(["Int", "1", "Punct", "-", "Int", "2", "Punct", "-", "Int", "3", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.name, "-", "assoc: top op is -");
  checkEqStr(st, e.items[0].kind, "Binary", "assoc: left is Binary (1-2)");
  checkEqStr(st, e.items[1].kind, "IntLit", "assoc: right is IntLit (3)");
  0
}

fn test_unary_neg(st: Stats) -> int {
  // `-5;`
  let r = P(["Punct", "-", "Int", "5", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Unary", "unary-neg: kind");
  checkEqStr(st, e.name, "-", "unary-neg: op");
  checkEqStr(st, e.items[0].kind, "IntLit", "unary-neg: operand");
  0
}

fn test_unary_not(st: Stats) -> int {
  // `!true;`
  let r = P(["Punct", "!", "Keyword", "true", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Unary", "unary-not: kind");
  checkEqStr(st, e.name, "!", "unary-not: op");
  0
}

fn test_logical_and(st: Stats) -> int {
  let r = P(["Keyword", "true", "Punct", "&&", "Keyword", "false", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Binary", "and: kind");
  checkEqStr(st, e.name, "&&", "and: op");
  0
}

fn test_logical_or(st: Stats) -> int {
  let r = P(["Keyword", "true", "Punct", "||", "Keyword", "false", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Binary", "or: kind");
  checkEqStr(st, e.name, "||", "or: op");
  0
}

fn test_equality(st: Stats) -> int {
  let r = P(["Int", "1", "Punct", "==", "Int", "2", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.name, "==", "eq: op");
  0
}

fn test_not_equal(st: Stats) -> int {
  let r = P(["Int", "1", "Punct", "!=", "Int", "2", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.name, "!=", "neq: op");
  0
}

fn test_less_than(st: Stats) -> int {
  let r = P(["Int", "1", "Punct", "<", "Int", "2", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.name, "<", "lt: op");
  0
}

fn test_less_equal(st: Stats) -> int {
  let r = P(["Int", "1", "Punct", "<=", "Int", "2", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.name, "<=", "le: op");
  0
}

fn test_greater_than(st: Stats) -> int {
  let r = P(["Int", "1", "Punct", ">", "Int", "2", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.name, ">", "gt: op");
  0
}

fn test_greater_equal(st: Stats) -> int {
  let r = P(["Int", "1", "Punct", ">=", "Int", "2", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.name, ">=", "ge: op");
  0
}

fn test_modulo(st: Stats) -> int {
  let r = P(["Int", "10", "Punct", "%", "Int", "3", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.name, "%", "mod: op");
  0
}

fn test_division(st: Stats) -> int {
  let r = P(["Int", "10", "Punct", "/", "Int", "2", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.name, "/", "div: op");
  0
}

fn test_combined_precedence(st: Stats) -> int {
  // 1 + 2 * 3 - 4 / 2 -> (1 + (2*3)) - (4/2)
  let r = P(["Int", "1", "Punct", "+", "Int", "2", "Punct", "*", "Int", "3", "Punct", "-", "Int", "4", "Punct", "/", "Int", "2", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.name, "-", "combined: top op is -");
  checkEqStr(st, e.items[0].name, "+", "combined: left is +");
  checkEqStr(st, e.items[1].name, "/", "combined: right is /");
  0
}

fn test_paren_overrides_precedence(st: Stats) -> int {
  // (1 + 2) * 3 -> (1+2) * 3
  let r = P(["Punct", "(", "Int", "1", "Punct", "+", "Int", "2", "Punct", ")", "Punct", "*", "Int", "3", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.name, "*", "paren-prec: top op is *");
  checkEqStr(st, e.items[0].kind, "Paren", "paren-prec: left is Paren");
  0
}

fn test_unary_minus_higher_than_binary(st: Stats) -> int {
  // -1 + 2 -> (-1) + 2
  let r = P(["Punct", "-", "Int", "1", "Punct", "+", "Int", "2", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.name, "+", "unary-prec: top op is +");
  checkEqStr(st, e.items[0].kind, "Unary", "unary-prec: left is Unary");
  0
}

// =====================================================================
// Tests: postfix (call, index, field, method)
// =====================================================================

fn test_call(st: Stats) -> int {
  // `f();`
  let r = P(["Ident", "f", "Punct", "(", "Punct", ")", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Call", "call: kind");
  checkEqStr(st, e.items[0].name, "f", "call: callee");
  checkEq(st, e.ival, 0, "call: 0 args");
  0
}

fn test_call_with_args(st: Stats) -> int {
  // `add(1, 2);`
  let r = P(["Ident", "add", "Punct", "(", "Int", "1", "Punct", ",", "Int", "2", "Punct", ")", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Call", "call-args: kind");
  checkEq(st, e.ival, 2, "call-args: 2 args");
  0
}

fn test_index(st: Stats) -> int {
  // `arr[0];`
  let r = P(["Ident", "arr", "Punct", "[", "Int", "0", "Punct", "]", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Index", "index: kind");
  0
}

fn test_field_access(st: Stats) -> int {
  // `p.x;`
  let r = P(["Ident", "p", "Punct", ".", "Ident", "x", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Field", "field: kind");
  checkEqStr(st, e.name, "x", "field: name");
  0
}

fn test_method_call(st: Stats) -> int {
  // `obj.foo(1, 2);`
  let r = P(["Ident", "obj", "Punct", ".", "Ident", "foo", "Punct", "(", "Int", "1", "Punct", ",", "Int", "2", "Punct", ")", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "MethodCall", "method: kind");
  checkEqStr(st, e.name, "foo", "method: name");
  checkEq(st, e.ival, 2, "method: 2 args");
  0
}

fn test_chained_calls(st: Stats) -> int {
  // `f()();`
  let r = P(["Ident", "f", "Punct", "(", "Punct", ")", "Punct", "(", "Punct", ")", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Call", "chained: outer Call");
  checkEqStr(st, e.items[0].kind, "Call", "chained: inner Call");
  0
}

fn test_nested_field_then_call(st: Stats) -> int {
  // `obj.method().field;`
  let r = P(["Ident", "obj", "Punct", ".", "Ident", "method", "Punct", "(", "Punct", ")", "Punct", ".", "Ident", "field", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Field", "chained-fc: outer Field");
  checkEqStr(st, e.items[0].kind, "MethodCall", "chained-fc: inner MethodCall");
  0
}

fn test_tuple_field_access(st: Stats) -> int {
  // `t.0;`
  let r = P(["Ident", "t", "Punct", ".", "Int", "0", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "TupleField", "tuple-field: kind");
  checkEq(st, e.ival, 0, "tuple-field: index 0");
  0
}

fn test_error_propagation(st: Stats) -> int {
  // `expr?;`
  let r = P(["Ident", "expr", "Punct", "?", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "ErrorProp", "error-prop: kind");
  0
}

fn test_range_expr(st: Stats) -> int {
  // `1..10;`
  let r = P(["Int", "1", "Punct", "..", "Int", "10", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Range", "range: kind");
  checkEq(st, e.ival, 0, "range: not inclusive");
  0
}

fn test_range_inclusive(st: Stats) -> int {
  // `1..=10;`
  let r = P(["Int", "1", "Punct", "..=", "Int", "10", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Range", "range-inc: kind");
  checkEq(st, e.ival, 1, "range-inc: inclusive");
  0
}

fn test_as_cast(st: Stats) -> int {
  // `x as int;`
  let r = P(["Ident", "x", "Keyword", "as", "Ident", "int", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "As", "as-cast: kind");
  checkEqStr(st, e.items[1].name, "int", "as-cast: type");
  0
}

// =====================================================================
// Tests: enum variant construction
// =====================================================================

fn test_enum_variant_unit(st: Stats) -> int {
  // `Option::None;`
  let r = P(["Ident", "Option", "Punct", "::", "Ident", "None", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "EnumVariant", "enum-unit: kind");
  checkEqStr(st, e.name, "Option", "enum-unit: enum name");
  checkEqStr(st, e.text, "None", "enum-unit: variant name");
  checkEq(st, e.ival, 0, "enum-unit: 0 args");
  0
}

fn test_enum_variant_tuple(st: Stats) -> int {
  // `Option::Some(42);`
  let r = P(["Ident", "Option", "Punct", "::", "Ident", "Some", "Punct", "(", "Int", "42", "Punct", ")", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "EnumVariant", "enum-tuple: kind");
  checkEqStr(st, e.text, "Some", "enum-tuple: variant name");
  checkEq(st, e.ival, 1, "enum-tuple: 1 arg");
  0
}

