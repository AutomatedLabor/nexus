// Tests: struct literal
// =====================================================================

fn test_struct_literal_empty(st: Stats) -> int {
  // `Point {};`
  let r = P(["Ident", "Point", "Punct", "{", "Punct", "}", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "StructExpr", "struct-empty: kind");
  checkEqStr(st, e.name, "Point", "struct-empty: name");
  checkEq(st, e.ival, 0, "struct-empty: 0 fields");
  0
}

fn test_struct_literal_fields(st: Stats) -> int {
  // `Point { x: 1, y: 2 };`
  let r = P(["Ident", "Point", "Punct", "{", "Ident", "x", "Punct", ":", "Int", "1", "Punct", ",", "Ident", "y", "Punct", ":", "Int", "2", "Punct", "}", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "StructExpr", "struct-fields: kind");
  checkEqStr(st, e.name, "Point", "struct-fields: name");
  checkEq(st, e.ival, 2, "struct-fields: 2 fields");
  0
}

