  // `fn(x: int) -> int { x };`
  let r = P(["Keyword", "fn", "Punct", "(", "Ident", "x", "Punct", ":", "Ident", "int", "Punct", ")", "Punct", "->", "Ident", "int", "Punct", "{", "Ident", "x", "Punct", "}", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Lambda", "lambda: kind");
  0
}

