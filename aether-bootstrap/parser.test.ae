  let r = P(["Keyword", "let", "Ident", "x", "Punct", ":", "Ident", "result", "Punct", "<", "Ident", "int", "Punct", ",", "Ident", "string", "Punct", ">", "Punct", "=", "Ident", "r", "Punct", ";"]);
  let s = r.program.items[0];
  let typeN = s.items[0];
  checkEqStr(st, typeN.kind, "ResultType", "result-type: kind");
  0
}

fn test_unit_type(st: Stats) -> int {
  // `let x: () = ();`
  let r = P(["Keyword", "let", "Ident", "x", "Punct", ":", "Punct", "(", "Punct", ")", "Punct", "=", "Punct", "(", "Punct", ")", "Punct", ";"]);
  let s = r.program.items[0];
  let typeN = s.items[0];
  checkEqStr(st, typeN.kind, "UnitType", "unit-type: kind");
  0
}

// =====================================================================
// Tests: patterns
// =====================================================================

fn test_wildcard_pattern(st: Stats) -> int {
  // `match x { _ => 0, };`
  let r = P(["Keyword", "match", "Ident", "x", "Punct", "{", "Punct", "_", "Punct", "=>", "Int", "0", "Punct", ",", "Punct", "}"]);
  let m = r.program.items[0].items[0];
  let arm = m.items[1];
  let pat = arm.items[0];
  checkEqStr(st, pat.kind, "WildcardPat", "wildcard-pat: kind");
  0
}

fn test_bind_pattern(st: Stats) -> int {
  // `match x { n => n, };`
  let r = P(["Keyword", "match", "Ident", "x", "Punct", "{", "Ident", "n", "Punct", "=>", "Ident", "n", "Punct", ",", "Punct", "}"]);
  let m = r.program.items[0].items[0];
  let arm = m.items[1];
  let pat = arm.items[0];
  checkEqStr(st, pat.kind, "BindPat", "bind-pat: kind");
  checkEqStr(st, pat.name, "n", "bind-pat: name");
  0
}

fn test_lit_pattern_int(st: Stats) -> int {
  // `match x { 42 => 1, _ => 0, };`
  let r = P(["Keyword", "match", "Ident", "x", "Punct", "{", "Int", "42", "Punct", "=>", "Int", "1", "Punct", ",", "Punct", "_", "Punct", "=>", "Int", "0", "Punct", ",", "Punct", "}"]);
  let m = r.program.items[0].items[0];
  let arm = m.items[1];
  let pat = arm.items[0];
  checkEqStr(st, pat.kind, "LitPat", "lit-pat: kind");
  0
}

fn test_lit_pattern_string(st: Stats) -> int {
  // `match x { "hello" => 1, _ => 0, };`
  let r = P(["Keyword", "match", "Ident", "x", "Punct", "{", "String", "hello", "Punct", "=>", "Int", "1", "Punct", ",", "Punct", "_", "Punct", "=>", "Int", "0", "Punct", ",", "Punct", "}"]);
  let m = r.program.items[0].items[0];
  let arm = m.items[1];
  let pat = arm.items[0];
  checkEqStr(st, pat.kind, "LitPat", "lit-pat-str: kind");
  0
}

fn test_tuple_pattern(st: Stats) -> int {
  // `match x { (a, b) => a, };`
  let r = P(["Keyword", "match", "Ident", "x", "Punct", "{", "Punct", "(", "Ident", "a", "Punct", ",", "Ident", "b", "Punct", ")", "Punct", "=>", "Ident", "a", "Punct", ",", "Punct", "}"]);
  let m = r.program.items[0].items[0];
  let arm = m.items[1];
  let pat = arm.items[0];
  checkEqStr(st, pat.kind, "TuplePat", "tuple-pat: kind");
  0
}

fn test_array_pattern(st: Stats) -> int {
  // `match x { [a, b] => 0, };`
  let r = P(["Keyword", "match", "Ident", "x", "Punct", "{", "Punct", "[", "Ident", "a", "Punct", ",", "Ident", "b", "Punct", "]", "Punct", "=>", "Int", "0", "Punct", ",", "Punct", "}"]);
  let m = r.program.items[0].items[0];
  let arm = m.items[1];
  let pat = arm.items[0];
  checkEqStr(st, pat.kind, "ArrayPat", "array-pat: kind");
  0
}

fn test_array_pattern_with_rest(st: Stats) -> int {
  // `match x { [a, ..] => 0, };`
  let r = P(["Keyword", "match", "Ident", "x", "Punct", "{", "Punct", "[", "Ident", "a", "Punct", ",", "Punct", "..", "Punct", "]", "Punct", "=>", "Int", "0", "Punct", ",", "Punct", "}"]);
  let m = r.program.items[0].items[0];
  let arm = m.items[1];
  let pat = arm.items[0];
  checkEqStr(st, pat.kind, "ArrayPat", "array-pat-rest: kind");
  checkEq(st, pat.ival, 1, "array-pat-rest: rest index 1");
  0
}

fn test_enum_pattern(st: Stats) -> int {
  // `match x { Option::Some(v) => v, Option::None => 0, };`
  let r = P(["Keyword", "match", "Ident", "x", "Punct", "{", "Ident", "Option", "Punct", "::", "Ident", "Some", "Punct", "(", "Ident", "v", "Punct", ")", "Punct", "=>", "Ident", "v", "Punct", ",", "Ident", "Option", "Punct", "::", "Ident", "None", "Punct", "=>", "Int", "0", "Punct", ",", "Punct", "}"]);
  let m = r.program.items[0].items[0];
  let arm = m.items[1];
  let pat = arm.items[0];
  checkEqStr(st, pat.kind, "EnumPat", "enum-pat: kind");
  checkEqStr(st, pat.name, "Option", "enum-pat: enum name");
  checkEqStr(st, pat.text, "Some", "enum-pat: variant name");
  0
}

fn test_struct_pattern(st: Stats) -> int {
  // `match p { Point { x, y } => 0, };`
  let r = P(["Keyword", "match", "Ident", "p", "Punct", "{", "Ident", "Point", "Punct", "{", "Ident", "x", "Punct", ",", "Ident", "y", "Punct", "}", "Punct", "=>", "Int", "0", "Punct", ",", "Punct", "}"]);
  let m = r.program.items[0].items[0];
  let arm = m.items[1];
  let pat = arm.items[0];
  checkEqStr(st, pat.kind, "StructPat", "struct-pat: kind");
  checkEqStr(st, pat.name, "Point", "struct-pat: name");
  0
}

fn test_or_pattern(st: Stats) -> int {
  // `match x { 1 | 2 => 0, _ => 1, };`
  let r = P(["Keyword", "match", "Ident", "x", "Punct", "{", "Int", "1", "Punct", "|", "Int", "2", "Punct", "=>", "Int", "0", "Punct", ",", "Punct", "_", "Punct", "=>", "Int", "1", "Punct", ",", "Punct", "}"]);
  let m = r.program.items[0].items[0];
  let arm = m.items[1];
  let pat = arm.items[0];
  checkEqStr(st, pat.kind, "OrPat", "or-pat: kind");
  checkEq(st, pat.ival, 2, "or-pat: 2 patterns");
  0
}

fn test_mut_bind_pattern(st: Stats) -> int {
  // `match x { mut n => n, };`
  let r = P(["Keyword", "match", "Ident", "x", "Punct", "{", "Keyword", "mut", "Ident", "n", "Punct", "=>", "Ident", "n", "Punct", ",", "Punct", "}"]);
  let m = r.program.items[0].items[0];
  let arm = m.items[1];
  let pat = arm.items[0];
  checkEqStr(st, pat.kind, "BindPat", "mut-bind: kind");
  checkEq(st, pat.ival, 1, "mut-bind: isMut (1)");
  0
}

// =====================================================================
// Tests: error recovery
// =====================================================================

fn test_missing_semicolon(st: Stats) -> int {
  // `let x = 42` (no `;`)
  let r = P(["Keyword", "let", "Ident", "x", "Punct", "=", "Int", "42"]);
  check(st, len(r.errors) >= 1, "missing-semi: at least 1 error");
  0
}

fn test_missing_init(st: Stats) -> int {
  // `let x = ;` (missing init expr)
  let r = P(["Keyword", "let", "Ident", "x", "Punct", "=", "Punct", ";"]);
  check(st, len(r.errors) >= 1, "missing-init: at least 1 error");
  0
}

fn test_missing_paren_close(st: Stats) -> int {
  // `fn f( -> int { 42 }` (missing close paren)
  let r = P(["Keyword", "fn", "Ident", "f", "Punct", "(", "Punct", "->", "Ident", "int", "Punct", "{", "Int", "42", "Punct", "}"]);
  check(st, len(r.errors) >= 1, "missing-paren: at least 1 error");
  0
}

fn test_error_continues_parsing(st: Stats) -> int {
  // `let x = ; let y = 1;` — first has error, second parses
  let r = P(["Keyword", "let", "Ident", "x", "Punct", "=", "Punct", ";", "Keyword", "let", "Ident", "y", "Punct", "=", "Int", "1", "Punct", ";"]);
  check(st, len(r.errors) >= 1, "err-cont: at least 1 error");
  // Second let should parse; program should have at least 1 stmt
  check(st, r.program.ival >= 1, "err-cont: at least 1 stmt");
  0
}

fn test_missing_brace_close(st: Stats) -> int {
  // `fn f() { 42` (missing close brace)
  let r = P(["Keyword", "fn", "Ident", "f", "Punct", "(", "Punct", ")", "Punct", "{", "Int", "42"]);
  check(st, len(r.errors) >= 1, "missing-brace: at least 1 error");
  0
}

fn test_unexpected_token(st: Stats) -> int {
  // `) ;` (unexpected close paren at start)
  let r = P(["Punct", ")", "Punct", ";"]);
  check(st, len(r.errors) >= 1, "unexpected: at least 1 error");
  0
}

// =====================================================================
// Tests: full-program snippets
// =====================================================================

fn test_full_program_let(st: Stats) -> int {
  let r = P(["Keyword", "let", "Ident", "x", "Punct", "=", "Int", "42", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "full-let: no errors");
  checkEq(st, r.program.ival, 1, "full-let: 1 stmt");
  0
}

fn test_full_program_two_lets(st: Stats) -> int {
  let r = P(["Keyword", "let", "Ident", "x", "Punct", "=", "Int", "42", "Punct", ";", "Keyword", "let", "Ident", "y", "Punct", "=", "Int", "10", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "two-lets: no errors");
  checkEq(st, r.program.ival, 2, "two-lets: 2 stmts");
  0
}

fn test_full_program_let_fn(st: Stats) -> int {
  let r = P([
    "Keyword", "let", "Ident", "x", "Punct", "=", "Int", "42", "Punct", ";",
    "Keyword", "fn", "Ident", "f", "Punct", "(", "Punct", ")", "Punct", "->", "Ident", "int", "Punct", "{", "Int", "0", "Punct", "}",
  ]);
  checkEq(st, len(r.errors), 0, "let-fn: no errors");
  checkEq(st, r.program.ival, 2, "let-fn: 2 stmts");
  0
}

fn test_full_program_with_block(st: Stats) -> int {
  // `let x = { 1; 2; 3 };`
  let r = P(["Keyword", "let", "Ident", "x", "Punct", "=", "Punct", "{", "Int", "1", "Punct", ";", "Int", "2", "Punct", ";", "Int", "3", "Punct", "}", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "let-block: no errors");
  checkEq(st, r.program.ival, 1, "let-block: 1 stmt");
  let s = r.program.items[0];
  let init = s.items[1];
  checkEqStr(st, init.kind, "Block", "let-block: init is Block");
  0
}

fn test_full_program_const(st: Stats) -> int {
  // `const PI: float = 3.14159;`
  let r = P(["Keyword", "const", "Ident", "PI", "Punct", ":", "Ident", "float", "Punct", "=", "Float", "3.14159", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "full-const: no errors");
  let s = r.program.items[0];
  checkEqStr(st, s.name, "PI", "full-const: name");
  0
}

fn test_full_program_enum_result(st: Stats) -> int {
  // `enum Result<T, E> { Ok(T), Err(E), }`
  let r = P(["Keyword", "enum", "Ident", "Result", "Punct", "<", "Ident", "T", "Punct", ",", "Ident", "E", "Punct", ">", "Punct", "{", "Ident", "Ok", "Punct", "(", "Ident", "T", "Punct", ")", "Punct", ",", "Ident", "Err", "Punct", "(", "Ident", "E", "Punct", ")", "Punct", ",", "Punct", "}"]);
  checkEq(st, len(r.errors), 0, "full-result: no errors");
  let s = r.program.items[0];
  checkEqStr(st, s.name, "Result", "full-result: name");
  checkEq(st, s.ival, 2, "full-result: 2 variants");
  0
}

fn test_full_program_struct_point(st: Stats) -> int {
  // `struct Point { x: int, y: int }`
  let r = P(["Keyword", "struct", "Ident", "Point", "Punct", "{", "Ident", "x", "Punct", ":", "Ident", "int", "Punct", ",", "Ident", "y", "Punct", ":", "Ident", "int", "Punct", "}"]);
  checkEq(st, len(r.errors), 0, "full-point: no errors");
  let s = r.program.items[0];
  checkEqStr(st, s.name, "Point", "full-point: name");
  checkEq(st, s.ival, 2, "full-point: 2 fields");
  0
