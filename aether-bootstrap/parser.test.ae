// =====================================================================
// Tests: complex programs
// =====================================================================

fn test_complex_iterative(st: Stats) -> int {
  // `let mut acc = 0; let mut i = 0; while i < n { acc = acc + i; i = i + 1; }`
  let r = P([
    "Keyword", "let", "Keyword", "mut", "Ident", "acc", "Punct", "=", "Int", "0", "Punct", ";",
    "Keyword", "let", "Keyword", "mut", "Ident", "i", "Punct", "=", "Int", "0", "Punct", ";",
    "Keyword", "while", "Ident", "i", "Punct", "<", "Ident", "n", "Punct", "{",
      "Ident", "acc", "Punct", "=", "Ident", "acc", "Punct", "+", "Ident", "i", "Punct", ";",
      "Ident", "i", "Punct", "=", "Ident", "i", "Punct", "+", "Int", "1", "Punct", ";",
    "Punct", "}",
  ]);
  checkEq(st, len(r.errors), 0, "iter: no errors");
  checkEq(st, r.program.ival, 3, "iter: 3 stmts");
  0
}

fn test_complex_for_range(st: Stats) -> int {
  // `for i in range(0, 10) { print(i); }`
  let r = P([
    "Keyword", "for", "Ident", "i", "Keyword", "in", "Ident", "range", "Punct", "(", "Int", "0", "Punct", ",", "Int", "10", "Punct", ")", "Punct", "{",
      "Ident", "print", "Punct", "(", "Ident", "i", "Punct", ")", "Punct", ";",
    "Punct", "}",
  ]);
  checkEq(st, len(r.errors), 0, "for-range: no errors");
  checkEq(st, r.program.ival, 1, "for-range: 1 stmt");
  0
}

fn test_complex_string_interp(st: Stats) -> int {
  // `let name = "Aether";` (String token with text "Aether")
  let r = P(["Keyword", "let", "Ident", "name", "Punct", "=", "String", "Aether", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "str-interp: no errors");
  let s = r.program.items[0];
  let init = s.items[1];
  checkEqStr(st, init.kind, "StringLit", "str-interp: init is StringLit");
  checkEqStr(st, init.text, "Aether", "str-interp: text");
  0
}

fn test_complex_array_init(st: Stats) -> int {
  // `let nums = [1, 2, 3];`
  let r = P(["Keyword", "let", "Ident", "nums", "Punct", "=", "Punct", "[", "Int", "1", "Punct", ",", "Int", "2", "Punct", ",", "Int", "3", "Punct", "]", "Punct", ";"]);
  checkEq(st, len(r.errors), 0, "arr-init: no errors");
  let s = r.program.items[0];
  let init = s.items[1];
  checkEqStr(st, init.kind, "ArrayExpr", "arr-init: kind");
  checkEq(st, init.ival, 3, "arr-init: 3 elements");
  0
}

fn test_complex_lambda_call(st: Stats) -> int {
  // `let doubled = map(nums, fn(x: int) -> int { x * 2 });`
  let r = P([
    "Keyword", "let", "Ident", "doubled", "Punct", "=",
    "Ident", "map", "Punct", "(",
      "Ident", "nums", "Punct", ",",
      "Keyword", "fn", "Punct", "(", "Ident", "x", "Punct", ":", "Ident", "int", "Punct", ")", "Punct", "->", "Ident", "int", "Punct", "{", "Ident", "x", "Punct", "*", "Int", "2", "Punct", "}",
    "Punct", ")", "Punct", ";",
  ]);
  checkEq(st, len(r.errors), 0, "lambda-call: no errors");
  let s = r.program.items[0];
  let init = s.items[1];
  checkEqStr(st, init.kind, "Call", "lambda-call: init is Call");
  checkEq(st, init.ival, 2, "lambda-call: 2 args");
  0
}

fn test_complex_reduce(st: Stats) -> int {
  // `let sum = reduce(nums, fn(a: int, x: int) -> int { a + x }, 0);`
  let r = P([
    "Keyword", "let", "Ident", "sum", "Punct", "=",
    "Ident", "reduce", "Punct", "(",
      "Ident", "nums", "Punct", ",",
      "Keyword", "fn", "Punct", "(", "Ident", "a", "Punct", ":", "Ident", "int", "Punct", ",", "Ident", "x", "Punct", ":", "Ident", "int", "Punct", ")", "Punct", "->", "Ident", "int", "Punct", "{", "Ident", "a", "Punct", "+", "Ident", "x", "Punct", "}",
      "Punct", ",", "Int", "0",
    "Punct", ")", "Punct", ";",
  ]);
  checkEq(st, len(r.errors), 0, "reduce: no errors");
  let s = r.program.items[0];
  let init = s.items[1];
  checkEqStr(st, init.kind, "Call", "reduce: init is Call");
  checkEq(st, init.ival, 3, "reduce: 3 args");
  0
}

// =====================================================================
// Tests: program shape
// =====================================================================

fn test_empty_program(st: Stats) -> int {
  let r = P([]);
  checkEq(st, len(r.errors), 0, "empty: no errors");
  checkEq(st, r.program.ival, 0, "empty: 0 stmts");
  checkEqStr(st, r.program.kind, "Program", "empty: kind");
  0
}

fn test_program_kind(st: Stats) -> int {
  let r = P(["Int", "42", "Punct", ";"]);
  checkEqStr(st, r.program.kind, "Program", "prog-kind: Program");
  0
}

fn test_program_loc(st: Stats) -> int {
  let r = P(["Int", "42", "Punct", ";"]);
  // First token line is 1 (from `toks`)
  checkEq(st, r.program.loc.line, 1, "prog-loc: line 1");
  0
}

// =====================================================================
// Driver
// =====================================================================

fn runAllTests() -> int {
  let st = Stats { passed: 0, failed: 0 };
  
  // literals & atoms
  test_int_literal(st);
  test_float_literal(st);
  test_bool_literal_true(st);
  test_bool_literal_false(st);
  test_string_literal(st);
  test_char_literal(st);
  test_unit_literal(st);
  test_self_expr(st);
  test_ident_expr(st);
  test_paren_expr(st);
  test_tuple_expr(st);
  test_array_expr(st);
  test_empty_array(st);
  test_map_expr(st);
  
  // binary / unary / precedence
  test_addition(st);
  test_precedence_mul_over_add(st);
  test_left_assoc_sub(st);
  test_unary_neg(st);
  test_unary_not(st);
  test_logical_and(st);
  test_logical_or(st);
  test_equality(st);
  test_not_equal(st);
  test_less_than(st);
  test_less_equal(st);
  test_greater_than(st);
  test_greater_equal(st);
  test_modulo(st);
  test_division(st);
  test_combined_precedence(st);
  test_paren_overrides_precedence(st);
  test_unary_minus_higher_than_binary(st);
  
  // postfix
  test_call(st);
  test_call_with_args(st);
  test_index(st);
  test_field_access(st);
  test_method_call(st);
  test_chained_calls(st);
  test_nested_field_then_call(st);
  test_tuple_field_access(st);
  test_error_propagation(st);
  test_range_expr(st);
  test_range_inclusive(st);
  test_as_cast(st);
  
  // enum variant
  test_enum_variant_unit(st);
  test_enum_variant_tuple(st);
  
  // struct literal
  test_struct_literal_empty(st);
  test_struct_literal_fields(st);
  
  // lambda
  test_lambda_simple(st);
  test_lambda_no_return(st);
  
  // if / match / block
  test_if_expr(st);
  test_if_no_else(st);
  test_if_else_if(st);
  test_match_simple(st);
  test_match_with_guard(st);
  test_block_trailing(st);
  test_block_stmts(st);
  test_empty_block(st);
  
  // statements
  test_let_simple(st);
  test_let_with_type(st);
  test_mut_let(st);
  test_const_decl(st);
  test_fn_simple(st);
  test_fn_with_generics(st);
  test_fn_no_return(st);
  test_fn_recursive(st);
  test_enum_decl(st);
  test_enum_unit_variant(st);
  test_enum_tuple_variant(st);
  test_enum_struct_variant(st);
  test_struct_decl(st);
  test_struct_with_generics(st);
  test_type_alias(st);
  test_return_with_value(st);
  test_return_void(st);
  test_break(st);
  test_continue(st);
  test_while_loop(st);
  test_for_in_range(st);
  test_print_stmt(st);
  test_import_stmt(st);
  test_pub_fn(st);
  test_assign_stmt(st);
  test_compound_add_assign(st);
  test_compound_sub_assign(st);
  test_compound_mul_assign(st);
  test_compound_div_assign(st);
  test_compound_mod_assign(st);
  
  // types
  test_named_type(st);
  test_primitive_type(st);
  test_array_type(st);
  test_tuple_type(st);
  test_func_type(st);
  test_generic_type(st);
  test_map_type(st);
  test_option_type(st);
  test_result_type(st);
  test_unit_type(st);
  
  // patterns
  test_wildcard_pattern(st);
  test_bind_pattern(st);
  test_lit_pattern_int(st);
  test_lit_pattern_string(st);
  test_tuple_pattern(st);
  test_array_pattern(st);
  test_array_pattern_with_rest(st);
  test_enum_pattern(st);
  test_struct_pattern(st);
  test_or_pattern(st);
  test_mut_bind_pattern(st);
  
  // error recovery
  test_missing_semicolon(st);
  test_missing_init(st);
  test_missing_paren_close(st);
  test_error_continues_parsing(st);
  test_missing_brace_close(st);
  test_unexpected_token(st);
  
  // full programs
  test_full_program_let(st);
  test_full_program_two_lets(st);
  test_full_program_let_fn(st);
  test_full_program_with_block(st);
  test_full_program_const(st);
  test_full_program_enum_result(st);
  test_full_program_struct_point(st);
  
  // complex programs
  test_complex_iterative(st);
  test_complex_for_range(st);
  test_complex_string_interp(st);
  test_complex_array_init(st);
  test_complex_lambda_call(st);
  test_complex_reduce(st);
  
  // program shape
  test_empty_program(st);
  test_program_kind(st);
  test_program_loc(st);
  
  print("=============================");
  print("Parser test results:");
  print("  passed: " + str(st.passed));
  print("  failed: " + str(st.failed));
  if st.failed == 0 {
    print("  STATUS: ALL PASS");
  } else {
    print("  STATUS: FAILURES");
  };
  print("=============================");
  assert_eq(st.failed, 0);
  st.passed
}

// Run all tests; the script's stdout is the report.
let npass = runAllTests();
print("Total asserts passed: " + str(npass));
