  // `fn(x: int) { x };`
  let r = P(["Keyword", "fn", "Punct", "(", "Ident", "x", "Punct", ":", "Ident", "int", "Punct", ")", "Punct", "{", "Ident", "x", "Punct", "}", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "Lambda", "lambda-noret: kind");
  0
}

// =====================================================================
// Tests: if / match / block
// =====================================================================

fn test_if_expr(st: Stats) -> int {
  // `if c { 1 } else { 2 };`
  let r = P(["Keyword", "if", "Ident", "c", "Punct", "{", "Int", "1", "Punct", "}", "Keyword", "else", "Punct", "{", "Int", "2", "Punct", "}", "Punct", ";"]);
  let e = r.program.items[0].items[0];
  checkEqStr(st, e.kind, "If", "if: kind");
  checkEqStr(st, e.items[0].name, "c", "if: cond is Ident c");
  checkEqStr(st, e.items[1].kind, "Block", "if: then is Block");
  checkEqStr(st, e.items[2].kind, "Block", "if: else is Block");
  0
}

